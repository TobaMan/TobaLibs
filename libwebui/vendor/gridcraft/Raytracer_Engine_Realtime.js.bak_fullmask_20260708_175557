(function(){/*ISOLATED RTX_Realtime*/
// Shaders GLSL extraits de test4.html

const vertexShaderSource = `
    #version 300 es
    in vec2 a_position;
    out vec2 v_texcoord;
    void main() {
        v_texcoord = a_position * 0.5 + 0.5;
        gl_Position = vec4(a_position, 0.0, 1.0);
    }
`;

const tracerFragmentShaderSource = `
    #version 300 es
    precision highp float;
    uniform vec2 u_resolution;
    // SDF-TEXTURE MULTI : chaque LETTRE = un objet SDF distinct (sa forme exacte,
    // sa couleur, son materiau). Toutes les formes dans une texture ATLAS.
    // Par lettre : rect ecran (px), rect dans l'atlas (uv 0..1), couleur, materiau.
    const int MAX_GLYPHS = 24;
    uniform sampler2D u_sdf_tex;        // atlas : toutes les lettres, r = distance
    uniform bool u_sdf_on;
    uniform int u_glyph_count;
    uniform vec4 u_glyph_rect[MAX_GLYPHS];    // x,y,w,h ecran
    uniform vec4 u_glyph_uv[MAX_GLYPHS];      // u,v,uw,uh dans l'atlas
    uniform vec3 u_glyph_color[MAX_GLYPHS];
    uniform int u_glyph_mat[MAX_GLYPHS];
    uniform float u_sdf_range;
    uniform float u_sdf_rough;
    uniform float u_sdf_ior;
    uniform float u_time;
    uniform int u_max_bounces;
    uniform int u_frame_count;
    uniform sampler2D u_last_frame;
    uniform vec3 u_background_color;
    uniform bool u_enable_nee;
    uniform float u_emissive_power;
    uniform float u_front_emission;
    uniform float u_temporal_alpha;
    // Fresnel sur le glossy (off par defaut) : aux angles rasants (bords de
    // l'objet), la reflexion augmente et se neutralise (moins teintee) -> liseré
    // lumineux realiste sur le contour, comme un objet reel eclaire.
    uniform bool u_glossy_fresnel;
    uniform float u_fresnel_power;   // intensite du liseré (0..1, mixe vers blanc)
    uniform float u_light_radius;    // portee de reference du falloff (px, <=0 = 1/d² pur)
    uniform int u_samples_per_frame;

    in vec2 v_texcoord;
    out vec4 outColor;

    const float PI = 3.14159265359;
    const int SCENE_SIZE = 32;
    const int MAX_LIGHTS = 8;

    struct Ray {
        vec2 origin;
        vec2 direction;
    };

    struct Object {
        int type;      
        vec2 position;
        vec2 size;
        vec3 color;
        float radius;
        int materialType;
        float roughness;
        float ior;
        float opacity;
    };
    
    struct Light {
        vec2 position;
        vec2 size;
        vec3 color;
        float intensity;
    };

    uniform Object u_objects[SCENE_SIZE];
    uniform Light u_lights[MAX_LIGHTS];
    uniform int u_num_lights;
    uniform int u_num_objects;
    // 1 = moyenne cumulative vraie (poids 1/N) pendant la convergence temporal=0,
    // 0 = lissage exponentiel classique (u_temporal_alpha).
    uniform int u_accum_mode;


    float random(vec2 st) {
        // Hash entier type PCG2D : bruit bien reparti, sans les correlations
        // structurees du classique fract(sin(dot)) -> converge plus vite et se
        // denoise mieux. Meme signature, meme cout.
        uvec2 q = floatBitsToUint(st);
        q = q * 1664525u + 1013904223u;
        q.x += q.y * 1664525u; q.y += q.x * 1664525u;
        q ^= q >> 16u;
        q.x += q.y * 1664525u; q.y += q.x * 1664525u;
        q ^= q >> 16u;
        return float(q.x & 0x007fffffu) / float(0x00800000);
    }

    float sampleTime() {
        // Temporal=0 sert de mode "stable": pas de feedback temporel et pas de
        // nouveau seed aleatoire chaque frame. Le bruit restant est fixe, donc
        // le filtre spatial peut le lisser sans scintillement permanent.
        return (u_temporal_alpha <= 0.001) ? 0.0 : u_time;
    }

    vec2 cosine_hemisphere(vec2 normal, float r1, float r2) {
        float r = sqrt(r1);
        float theta = 2.0 * PI * r2;
        vec2 tangent = vec2(normal.y, -normal.x);
        vec2 disk = vec2(r * cos(theta), r * sin(theta));
        float h = sqrt(max(0.0, 1.0 - r1));
        return normalize(disk.x * tangent + h * normal);
    }

    float sdRoundedBox(vec2 p, vec2 b, float r) {
        vec2 q = abs(p) - b + vec2(r);
        return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
    }

    // SDF cercle/ellipse pur : isolignes RADIALES (pas de losange interne comme
    // sdRoundedBox quand r=b). Utilise quand l'objet est quasi-circulaire.
    float sdCircleBox(vec2 p, vec2 b) {
        // Normalise par les demi-axes -> distance radiale correcte, y compris a
        // l'interieur (les iso-distances restent des cercles/ellipses).
        float k = length(p / b);
        return (k - 1.0) * min(b.x, b.y);
    }

    // Objet considere rond si son radius atteint ~la moitie du plus petit cote.
    bool isRound(Object obj) {
        return obj.radius >= min(obj.size.x, obj.size.y) * 0.5 - 0.5;
    }

    // Distance signee (px) a la LETTRE gi (sa vraie silhouette, PAS la case).
    // Hors de la case atlas la distance CONTINUE de grandir (comme une SDF de
    // courbe) : sinon elle est plafonnee a +range et tout le carre "compte"
    // comme proche -> halo/ombrage carre. On combine la distance encodee (pres
    // du bord) avec la distance euclidienne a la case (loin) pour rester exacte.
    float sdGlyph(vec2 p, int gi) {
        vec4 rc = u_glyph_rect[gi];
        vec2 lu = (p - rc.xy) / rc.zw;               // coord 0..1 dans la case ecran
        // distance signee (px ecran) au rectangle de la case
        vec2 c = clamp(lu, 0.0, 1.0);
        vec2 dPx = (lu - c) * rc.zw;                 // ecart hors case en px ecran
        float outBox = length(dPx);                  // >0 si dehors, 0 si dedans
        // valeur atlas au point clampe sur le bord de la case
        vec2 luc = c; luc.y = 1.0 - luc.y;
        vec4 uvr = u_glyph_uv[gi];
        vec2 uv = uvr.xy + luc * uvr.zw;
        float enc = texture(u_sdf_tex, uv).r;
        float dAtlas = (enc - 0.5) * 2.0 * u_sdf_range;   // dist a la lettre (bornee)
        // dehors de la case : la lettre est encore plus loin -> on additionne.
        // dedans : la SDF atlas est la verite.
        return (outBox > 0.0) ? (max(dAtlas, 0.0) + outBox) : dAtlas;
    }
    // Distance min a TOUTES les lettres + index de la plus proche.
    float sdGlyphsAll(vec2 p, out int gi) {
        float best = 1e6; gi = -1;
        for (int i = 0; i < MAX_GLYPHS; i++) {
            if (i >= u_glyph_count) break;
            float d = sdGlyph(p, i);
            if (d < best) { best = d; gi = i; }
        }
        return best;
    }
    float intersectShape(Ray r, out vec2 normal, out int gi) {
        normal = vec2(0.0); gi = -1;
        if (!u_sdf_on) return -1.0;
        float t_march = 0.0;
        for (int j = 0; j < 96; j++) {
            vec2 p = r.origin + t_march * r.direction;
            int hg;
            float d = sdGlyphsAll(p, hg);
            if (d < 0.5) {
                vec2 e = vec2(1.0, 0.0); int dummy;
                normal = normalize(vec2(
                    sdGlyphsAll(p+e.xy, dummy) - sdGlyphsAll(p-e.xy, dummy),
                    sdGlyphsAll(p+e.yx, dummy) - sdGlyphsAll(p-e.yx, dummy)));
                gi = hg;
                return t_march;
            }
            t_march += max(d, 0.5);
            if (t_march > 6000.0) break;
        }
        return -1.0;
    }

    // Environnement synthetique : le fond d'ambiance (u_background_color) module
    // par une legere variation DIRECTIONNELLE. Un fond uniforme donne des miroirs
    // plats/ternes ; ici le "ciel" est un peu plus clair vers le haut et prend un
    // gradient doux -> les surfaces MIROIR et VERRE refletent un environnement
    // avec du relief (aspect metallique/verre credible) meme dans une scene
    // pauvre. Pour le DIFFUS, qui echantillonne toutes les directions, la moyenne
    // reste ~u_background_color : aucun changement de comportement.
    vec3 environmentColor(vec2 dir) {
        vec2 d = normalize(dir);
        // Gradient vertical doux (haut plus lumineux) + fine teinte laterale.
        float grad = 0.5 + 0.5 * (-d.y);            // 0 (bas) -> 1 (haut)
        float shade = mix(0.82, 1.18, grad);        // +-18% autour du fond
        vec3 env = u_background_color * shade;
        // Leger reflet chaud/froid selon l'axe X pour casser l'uniformite.
        env += vec3(0.03, 0.02, 0.05) * d.x;
        return max(env, vec3(0.0));
    }

    float intersectObject(Ray r, Object obj, out vec2 normal) {
        float t = -1.0;
        normal = vec2(0.0);
        
        if (obj.type == 0) {
            if (obj.radius < 1.0) { // AABB optimization for sharp corners
                vec2 min_bounds = obj.position - obj.size * 0.5;
                vec2 max_bounds = obj.position + obj.size * 0.5;
                vec2 invDir = 1.0 / r.direction;
                vec2 t1 = (min_bounds - r.origin) * invDir;
                vec2 t2 = (max_bounds - r.origin) * invDir;
                vec2 tmin = min(t1, t2);
                vec2 tmax = max(t1, t2);
                float t_enter = max(tmin.x, tmin.y);
                float t_exit = min(tmax.x, tmax.y);
                if (t_exit >= t_enter && t_exit > 0.0) {
                    t = t_enter > 0.001 ? t_enter : t_exit;
                    vec2 hitPoint = r.origin + r.direction * t;
                    vec2 p = (hitPoint - obj.position) / (obj.size * 0.5);
                    float epsilon = 0.01;
                    if(abs(abs(p.x) - 1.0) < epsilon) normal = vec2(sign(p.x), 0.0);
                    else normal = vec2(0.0, sign(p.y));
                }
            } else { // Coins arrondis OU cercle/ellipse pur
                // Pre-rejet AABB (slab test) : la boite englobante d'un rounded
                // box / ellipse est exactement obj.size. Si le rayon la rate, on
                // sort tout de suite au lieu de payer 64 pas de marche. Le slab
                // donne aussi t_enter/t_exit pour borner la marche.
                vec2 b = obj.size * 0.5;
                vec2 min_bounds = obj.position - b;
                vec2 max_bounds = obj.position + b;
                vec2 invDir = 1.0 / r.direction;
                vec2 t1 = (min_bounds - r.origin) * invDir;
                vec2 t2 = (max_bounds - r.origin) * invDir;
                vec2 tmin = min(t1, t2);
                vec2 tmax = max(t1, t2);
                float t_enter = max(tmin.x, tmin.y);
                float t_exit = min(tmax.x, tmax.y);
                if (t_exit < t_enter || t_exit <= 0.0) return -1.0;

                vec2 local_origin = r.origin - obj.position;
                if (isRound(obj)) {
                    // Intersection analytique rayon/ellipse (forme fermee) :
                    // remplace la marche 64 pas, normale exacte p/b^2 au lieu des
                    // differences finies. Semantique conservee : origine
                    // interieure -> t=0 (rejete par intersectScene, comme avant).
                    vec2 oe = local_origin / b;
                    vec2 de = r.direction / b;
                    float A = dot(de, de);
                    float B = dot(oe, de);
                    float C = dot(oe, oe) - 1.0;
                    if (C < 0.0) return 0.0;
                    float disc = B * B - A * C;
                    if (disc < 0.0) return -1.0;
                    float tt = (-B - sqrt(disc)) / A;
                    if (tt <= 0.0) return -1.0;
                    t = tt;
                    vec2 p = local_origin + t * r.direction;
                    normal = normalize(p / (b * b));
                } else {
                    // Marche SDF bornee par le slab : demarre a l'entree de
                    // l'AABB (pas a 0) et s'arrete des qu'on en ressort.
                    float t_march = max(t_enter, 0.0);
                    for(int j=0; j<64; j++) {
                        vec2 p = local_origin + t_march * r.direction;
                        float d = sdRoundedBox(p, b, obj.radius);
                        if (d < 0.01) {
                            t = t_march;
                            vec2 eps = vec2(0.01, 0.0);
                            normal = normalize(vec2(
                                sdRoundedBox(p + eps.xy, b, obj.radius) - sdRoundedBox(p - eps.xy, b, obj.radius),
                                sdRoundedBox(p + eps.yx, b, obj.radius) - sdRoundedBox(p - eps.yx, b, obj.radius)
                            ));
                            break;
                        }
                        t_march += d;
                        if (t_march > t_exit + 1.0) break;
                    }
                }
            }
        }
        return t;
    }

    float intersectScene(Ray r, out int hit_id, out vec2 normal) {
        float closest_t = 1e6;
        hit_id = -1;
        normal = vec2(0.0);
        for (int i = 0; i < SCENE_SIZE; i++) {
            if (i >= u_num_objects) break;
            if (u_objects[i].type == -1) continue;
            vec2 local_normal;
            float t = intersectObject(r, u_objects[i], local_normal);
            if (t > 0.001 && t < closest_t) {
                closest_t = t;
                hit_id = i;
                normal = local_normal;
            }
        }
        vec2 sn; int sgi; float ts = intersectShape(r, sn, sgi);
        if (ts > 0.001 && ts < closest_t && sgi >= 0) { closest_t = ts; hit_id = -100 - sgi; normal = sn; }
        return closest_t;
    }

    vec2 customReflect2D(vec2 incident, vec2 normal) { return incident - 2.0 * dot(incident, normal) * normal; }
    vec2 customRefract2D(vec2 incident, vec2 normal, float eta) {
        float cosI = -dot(normal, incident);
        float sinT2 = eta * eta * (1.0 - cosI * cosI);
        if (sinT2 > 1.0) return customReflect2D(incident, normal);
        float cosT = sqrt(1.0 - sinT2);
        return eta * incident + (eta * cosI - cosT) * normal;
    }
    float fresnel2D(vec2 incident, vec2 normal, float ior) {
        float cosi = clamp(dot(incident, normal), -1.0, 1.0);
        float etai = 1.0, etat = ior;
        if (cosi > 0.0) { float temp = etai; etai = etat; etat = temp; }
        float sint = etai / etat * sqrt(max(0.0, 1.0 - cosi * cosi));
        if (sint >= 1.0) return 1.0;
        float cost = sqrt(max(0.0, 1.0 - sint * sint));
        cosi = abs(cosi);
        float Rs = ((etat * cosi) - (etai * cost)) / ((etat * cosi) + (etai * cost));
        float Rp = ((etai * cosi) - (etat * cost)) / ((etai * cosi) + (etat * cost));
        return (Rs * Rs + Rp * Rp) / 2.0;
    }
    vec2 glossyReflection2D(vec2 perfect, vec2 normal, float roughness, float seed) {
        if (roughness < 0.001) return perfect;
        float rand_angle = random(vec2(seed, seed * 2.0)) * PI - (PI / 2.0);
        vec2 tangent = vec2(normal.y, -normal.x);
        vec2 randomDir = cos(rand_angle) * normal + sin(rand_angle) * tangent;
        return normalize(mix(perfect, randomDir, roughness * roughness));
    }

    vec3 trace(Ray r) {
        vec3 finalColor = vec3(0.0);
        vec3 throughput = vec3(1.0);

        for (int i = 0; i < 20; i++) {
            if (i >= u_max_bounces) break;

            int hit_id;
            vec2 normal;
            float closest_t = intersectScene(r, hit_id, normal);

            if (hit_id == -1) {
                // Rayon echappe : prend la couleur de l'environnement dans sa
                // direction (fond d'ambiance + variation directionnelle) -> les
                // miroirs/verres refletent un "ciel" avec du relief, pas du plat.
                finalColor += environmentColor(r.direction) * throughput;
                break;
            }

            Object obj;
            if (hit_id <= -100) {
                int gi = -100 - hit_id;      // index de la lettre touchee
                obj.type=0; obj.position=vec2(0.0); obj.size=vec2(0.0); obj.radius=0.0;
                obj.color=u_glyph_color[gi]; obj.materialType=u_glyph_mat[gi]; obj.roughness=u_sdf_rough; obj.ior=u_sdf_ior; obj.opacity=1.0;
            } else obj = u_objects[hit_id];
            vec2 hitPoint = r.origin + r.direction * closest_t;
            
            if (obj.materialType == 4) { // EMISSIVE
                if (i == 0 || !u_enable_nee) {
                   finalColor += throughput * obj.color * u_emissive_power;
                }
                break;
            }

            if (random(hitPoint + sampleTime() + float(i) * 0.1) > obj.opacity) {
                r.origin = hitPoint + r.direction * 0.01;
                continue;
            }
            
            // === NEXT EVENT ESTIMATION (Direct Lighting) ===
            // Applique aux surfaces DIFFUSES (0) ET GLOSSY (3). Le glossy recoit
            // l'eclairage direct pondere par sa rugosite (roughness) : plus c'est
            // rugueux, plus ca se comporte comme du diffus ; un glossy tres lisse
            // (roughness~0) recoit peu de diffus (il compte surtout sur le reflet).
            if (u_enable_nee && (obj.materialType == 0 || obj.materialType == 3)) {
                float neeWeight = (obj.materialType == 3) ? clamp(obj.roughness, 0.15, 1.0) : 1.0;
                for (int l = 0; l < u_num_lights; l++) {
                     if(l >= MAX_LIGHTS) break;
                    Light light = u_lights[l];

                    // Seed AVEC composante temporelle : chaque frame echantillonne
                    // un point different de la source -> les penombres convergent
                    // vers un vrai degrade au fil de l'accumulation (avant : bruit
                    // fige des la frame 1, seulement masque par le denoise).
                    float lt = sampleTime();
                    vec2 lightPoint = light.position + (vec2(random(hitPoint + float(l) + lt), random(hitPoint - float(l) - lt)) - 0.5) * light.size;
                    vec2 toLight = lightPoint - hitPoint;
                    float dist = length(toLight);
                    vec2 dirToLight = toLight / dist;

                    Ray shadowRay;
                    // Biais d'ombre elargi (1.5px au lieu de 0.01) : sur les
                    // petits objets ronds, un biais minuscule fait re-toucher le
                    // meme objet (bord courbe) -> auto-ombre = liseré sombre. On
                    // decale le long de la normale ET vers la lumiere pour sortir
                    // franchement de la surface avant de tracer l'ombre.
                    shadowRay.origin = hitPoint + normal * 1.5 + dirToLight * 1.5;
                    shadowRay.direction = dirToLight;

                    int shadow_hit;
                    vec2 shadow_normal;
                    float shadow_t = intersectScene(shadowRay, shadow_hit, shadow_normal);

                    // On ignore aussi une auto-occlusion tres proche (le meme objet
                    // touche a <2px = artefact de bord, pas une vraie ombre).
                    if (shadow_hit == -1 || shadow_t > dist - 2.0) {
                        float NdotL = max(dot(normal, dirToLight), 0.0);
                        // Falloff : 1/d² pur (u_light_radius<=0) OU calibre a
                        // l'echelle pixel : att = 1/(1+(d/R)^2) ou R = portee de
                        // reference (px). A d=R l'intensite vaut la moitie -> falloff
                        // physique credible sans s'eteindre trop vite en 2D.
                        float atten;
                        if (u_light_radius > 0.0) {
                            float dr = dist / u_light_radius;
                            atten = 1.0 / (1.0 + dr * dr);
                        } else {
                            atten = 1.0 / (dist * dist + 1.0);
                        }
                        vec3 directLight = light.color * light.intensity * obj.color * NdotL * throughput * neeWeight * atten;
                        finalColor += directLight;
                    }
                }
            }

            // === INDIRECT LIGHTING / Material Logic ===
            if(obj.materialType == 0) { // DIFFUSE
                throughput *= obj.color;
                float survival = max(throughput.r, max(throughput.g, throughput.b));
                if (random(hitPoint + float(i) * 123.4) > survival || survival < 0.01) {
                    break;
                }
                throughput /= survival;
                r.direction = cosine_hemisphere(normal, random(hitPoint + sampleTime() + float(i)), random(hitPoint - sampleTime() - float(i)));
            } else if(obj.materialType == 1) { // SPECULAR (Miroir)
                r.direction = customReflect2D(r.direction, normal);
                throughput *= vec3(1.0);
            } else if(obj.materialType == 2) { // REFRACTIVE (Verre amélioré)
                bool entering = dot(r.direction, normal) < 0.0;
                vec2 refrNormal = entering ? normal : -normal;
                float eta = entering ? 1.0 / obj.ior : obj.ior;
                float kr = fresnel2D(r.direction, refrNormal, obj.ior);
                float edgeFactor = 1.0 - abs(dot(r.direction, normal));
                kr = mix(kr, 1.0, pow(edgeFactor, 4.0) * 0.5);

                if(random(hitPoint + sampleTime() * 0.5 + float(i)) < kr) {
                    r.direction = customReflect2D(r.direction, refrNormal);
                    throughput *= mix(vec3(1.0), obj.color, 0.2);
                } else {
                    r.direction = customRefract2D(r.direction, refrNormal, eta);
                    if (!entering) {
                        throughput *= mix(vec3(1.0), obj.color, 0.8);
                    } else {
                        throughput *= mix(vec3(1.0), obj.color, 0.1);
                    }
                }
            } else if(obj.materialType == 3) { // GLOSSY
                vec2 perfectReflection = customReflect2D(r.direction, normal);
                r.direction = glossyReflection2D(perfectReflection, normal, obj.roughness, sampleTime() + float(i));
                if (u_glossy_fresnel) {
                    // Reflectance de Schlick : F0 (face) -> 1 (bord rasant). Au bord,
                    // la reflexion est plus forte ET moins teintee (blanc) -> liseré.
                    float cosT = abs(dot(normal, r.direction));
                    // exposant plus bas = liseré plus LARGE ; u_fresnel_power dose l'intensite.
                    float edge = pow(1.0 - cosT, mix(5.0, 2.0, u_fresnel_power));
                    float F = clamp(0.04 + (0.5 + 1.5 * u_fresnel_power) * edge, 0.0, 1.0);
                    throughput *= mix(obj.color, vec3(1.3), F);   // 1.3 = liseré un peu sur-brillant
                } else {
                    throughput *= obj.color;
                }
            }

            r.origin = hitPoint + normal * 0.01;
        }
        return finalColor;
    }
    
    // EMISSION FRONTALE (axe Z) : le path tracer est 2D et n'emet que dans le
    // plan (X,Y) -> le halo lateral existe mais la SURFACE de la source ne renvoie
    // rien vers la camera (axe Z). Ici, si le pixel est DANS un objet emissif, on
    // ajoute sa luminance propre : la surface parait rayonner vers l'observateur.
    // La surface est pleinement lumineuse JUSQU'AU BORD (pas de contour eteint),
    // coeur un peu plus vif. u_front_emission dose l'effet.
    vec3 frontalEmission(vec2 pixel) {
        vec3 sum = vec3(0.0);
        for (int i = 0; i < SCENE_SIZE; i++) {
            if (i >= u_num_objects) break;
            if (u_objects[i].type == -1) continue;
            if (u_objects[i].materialType != 4) continue;
            Object o = u_objects[i];
            vec2 p = pixel - o.position;
            vec2 b = o.size * 0.5;
            float d = isRound(o) ? sdCircleBox(p, b) : sdRoundedBox(p, b, o.radius);
            // fill=1 partout dans l'objet, adouci sur ~1.5px au contour (anti-liseré).
            float fill = 1.0 - smoothstep(-1.5, 0.5, d);
            if (fill > 0.0) {
                float depth = clamp(-d / max(min(b.x, b.y), 1.0), 0.0, 1.0);
                float glow = mix(0.7, 1.15, smoothstep(0.0, 1.0, depth));
                sum += o.color * u_emissive_power * u_front_emission * glow * fill;
            }
        }
        if (u_sdf_on) {
            for (int i = 0; i < MAX_GLYPHS; i++) {
                if (i >= u_glyph_count) break;
