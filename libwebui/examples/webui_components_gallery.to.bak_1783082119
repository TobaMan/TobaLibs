        rtxMatCss = rtxMatCss $ "window.gcApplyMatState=function(key){var obj=document.getElementById('gc_obj_'+key);if(!obj)return;obj.classList.toggle('lw-off',!window.__gcMatOn[key]);obj.removeAttribute('data-rtx-material');obj.removeAttribute('data-rtx-ior');obj.removeAttribute('data-rtx-opacity');obj.removeAttribute('data-rtx-roughness');if(!window.__gcMatOn[key])return;var sel=document.getElementById('gc_sel_'+key);var mat=sel?sel.value:'emissive';var o=window.__gcMatOpts[mat]||{};obj.setAttribute('data-rtx-material',mat);if(o.ior)obj.setAttribute('data-rtx-ior',o.ior);if(o.opacity)obj.setAttribute('data-rtx-opacity',o.opacity);if(o.roughness)obj.setAttribute('data-rtx-roughness',o.roughness)};"
        rtxMatCss = rtxMatCss $ "['a','b','c','d'].forEach(function(k){gcApplyMatState(k)});"
        rtxMatCss = rtxMatCss $ "window.addEventListener('toba:event',function(e){var d=e.detail||{};if(d.name==='gc_mat_toggle'){var wid=d.widgetId||(d.data&&d.data.id)||String();var key=wid.replace('gc_tg_',String());window.__gcMatOn[key]=(d.data&&d.data.value)==='on';gcApplyMatState(key);if(window.gcRefresh)gcRefresh()}else if(d.name==='gc_mat_change'){var wid2=(d.data&&d.data.id)||String();var key2=wid2.replace('gc_sel_',String());gcApplyMatState(key2);if(window.gcRefresh)gcRefresh()}});"
        rtxMatCss = rtxMatCss $ "</script>"

