    page.Show()
    print("native handle after show = ")
    print(page.NativeHandle())
    print("\n")
    print("TOBA WEBUI COMPONENT GALLERY STARTED\n")
    print("Click Toba Notify or the chart buttons to run Toba callbacks.\n")
    eventbus::SetCloseGuard(1, "Demander l'autorisation a Toba avant de quitter ?")
    chartPoint = 1
    chartStream = 0
    streamTick = 0
    diagTick = 0
    loop {
        rawEvt = desktopui::BridgePoll(50)
        diagTick = diagTick + 1
        if (diagTick > 20) {
            diagTick = 0
            print("bridge connected=")
            print(desktopui::BridgeIsConnected())
            print(" events=")
            print(desktopui::BridgeEventCount())
            print(" error=")
            print(desktopui::BridgeLastError())
            print("\n")
        }
        if (size(rawEvt) > 0) {
            print("raw bridge = ")
            print(rawEvt)
            print("\n")
            rawName = json::GetString(rawEvt, "name", " ")
            if (rawName == "native_window_action") {
                if (page.NativeHandle() == 0) {
                    page.nativeHandle = desktopui::NativeWindowFind("Toba WebUI Component Gallery")
                }
                print("native action=")
                print(webui::EventAction(rawEvt))
                print(" handle=")
                print(page.NativeHandle())
                print("\n")
                webui::HandleNativeWindowEventHandle(rawEvt, page.NativeHandle())
                print("native result=")
                print(desktopui::NativeWindowLastActionResult())
                print("\n")
                rawEvt = ""
            }
        }
        evt = eventbus::New(rawEvt)
        if (evt.HasEvent()) {
            print("component event = ")
            print(evt.Name())
            print(" widget = ")
            print(evt.WidgetId())
            print(" state = ")
            print(evt.State())
            print("\n")
            if (evt.Is("chart_start_stream")) {
                chartStream = 1
                eventbus::Notify("Chart stream", "Toba realtime stream started.")
            }
            if (evt.Is("chart_stop_stream")) {
                chartStream = 0
                eventbus::Notify("Chart stream", "Toba realtime stream stopped.")
            }
            if (evt.Is("window_close_request")) {
                print("close request received by Toba\n")
                eventbus::Notify("Fermeture demandee", "Toba a recu window_close_request.")
            }
            if (evt.Is("window_close_confirm")) {
                print("close confirmed by WebUI\n")
                desktopui::NativeWindowActionHandle(page.NativeHandle(), "force_close")
                break
            }
            if (evt.Is("window_closed")) {
                print("window closed\n")
            }
            chartPoint = OnGalleryEvent(evt, chartPoint)
        }
        if (chartStream == 1) {
            streamTick = streamTick + 1
            if (streamTick > 8) {
                chartPoint = PushChartPoint(chartPoint)
                streamTick = 0
            }
        }
        sleep(0.05)
    }
