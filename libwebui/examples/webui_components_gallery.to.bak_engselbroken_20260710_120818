        rtxScript = rtxScript $ "window.gcRebuildEngine=function(){"
        rtxScript = rtxScript $ "  var ed=window.gc_editor;if(!ed)return;"
        rtxScript = rtxScript $ "  if(window.__gcRtx){try{window.__gcRtx.destroy()}catch(e){}window.__gcRtx=null}"
