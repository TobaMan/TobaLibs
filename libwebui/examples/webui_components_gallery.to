        gcTable = webui::GridTable()
        gcTable.SetColumns(("Tache", "Statut", "Priorite", "Responsable", "Actions"))
        gcTable.AddRow(("Indexer les documents", webui::Badge("Termine", "done"), webui::Badge("Haute", "danger"), webui::Avatar("EL", "Eddie Lake"), "<div class='lw-cell-actions'>" $ webui::ActionBtn("Voir", "primary", "gc_view_1") $ webui::ActionBtn("Suppr.", "danger", "gc_del_1") $ "</div>"))
        gcTable.AddRow(("Analyser les images", webui::Badge("En cours", "busy"), webui::Badge("Moyenne", " "), webui::Avatar("JT", "Jamik Tashpulatov"), "<div class='lw-cell-actions'>" $ webui::ActionBtn("Voir", "primary", "gc_view_2") $ webui::ActionBtn("Suppr.", "danger", "gc_del_2") $ "</div>"))
        gcTable.AddRow(("Generer le rapport", webui::Badge("En attente", " "), webui::Badge("Basse", " "), webui::Avatar("MC", "Marie Curie"), "<div class='lw-cell-actions'>" $ webui::ActionBtn("Voir", "primary", "gc_view_3") $ webui::ActionBtn("Suppr.", "danger", "gc_del_3") $ "</div>"))
