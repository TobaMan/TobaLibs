        dbgBoot = "<script>(function(){if(window.__lwEarlyInstalled)return;window.__lwEarlyInstalled=1;window.__lwEarlyErrors=window.__lwEarlyErrors||[];window.__lwEarlyPush=function(m){if(window.lwDbgPush)lwDbgPush(m);else window.__lwEarlyErrors.push(String(m))};window.addEventListener('error',function(e){if(e&&e.__lwCaptured)return;if(e)e.__lwCaptured=1;if(e&&e.target&&e.target!==window&&(e.target.src||e.target.href)){__lwEarlyPush('LOAD FAIL ['+(e.target.tagName||'?')+']: '+(e.target.src||e.target.href))}else{__lwEarlyPush((e.message||'error')+' @'+(e.filename||String())+':'+(e.lineno||0)+':'+(e.colno||0))}},true);window.addEventListener('unhandledrejection',function(e){if(e&&e.__lwCaptured)return;if(e)e.__lwCaptured=1;var r=e&&e.reason;__lwEarlyPush('PROMISE: '+((r&&r.stack)?r.stack:(r&&r.message)?r.message:String(r)))});if(!window.__lwConsoleCaptured){window.__lwConsoleCaptured=1;var oe=console.error,ow=console.warn;console.error=function(){try{__lwEarlyPush('console.error: '+Array.prototype.map.call(arguments,function(a){return (a&&a.stack)?a.stack:(a&&a.message)?a.message:String(a)}).join(' '))}catch(x){}return oe.apply(console,arguments)};console.warn=function(){try{__lwEarlyPush('console.warn: '+Array.prototype.map.call(arguments,function(a){return (a&&a.stack)?a.stack:(a&&a.message)?a.message:String(a)}).join(' '))}catch(x){}return ow.apply(console,arguments)}}})();</script>"
        effectsPanel.AddHtml(dbgBoot)
        // Moteurs GridCraft (radiance + rtx) charges une fois pour le panel.
        // gridcraft::Scripts() charge deja les moteurs de PROD qui SONT le V3
        // (Raytracer_Engine*.js = V3), en chemins absolus. Pas de double chargement
        // _V3.js (chemin relatif casse -> FILE_NOT_FOUND).
        effectsPanel.AddHtml(gridcraft::Scripts())
        // La Gallery Lighting doit utiliser exactement les memes moteurs que les
        // demos V3 autonomes. Les scripts historiques restent charges pour les
        // autres effets, puis ces deux fichiers remplacent RTX_Realtime/Quality.
        effectsPanel.AddHtml("<script src='file:///C:/Toba/modules/libwebui/vendor/gridcraft/Raytracer_Engine_Realtime_V3.js'></script><script src='file:///C:/Toba/modules/libwebui/vendor/gridcraft/Raytracer_Engine_V3.js'></script>")
        // Fonctions gc* definies UNE SEULE fois. gcStart(mode) recoit le mode au
        // clic. Cible UNIQUEMENT les widgets de l'editeur radiance
        // (#rad_editor .lw-eitem) -> pas ceux de l'editeur RTX (#gc_editor), sinon
        // les 2 jeux de widgets se melangent pendant la transition d'onglet
        // (cartes/emissives de l'autre editeur captees = lumieres parasites).
        effectsPanel.AddHtml(gridcraft::Runtime("#rad_editor .lw-eitem", 0.6, 0.75))

