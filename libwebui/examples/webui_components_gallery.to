        fxCards.AddCardFx("Gradient background", "lwfx-gradient-bg", "Fond degrade anime, subtil, theme-aware.", "lwfx-gradient-bg lwfx-reveal")
        fxCards.AddCardFx("Float", "lwfx-float", "Flottement vertical lent, pour icones ou badges.", "lwfx-float lwfx-reveal")
        fxCards.Close()
        cssTab = "<div class='gallery-stack'><div class='gallery-note'>Ajoute une classe lwfx-* a n'importe quel widget (CardGrid.AddCardFx ou effects::Apply). Clique pour voir les sparks.</div>" $ cursorToggle.html $ fxCards.html $ "</div>"

        // Echantillons = VRAIS widgets libwebui instancies (Table draggable,
        // Stats, Toolbar, Fields), les memes objets que les autres onglets.
        // L'overlay cible leurs classes reelles (voir Runtime targets).
        // Tableau GENERIQUE avec LIGNES CUSTOMISEES : chaque cellule est un widget
