    layoutPanel = webui::Panel()
    layoutPanel.Setup("layout", "Layouts", "dock", "Dock, masonry and responsive placement")
        layoutCards = webui::CardGrid()
        layoutCards.AddCard("DockPage", "Application shell", "Header, sidebar, stage and footer.")
        layoutCards.AddCard("DesktopLayout", "Resizable desktop panels", "Sidebar + main area with themeable spacing.")
        layoutCards.AddCard("Grid", "Responsive placement", "Auto-fit cards and widgets without manual coordinates.")
        layoutCards.AddCard("Masonry", "Content-heavy pages", "Useful for heterogeneous widget heights.")
        layoutCards.Close()
        layoutPanel.Add(layoutCards)
        layoutPanel.AddHtml("<div class='gallery-layout-demo'><div>Sidebar</div><div>Main stage</div><div>Resizable panel</div><div>Responsive panel</div></div>")
        layoutCode = webui::Code()
        layoutCode.Text("page = webui::Page()\npanel = webui::Panel()\npanel.Setup(\"layout\", \"Layouts\", \"dock\", \"Responsive placement\")\npanel.Add(widget)\npage.AddPanel(panel)")
        layoutPanel.Add(layoutCode)
    layoutPanel.Close()
