        gcTable.Close()

        gcSamples = "<div class='gallery-note' style='margin-top:40px;padding-top:20px;border-top:1px solid var(--border)'>Tableau libwebui a lignes customisees (widgets imbriques ; glisse les lignes par la poignee ::). Seuls les boutons/badges/cartes ci-dessus recoivent l'effet, pas le tableau :</div>" $ gcTable.html

        // ---- Sous-onglet 2 : Radiance cascade (MEME SceneEditor que le RTX) ----
        // Editeur identique au RTX (grille magnetique, VToolbar, drag/resize/menu),
        // seul le moteur de lumiere change : ici la radiance cascade (eclairage
        // global). Les widgets colores = sources de lumiere (le moteur lit leur
        // background-color). Clic sur un widget -> couleur (color picker). Les
        // reglages globaux (qualite/opacite/intensite/finesse) via GcControls.
        radEditor = webui::SceneEditor()
        radEditor.Setup("rad_editor")
        // Templates dedies (ids distincts de ceux du RTX -> pas de doublon DOM).
        rtBtn = "<button type='button' class='ui-btn primary'><span data-icon='play'></span>Bouton</button>"
        rtCard = webui::CardGrid()
        rtCard.AddCard("Carte", "widget", "Contenu de la carte.")
        rtCard.Close()
        rtTable = webui::Table()
        rtTable.AddSection("Ligne 1", "Type", "Done", "done", "10", "5", "Eddie Lake", "rad_tr1")
        rtTable.AddSection("Ligne 2", "Type", "In Process", "busy", "8", "3", "Marie Curie", "rad_tr2")
        rtTable.Close()
        radEditor.AddTemplate("button", rtBtn)
        radEditor.AddTemplate("card", rtCard.html)
        radEditor.AddTemplate("badge", webui::Badge("Badge", "done"))
        radEditor.AddTemplate("table", rtTable.html)
        radEditor.AddToolButton("button", "Bouton", "plus")
        radEditor.AddToolButton("card", "Carte", "copy")
        radEditor.AddToolButton("badge", "Badge", "bell")
        radEditor.AddToolButton("table", "Table", "save")
        radEditor.Close()

        // Color picker custom : couleur (= couleur de la source de lumiere) du
        // widget selectionne. Emet rad_color_change {value}.
        radColPicker = widgets_extra::ColorPicker()
        radColPicker.Setup("radColorPick", "Couleur (widget selectionne)", "#3b82f6", ("#ef4444", "#3b82f6", "#22c55e", "#f59e0b", "#a855f7", "#ffffff"), "rad_color_change")
        radColPicker.Close()

        // Panneau de reglages radiance dans un COLLAPSE (cache par defaut), meme
        // agencement que le RTX. Les ids (radMatSel...) sont branches par le JS.
        radCfg = "<div id='rad_settings' class='gallery-collapse' style='margin-top:14px'>"
        radCfg = radCfg $ "<button type='button' class='gallery-collapse-head' onclick=\"webuiCollapse('rad_settings')\"><span>Reglages radiance</span><span class='gallery-chev'></span></button>"
        radCfg = radCfg $ "<div class='gallery-collapse-body'>"
        radCfg = radCfg $ "<div class='gallery-stack' style='gap:12px'>"
        // (Le moteur demarre automatiquement a l'affichage de l'onglet, comme le RTX.)
        // Color picker (couleur du widget selectionne).
        radCfg = radCfg $ radColPicker.html
        // Qualite (qualityScale).
        radCfg = radCfg $ "<div class='gallery-row' style='align-items:center;gap:12px'><span class='gallery-note' style='min-width:180px'>Qualite</span><input type='range' id='radQualRange' min='0.25' max='1' step='0.05' value='0.6' style='flex:1'><span id='radQualVal' class='gallery-slider-value' style='min-width:36px'>0.60</span></div>"
        // Opacite (overlay).
        radCfg = radCfg $ "<div class='gallery-row' style='align-items:center;gap:12px'><span class='gallery-note' style='min-width:180px'>Opacite</span><input type='range' id='radOpacRange' min='0.1' max='1' step='0.05' value='0.75' style='flex:1'><span id='radOpacVal' class='gallery-slider-value' style='min-width:36px'>0.75</span></div>"
        // Intensite (maxAlpha).
        radCfg = radCfg $ "<div class='gallery-row' style='align-items:center;gap:12px'><span class='gallery-note' style='min-width:180px'>Intensite</span><input type='range' id='radIntRange' min='0.1' max='1' step='0.05' value='0.6' style='flex:1'><span id='radIntVal' class='gallery-slider-value' style='min-width:36px'>0.60</span></div>"
        // Finesse (lineStep).
        radCfg = radCfg $ "<div class='gallery-row' style='align-items:center;gap:12px'><span class='gallery-note' style='min-width:180px'>Finesse</span><input type='range' id='radStepRange' min='1' max='4' step='1' value='2' style='flex:1'><span id='radStepVal' class='gallery-slider-value' style='min-width:36px'>2</span></div>"
        // Soleil directionnel : toggle NU (pas de carte) + angle (0-360deg -> rad).
        radCfg = radCfg $ "<div class='gallery-row' style='align-items:center;gap:12px'><span class='gallery-note' style='min-width:180px'>Soleil directionnel</span>" $ widget_core::Toggle("radSunSwitch", " ", 0, "rad_sun_toggle") $ "</div>"
        radCfg = radCfg $ "<div class='gallery-row' style='align-items:center;gap:12px'><span class='gallery-note' style='min-width:180px'>Angle du soleil</span><input type='range' id='radSunAngle' min='0' max='360' step='5' value='0' style='flex:1'><span id='radSunAngleVal' class='gallery-slider-value' style='min-width:36px'>0</span></div>"
        // Correction gamma sRGB : toggle NU.
        radCfg = radCfg $ "<div class='gallery-row' style='align-items:center;gap:12px'><span class='gallery-note' style='min-width:180px'>Correction gamma sRGB</span>" $ widget_core::Toggle("radSrgbSwitch", " ", 1, "rad_srgb_toggle") $ "</div>"
        radCfg = radCfg $ "</div></div></div>"

        // Script de branchement : le SceneEditor gere le DOM ; le moteur radiance
        // (gridcraft::Runtime, deja charge) fait l'eclairage. ed.onScan -> refresh.
        radScript = "<script>"
        radScript = radScript $ "window.radEdInit=function(){"
        radScript = radScript $ "  var ed=window.rad_editor;if(!ed||ed.__radBound)return;ed.__radBound=1;"
        radScript = radScript $ "  ed.onScan=function(){if(window.gcRefresh)gcRefresh()};"
        // Color picker -> couleur du widget selectionne (= couleur de la lumiere).
        radScript = radScript $ "  window.addEventListener('toba:event',function(e){var d=e.detail||{};if(d.name==='rad_color_change'&&ed.sel){var v=(d.data&&d.data.value)||d.value;if(v){ed.sel.style.background=v;ed.onScan()}}});"
        // Sliders -> setters gc* (moteur radiance).
        radScript = radScript $ "  function radBind(id,valId,fn,fix){var r=document.getElementById(id),v=document.getElementById(valId);if(!r)return;r.addEventListener('input',function(e){var x=parseFloat(e.target.value);if(v)v.textContent=(fix>=0)?x.toFixed(fix):String(x);fn(x)})}"
        radScript = radScript $ "  radBind('radQualRange','radQualVal',function(x){if(window.gcSetScale)gcSetScale(x)},2);"
        radScript = radScript $ "  radBind('radOpacRange','radOpacVal',function(x){if(window.gcSetOpacity)gcSetOpacity(x)},2);"
        radScript = radScript $ "  radBind('radIntRange','radIntVal',function(x){if(window.gcSetMaxAlpha)gcSetMaxAlpha(x)},2);"
        radScript = radScript $ "  radBind('radStepRange','radStepVal',function(x){if(window.gcSetLineStep)gcSetLineStep(x)},0);"
        // Angle soleil : slider en degres -> radians.
        radScript = radScript $ "  radBind('radSunAngle','radSunAngleVal',function(x){if(window.gcSetSunAngle)gcSetSunAngle(x*Math.PI/180)},0);"
        // Switches Soleil / sRGB (events des widgets Switch).
        radScript = radScript $ "  window.addEventListener('toba:event',function(e){var d=e.detail||{};var v=d.data&&d.data.value;if(d.name==='rad_sun_toggle'){if(window.gcSetSun)gcSetSun(v==='on')}else if(d.name==='rad_srgb_toggle'){if(window.gcSetSrgb)gcSetSrgb(v==='on')}});"
        // Scene par defaut : 4 widgets colores (sources de lumiere).
        radScript = radScript $ "  if(!ed.items().length){ed.add('card','#ef4444');ed.add('card','#3b82f6');ed.add('card','#a855f7');ed.add('card','#22c55e')}"
        radScript = radScript $ "};"
        // Au changement d'onglet radiance : init l'editeur PUIS demarre le moteur
        // en mode radiance (comme le RTX s'auto-init a l'affichage de son onglet).
        radScript = radScript $ "window.addEventListener('toba:event',function(e){var d=e.detail||{};if(d.name==='tab_fx_radiance'){if(window.__gcRtx){window.__gcRtx.destroy();window.__gcRtx=null}[150,450,900].forEach(function(ms){setTimeout(function(){radEdInit();if(window.gcStart){gcStart('radiance')}if(window.gcRefresh)gcRefresh()},ms)})}else if(d.name&&d.name.indexOf('theme_')===0){[80,260].forEach(function(ms){setTimeout(function(){if(window.gcRefresh)gcRefresh()},ms)})}});"
        radScript = radScript $ "</script>"

        // Enveloppe dans .gallery-stack -> gap:var(--lw-gap) (espacement global).
        radTab = "<div class='gallery-stack'><div class='gallery-note'>Radiance cascade (eclairage global) : place des widgets sur la grille, chaque widget colore devient une source de lumiere. Selectionne un widget pour changer sa couleur ; regle les parametres dans le collapse ci-dessous.</div>"
        radTab = radTab $ radEditor.html $ radCfg $ radScript $ "</div>"

        // ---- Sous-onglet 3 : Raytracer 2D (COPIE EXACTE de test3_work) --------
        // Reproduction fidele de test3_work qui MARCHE : widgets .gc-widget en
        // grille, canvas RTX dedie, appel DIRECT new Raytracer2D('.gc-widget')
        // (pas le wrapper GridCraftHtmlEffects), clic sur widget -> materiau.
        rtxTab = ""

        // ==== Editeur = widget webui::SceneEditor (grille magnetique + VToolbar
        // + drag/resize). Le RTX se branche sur son API (window.gc_editor). ====
        editor = webui::SceneEditor()
        editor.Setup("gc_editor")
        // Widget compose REALISTE : lecteur musique construit avec de VRAIS
        // widgets libwebui (Thumbnail, ProgressBar, IconButton) - PAS de HTML brut.
        // Chaque sous-widget porte .lw-rtx + data-rtx-material (via le param rtxMat)
        // -> le RTX les traite individuellement (vignette+play emissifs, reste diffus).
        etPlayer = "<div class='gc-player'>"
        etPlayer = etPlayer $ "<div class='gc-player-top'>" $ webui::Thumbnail("gcArt", " ", 82, "emissive") $ "<div class='gc-player-meta'><div class='gc-player-title'>Nightfall</div><div class='gc-player-artist'>Aurora Skies</div></div></div>"
        etPlayer = etPlayer $ webui::ProgressBar("gcBar", 38, 100, "diffuse")
        etPlayer = etPlayer $ "<div class='gc-player-time'><span>1:23</span><span>3:45</span></div>"
        etPlayer = etPlayer $ "<div class='gc-player-ctrl'><span class='gc-ctrl-prev'>" $ webui::IconButton("gcPrev", "chevronLeft", " ", 44, " ", "glossy") $ "</span>" $ webui::IconButton("gcPlay", "play", "primary", 54, " ", "emissive") $ "<span class='gc-ctrl-next'>" $ webui::IconButton("gcNext", "chevronRight", " ", 44, " ", "glossy") $ "</span></div>"
        etPlayer = etPlayer $ "</div>"

        // Second exemple : cinq icones SDF emissives sous cinq surfaces en verre.
        etToolbar = "<div class='gc-icon-toolbar'>"
        etToolbar = etToolbar $ "<div class='gc-tool'><div class='gc-sdf-icon' data-rtx-material='emissive' data-shape='play' data-color='#ff493d'><svg viewBox='0 0 100 100'><path d='M25 12L88 50L25 88Z'/></svg></div><button class='gc-glass-button lw-rtx' data-rtx-material='glass' data-rtx-ior='1.5'></button></div>"
        etToolbar = etToolbar $ "<div class='gc-tool'><div class='gc-sdf-icon' data-rtx-material='emissive' data-shape='plus' data-color='#3b82f6'><svg viewBox='0 0 100 100'><path d='M43 12H57V43H88V57H57V88H43V57H12V43H43Z'/></svg></div><button class='gc-glass-button lw-rtx' data-rtx-material='glass' data-rtx-ior='1.5'></button></div>"
        etToolbar = etToolbar $ "<div class='gc-tool'><div class='gc-sdf-icon' data-rtx-material='emissive' data-shape='diamond' data-color='#22c55e'><svg viewBox='0 0 100 100'><path d='M50 8L92 50L50 92L8 50Z'/></svg></div><button class='gc-glass-button lw-rtx' data-rtx-material='glass' data-rtx-ior='1.5'></button></div>"
        etToolbar = etToolbar $ "<div class='gc-tool'><div class='gc-sdf-icon' data-rtx-material='emissive' data-shape='pause' data-color='#f59e0b'><svg viewBox='0 0 100 100'><path d='M22 12H42V88H22ZM58 12H78V88H58Z'/></svg></div><button class='gc-glass-button lw-rtx' data-rtx-material='glass' data-rtx-ior='1.5'></button></div>"
        etToolbar = etToolbar $ "<div class='gc-tool'><div class='gc-sdf-icon' data-rtx-material='emissive' data-shape='star' data-color='#a855f7'><svg viewBox='0 0 100 100'><path d='M50 5L61 37L95 38L68 58L77 91L50 72L23 91L32 58L5 38L39 37Z'/></svg></div><button class='gc-glass-button lw-rtx' data-rtx-material='glass' data-rtx-ior='1.5'></button></div>"
        etToolbar = etToolbar $ "</div>"

        // Troisieme exemple : texte converti en SDF par le moteur V3.
        etText = "<div class='gc-text-example'><div class='gc-text-word'><span class='gc-sdf-text lw-sdf' data-text='R' data-color='#ff493d' data-rtx-material='glass'>R</span><span class='gc-sdf-text lw-sdf' data-text='T' data-color='#41ff91' data-rtx-material='glass'>T</span><span class='gc-sdf-text lw-sdf' data-text='X' data-color='#3b82f6' data-rtx-material='glass'>X</span></div></div>"
        etSourceRed = "<div class='gc-round-light gc-red-light lw-rtx' data-rtx-material='emissive'></div>"
        etSourceGreen = "<div class='gc-round-light gc-green-light lw-rtx' data-rtx-material='emissive'></div>"

        // Templates de VRAIS widgets libwebui (gardes dans la toolbar pour le mode
        // custom). Chacun sera scanne par le RTX via .lw-eitem s'il est ajoute.
        etBtn = "<button type='button' class='ui-btn primary'><span data-icon='play'></span>Bouton</button>"
        etCard = webui::CardGrid()
        etCard.AddCard("Carte", "widget", "Contenu de la carte.")
        etCard.Close()
        etBadge = webui::Badge("Badge", "done")
        etTable = webui::Table()
        etTable.AddSection("Ligne 1", "Type", "Done", "done", "10", "5", "Eddie Lake", "gc_tr1")
        etTable.AddSection("Ligne 2", "Type", "In Process", "busy", "8", "3", "Marie Curie", "gc_tr2")
        etTable.Close()
        // Le lecteur + les widgets restent dans la toolbar (masquee par defaut en
        // mode demo ; reactivable en mode custom plus tard).
        editor.AddTemplate("player", etPlayer)
        editor.AddTemplate("glass_toolbar", etToolbar)
        editor.AddTemplate("text_v3", etText)
        editor.AddTemplate("source_red", etSourceRed)
        editor.AddTemplate("source_green", etSourceGreen)
        editor.AddTemplate("button", etBtn)
        editor.AddTemplate("card", etCard.html)
        editor.AddTemplate("badge", etBadge)
        editor.AddTemplate("table", etTable.html)
        editor.AddToolButton("player", "Lecteur", "bell")
        editor.AddToolButton("button", "Bouton", "plus")
        editor.AddToolButton("card", "Carte", "copy")
        editor.AddToolButton("badge", "Badge", "bell")
        editor.AddToolButton("table", "Table", "save")
        editor.Close()
        // Le lecteur initial est cree PAR le script du SceneEditor, au moment ou
        // son API locale `api` existe. Cela ne depend ni du bus d'events, ni du
        // chargement WebGL, ni de l'ordre d'execution du script Lighting.
        editor.html = freplace(editor.html, "}if(document.readyState==='loading'", "window.gc_editor=api;var boot=api.add('player','transparent');if(boot){boot.style.left='200px';boot.style.top='120px';boot.style.width='340px';boot.style.height='auto';boot.classList.add('gc-bare')} }if(document.readyState==='loading'")

        // Le canvas RTX (plein viewport) est ajoute a la scene de l'editeur : le
        // moteur lit les positions en coords viewport. Injecte via un petit HTML.
        rtxCanvas = "<style>#gcRtxCanvas{position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:60;pointer-events:none;mix-blend-mode:multiply;opacity:1}</style>"
        // Style du widget compose "lecteur musique". Plus grand pour bien le voir
        // dans le scene editor. Vignette avec image + boutons ronds.
        rtxCanvas = rtxCanvas $ "<style>"
        // Panneau OPAQUE + ombre (comme la page de test) -> contour net du lecteur.
        rtxCanvas = rtxCanvas $ ".gc-player{display:flex;flex-direction:column;gap:18px;padding:24px;box-sizing:border-box;width:100%;background:var(--bg-card);border-radius:20px;box-shadow:0 14px 44px rgba(0,0,0,.18)}"
        rtxCanvas = rtxCanvas $ ".gc-player-top{display:flex;gap:18px;align-items:center}"
        rtxCanvas = rtxCanvas $ ".gc-player-meta{min-width:0}.gc-player-title{font-weight:800;font-size:23px;color:var(--text-1);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.gc-player-artist{font-size:15px;color:var(--text-2)}"
        rtxCanvas = rtxCanvas $ ".gc-player-time{display:flex;justify-content:space-between;font-size:12px;color:var(--text-2)}"
        rtxCanvas = rtxCanvas $ ".gc-player-ctrl{display:flex;gap:12px;justify-content:center;align-items:center;margin-top:2px}"
        // Couleurs initiales des boutons du lecteur (sinon prev/next apparaissent
        // noirs : .lw-iconbtn n'a pas de fond et le shading diffus les assombrit).
        rtxCanvas = rtxCanvas $ ".gc-player-ctrl .lw-iconbtn{background:#64748b;color:#fff;border:0}"
        rtxCanvas = rtxCanvas $ ".gc-player-ctrl .lw-iconbtn.primary{background:#3b82f6}"
        rtxCanvas = rtxCanvas $ ".gc-player-ctrl .lw-iconbtn [data-icon]{color:#fff}"
        // Conteneur .lw-eitem 'nu' pour le lecteur : pas de fond/ombre/bordure de
        // selection -> on ne voit QUE le lecteur (comme la page de test isolee).
        rtxCanvas = rtxCanvas $ ".lw-eitem.gc-bare{background:transparent!important;box-shadow:none!important;overflow:visible;width:420px!important;height:auto!important;min-height:0!important}"
        rtxCanvas = rtxCanvas $ ".lw-eitem.gc-bare.lw-esel{outline:none}"
        rtxCanvas = rtxCanvas $ ".lw-eitem.gc-toolbar-host{background:transparent!important;box-shadow:none!important;overflow:visible;width:790px!important;height:178px!important}.lw-eitem.gc-toolbar-host>.gc-icon-toolbar{display:flex!important;flex-direction:row!important;align-items:center!important;gap:18px!important;width:max-content!important;height:auto!important;box-sizing:border-box}.gc-icon-toolbar{display:flex;align-items:center;gap:18px;padding:22px;border-radius:30px;background:rgba(255,255,255,.16);box-shadow:0 24px 70px rgba(15,23,42,.16);width:max-content}.gc-tool{position:relative;display:grid;place-items:center;flex:0 0 126px;width:126px;height:126px}.gc-glass-button{position:absolute;inset:0;z-index:2;width:100%;height:100%;border:1px solid rgba(255,255,255,.9);border-radius:30px;background:rgba(224,247,255,.22);box-shadow:0 16px 38px rgba(15,23,42,.16);padding:0;opacity:.32}.gc-sdf-icon{position:absolute;z-index:1;width:68px;height:68px;color:var(--gc-icon);filter:drop-shadow(0 0 16px var(--gc-icon));pointer-events:none;opacity:.32}.gc-sdf-icon svg{width:100%;height:100%;fill:currentColor;stroke:currentColor;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}.gc-sdf-icon[data-color='#ff493d']{--gc-icon:#ff493d}.gc-sdf-icon[data-color='#3b82f6']{--gc-icon:#3b82f6}.gc-sdf-icon[data-color='#22c55e']{--gc-icon:#22c55e}.gc-sdf-icon[data-color='#f59e0b']{--gc-icon:#f59e0b}.gc-sdf-icon[data-color='#a855f7']{--gc-icon:#a855f7}"
        rtxCanvas = rtxCanvas $ ".lw-eitem.gc-text-host{background:transparent!important;box-shadow:none!important;overflow:visible;width:620px!important;height:320px!important}.lw-eitem.gc-text-host>.gc-text-example{display:grid!important;place-items:center;position:relative;width:100%!important;height:100%!important;overflow:visible}.gc-text-word{display:flex;justify-content:center;align-items:center;gap:18px;position:relative;z-index:2}.gc-sdf-text{font:900 190px/1 'Arial Black',Arial,sans-serif;letter-spacing:-8px;filter:drop-shadow(0 0 18px currentColor);white-space:nowrap;cursor:pointer;opacity:.16}.gc-sdf-text[data-text='R']{color:#ff493d}.gc-sdf-text[data-text='T']{color:#41ff91}.gc-sdf-text[data-text='X']{color:#3b82f6}.lw-eitem.gc-light-host{background:transparent!important;box-shadow:none!important;overflow:visible;width:76px!important;height:76px!important;min-width:76px!important;min-height:76px!important}.lw-eitem.gc-light-host>.gc-round-light{display:block!important;width:72px!important;height:72px!important;border-radius:999px;border:2px solid rgba(255,255,255,.8);opacity:1!important}.gc-red-light{background:#ff493d;box-shadow:0 0 28px 8px rgba(255,73,61,.65)}.gc-green-light{background:#41ff91;box-shadow:0 0 28px 8px rgba(65,255,145,.65)}"
        // IMPORTANT : le selecteur global .lw-eitem>:first-child impose display:block
        // (spec 0,1,1) et ECRASE le display:flex de .gc-player (spec 0,1,0) -> layout
        // casse (tout empile, pas de gap). On remet flex ici (spec 0,2,1).
        rtxCanvas = rtxCanvas $ ".lw-eitem.gc-bare>:first-child{opacity:1!important;width:100%!important;height:auto!important;box-sizing:border-box;display:flex!important;flex-direction:column}"
        // Mode DEMO : la toolbar verticale de l'editeur RTX est masquee par defaut
        // (on montre une demo figee). Le mode custom la reaffichera (retirer .gc-demo).
        rtxCanvas = rtxCanvas $ "#gc_editor.gc-demo .lw-vtb{display:none}"
        // SceneEditor confine dans la place disponible (pas de min-height fixe qui
        // depasse). L'editeur remplit la hauteur du panneau principal, sans plus.
        rtxCanvas = rtxCanvas $ "#gc_lighting_layout .lw-side-main{overflow:hidden}"
        rtxCanvas = rtxCanvas $ "#gc_lighting_layout .lw-side-main>.gallery-stack{height:100%;min-height:0;display:flex;flex-direction:column}"
        rtxCanvas = rtxCanvas $ "#gc_lighting_layout #gc_editor{flex:1 1 auto;height:auto;min-height:0}"
        rtxCanvas = rtxCanvas $ "#gc_lighting_layout #gc_editor_page{height:100%;min-height:0}"
        // ---- Panneau de configuration Lighting : IHM compacte, ZERO debordement ----
        // Le SidePanel fait 390px : les lignes label(180px)+slider+valeur debordaient
        // (flex-wrap:wrap -> 2 lignes). Fix robuste (pas de :has()) : label compact a
        // largeur bornee + slider elastique (flex:1,min-width:0) + valeur etroite ->
        // tout tient sur UNE ligne, jamais de wrap.
        rtxCanvas = rtxCanvas $ "#gc_lighting_layout .lw-side-aside{padding:12px 14px}"
        rtxCanvas = rtxCanvas $ "#gc_lighting_layout .gallery-row{display:flex!important;flex-wrap:nowrap!important;flex-direction:row;align-items:center;gap:10px;margin:0}"
        // Label : largeur bornee (pas 180px), texte qui peut passer sur 2 lignes sans pousser.
        rtxCanvas = rtxCanvas $ "#gc_lighting_layout .gallery-row>.gallery-note{min-width:0!important;flex:0 0 120px;width:120px;font-weight:600;color:var(--text-2);white-space:normal;font-size:12px;line-height:1.25}"
        // Slider : prend tout l'espace restant, peut retrecir (min-width:0 = clef anti-debordement).
        rtxCanvas = rtxCanvas $ "#gc_lighting_layout .gallery-row input[type='range']{flex:1 1 auto;width:auto!important;min-width:0;margin:0}"
        // Valeur numerique : etroite, alignee a droite.
        rtxCanvas = rtxCanvas $ "#gc_lighting_layout .gallery-row .gallery-slider-value{flex:0 0 auto;min-width:32px;text-align:right;font-variant-numeric:tabular-nums;font-size:12px}"
        // Selects / inputs texte : prennent l'espace restant sans deborder.
        rtxCanvas = rtxCanvas $ "#gc_lighting_layout .gallery-row .ui-input,#gc_lighting_layout .gallery-row select,#gc_lighting_layout .gallery-row input[type='text']{flex:1 1 auto;width:auto!important;min-width:0;box-sizing:border-box}"
        // Boutons (Auto...) : compacts, ne poussent pas.
        rtxCanvas = rtxCanvas $ "#gc_lighting_layout .gallery-row button{flex:0 0 auto;padding:4px 10px;font-size:12px}"
        // Statut/notes secondaires : discrets (et retour a la ligne autorise s'ils suivent).
        rtxCanvas = rtxCanvas $ "#gc_lighting_layout #gcLightingStatus,#gc_lighting_layout #gcPresetNote{flex:1 1 100%;font-size:11px;opacity:.7;text-align:left}"
        rtxCanvas = rtxCanvas $ "#gc_lighting_layout .gallery-stack{gap:12px}"
        rtxCanvas = rtxCanvas $ "</style>"
        rtxCanvas = rtxCanvas $ "<canvas id='gcRtxCanvas'></canvas>"

        // Contenu du widget Toba SidePanel. Il sera place a droite du SceneEditor.
        cfgScene = "<div class='gallery-stack' style='gap:10px'>"
        // Backend lumineux commun au meme editeur et aux memes widgets.
        cfgScene = cfgScene $ "<div class='gallery-row' style='align-items:center;gap:12px'><span class='gallery-note' style='min-width:180px'>Moteur Lighting</span><select id='gcEngineSel' class='ui-input' style='width:200px'><option value='realtime' selected>RTX Realtime V3</option><option value='quality'>RTX Quality V3</option><option value='radiance'>Radiance Cascade</option></select><span id='gcLightingStatus' class='gallery-note'>en attente</span></div>"
        cfgScene = cfgScene $ "<div class='gallery-row' style='align-items:center;gap:12px'><span class='gallery-note' style='min-width:180px'>Exemple</span><select id='gcExampleSel' class='ui-input' style='width:240px'><option value='player' selected>Lecteur audio</option><option value='glass_toolbar'>Toolbar verre + icones emissives</option><option value='text_v3'>Texte SDF V3</option></select></div>"
        cfgScene = cfgScene $ "<div class='gallery-row' style='align-items:center;gap:12px'><span class='gallery-note' style='min-width:180px'>Preset de rendu</span><select id='gcPresetSel' class='ui-input' style='width:240px'><option value='gallery' selected>Gallery - grille visible</option><option value='demo'>Demo V3 fidele</option></select><span id='gcPresetNote' class='gallery-note'>Composition adaptee a l IHM</span></div></div>"
        cfgMaterial = "<div class='gallery-stack' style='gap:10px'>"
        // Materiau du widget selectionne
        cfgMaterial = cfgMaterial $ "<div class='gallery-row' style='align-items:center;gap:12px'><span class='gallery-note' style='min-width:180px'>Materiau (widget selectionne)</span><select id='gcMatSel' class='ui-input' style='width:200px'><option value='0'>Diffus</option><option value='1'>Miroir</option><option value='2'>Verre</option><option value='3'>Glossy</option><option value='4'>Emissif</option></select></div>"
        // Couleur du widget selectionne : VRAI color picker custom libwebui
        // (plan de couleur + teinte + chips + hex). Emet gc_color_change {value}.
        gcColPicker = widgets_extra::ColorPicker()
        gcColPicker.Setup("gcColorPick", "Couleur (widget selectionne)", "#3b82f6", ("#ef4444", "#3b82f6", "#22c55e", "#f59e0b", "#a855f7", "#ffffff"), "gc_color_change")
        gcColPicker.Close()
        cfgMaterial = cfgMaterial $ gcColPicker.html
        // Transparence du widget sur l'objet (opacite du contenu 0.1 -> 1.0).
        cfgMaterial = cfgMaterial $ "<div class='gallery-row' style='align-items:center;gap:12px'><span class='gallery-note' style='min-width:180px'>Transparence du widget</span><input type='range' id='gcTranspRange' min='0.1' max='1' step='0.05' value='0.75' style='flex:1'><span id='gcTranspVal' class='gallery-slider-value' style='min-width:36px'>0.75</span></div></div>"
        cfgRender = "<div class='gallery-stack' style='gap:10px'>"
        // (Avancer / Reculer / Supprimer -> menu contextuel ... sur chaque widget)
        // Optimisation (renderScale)
        cfgRender = cfgRender $ "<div class='gallery-row'><span class='gallery-note'>Optimisation (vitesse)</span><select id='gcOptimSel' class='ui-input'><option value='0.1'>0.1</option><option value='0.2'>0.2</option><option value='0.3'>0.3</option><option value='0.4'>0.4</option><option value='0.5'>0.5</option><option value='0.55'>0.55</option><option value='0.6'>0.6</option><option value='0.7' selected>0.7</option><option value='0.8'>0.8</option><option value='0.9'>0.9</option><option value='1.0'>1.0</option></select></div>"
        cfgRender = cfgRender $ "<div class='gallery-row'><span class='gallery-note'>Blend RTX</span><select id='gcBlendSel' class='ui-input'><option value='multiply' selected>multiply</option><option value='normal'>normal</option><option value='screen'>screen</option><option value='plus-lighter'>plus-lighter</option><option value='overlay'>overlay</option></select></div><div class='gallery-row'><span class='gallery-note'>Opacite canvas</span><input id='gcCanvasOpacity' type='range' min='0.1' max='1' step='0.05' value='1'><span id='gcCanvasOpacityVal' class='gallery-slider-value'>1.00</span></div></div>"
        cfgTransport = "<div class='gallery-stack' style='gap:10px'>"
        cfgTransport = cfgTransport $ "<div class='gallery-row'><span class='gallery-note'>Bounces</span><input id='gcBouncesRange' type='range' min='1' max='8' step='1' value='4'><span id='gcBouncesVal' class='gallery-slider-value'>4</span></div><div class='gallery-row'><span class='gallery-note'>Temporal</span><input id='gcTemporalRange' type='range' min='0' max='0.55' step='0.01' value='0'><span id='gcTemporalVal' class='gallery-slider-value'>0.00</span></div>"
        cfgTransport = cfgTransport $ "<div class='gallery-row'>" $ widget_core::Checkbox("gcDenoiseOn", "SVGF / denoise", 1, "gc_denoise_toggle") $ "</div>"
        cfgTransport = cfgTransport $ "<div class='gallery-row'><span class='gallery-note'>Force denoise</span><input id='gcDenoiseForce' type='range' min='0' max='1' step='0.02' value='0.86'><span id='gcDenoiseForceVal' class='gallery-slider-value'>0.86</span></div><div class='gallery-row'><span class='gallery-note'>Rayon denoise</span><input id='gcDenoiseRadius' type='range' min='0.5' max='3' step='0.1' value='1.8'><span id='gcDenoiseRadiusVal' class='gallery-slider-value'>1.8</span></div>"
        // Puissance emissive
        cfgTransport = cfgTransport $ "<div class='gallery-row'><span class='gallery-note'>Puissance emissive</span><input type='range' id='gcEmisRange' min='0' max='8' step='0.2' value='3'><span id='gcEmisVal' class='gallery-slider-value'>3.0</span></div><div class='gallery-row'><span class='gallery-note'>Emission frontale</span><input type='range' id='gcFrontRange' min='0' max='3' step='0.1' value='1'><span id='gcFrontVal' class='gallery-slider-value'>1.0</span></div></div>"
        cfgPost = "<div class='gallery-stack' style='gap:10px'>"
        // Saturation
        cfgPost = cfgPost $ "<div class='gallery-row'><span class='gallery-note'>Saturation</span><input type='range' id='gcSatRange' min='0' max='3' step='0.1' value='1'><span id='gcSatVal' class='gallery-slider-value'>1.0</span></div>"
        // Bloom (halo)
        cfgPost = cfgPost $ "<div class='gallery-row'><span class='gallery-note'>Bloom</span><input type='range' id='gcBloomRange' min='0' max='2' step='0.05' value='0.55'><span id='gcBloomVal' class='gallery-slider-value'>0.55</span></div><div class='gallery-row'><span class='gallery-note'>Seuil bloom</span><input type='range' id='gcBloomThreshold' min='0' max='1' step='0.01' value='0.62'><span id='gcBloomThresholdVal' class='gallery-slider-value'>0.62</span></div>"
        cfgPost = cfgPost $ "<div class='gallery-row'>" $ widget_core::Checkbox("gcAcesOn", "ACES", 0, "gc_aces_toggle") $ "</div>" $ "<div class='gallery-row'><span class='gallery-note'>Exposition</span><input id='gcExposureRange' type='range' min='0.5' max='4' step='0.1' value='1.6'><span id='gcExposureVal' class='gallery-slider-value'>1.6</span></div>" $ "<div class='gallery-row'>" $ widget_core::Checkbox("gcFresnelOn", "Fresnel", 1, "gc_fresnel_toggle") $ "</div>" $ "<div class='gallery-row'><span class='gallery-note'>Force Fresnel</span><input id='gcFresnelRange' type='range' min='0' max='1' step='0.05' value='0.6'><span id='gcFresnelVal' class='gallery-slider-value'>0.60</span></div>"
        // Ambiance : luminosite du fond du path tracer, DECOUPLE du theme. 0 =
        // boite noire (contraste dramatique, emissifs ressortent), 1 = studio
        // blanc (doux). Bouton Auto = re-suit la couleur du theme.
        cfgPost = cfgPost $ "<div class='gallery-row'><span class='gallery-note'>Ambiance (fond shader)</span><input type='range' id='gcAmbientRange' min='0' max='1' step='0.05' value='0.3'><span id='gcAmbientVal' class='gallery-slider-value'>auto</span><button type='button' id='gcAmbientAuto' class='ui-btn'>Auto</button></div></div>"
        cfgAccordion = webui::Navigation()
        cfgAccordion.SetupAccordion("gc_config_accordion")
        cfgAccordion.AddAccordionSection("Scene et exemple", cfgScene, 1)
        cfgAccordion.AddAccordionSection("Materiau selectionne", cfgMaterial, 0)
        cfgAccordion.AddAccordionSection("Rendu et composition", cfgRender, 0)
        cfgAccordion.AddAccordionSection("Transport lumineux", cfgTransport, 0)
        cfgAccordion.AddAccordionSection("Post-traitement", cfgPost, 0)
        cfgAccordion.CloseAccordion()
        rtxCfg = cfgAccordion.html

        // JS RTX : se BRANCHE sur l'editeur (window.gc_editor). L'editeur gere
        // le DOM (drag/resize/add/pick/reindex) ; le RTX fait le raytracing +
        // les reglages. api.onScan = rescan RTX ; api.onPick = sync du panneau.
        rtxScript = "<script>"
        // Vignette = pochette dessinee sur CANVAS (pas de data URI SVG : les < / '
        // et surtout // casseraient le HTML/JS genere par Toba). Chaque pochette
        // est un degrade 2 couleurs ; on lit sa couleur MOYENNE sur le meme canvas
        // et on la pose en background-color de la vignette -> emission RTX teintee.
        rtxScript = rtxScript $ "window.gcCovers=[[[249,115,22],[220,38,38]],[[6,182,212],[59,130,246]],[[168,85,247],[236,72,153]]];"
        rtxScript = rtxScript $ "window.gcDrawCover=function(pair){var c=document.createElement('canvas');c.width=64;c.height=64;var x=c.getContext('2d');var g=x.createLinearGradient(0,0,64,64);g.addColorStop(0,'rgb('+pair[0].join(',')+')');g.addColorStop(1,'rgb('+pair[1].join(',')+')');x.fillStyle=g;x.fillRect(0,0,64,64);x.fillStyle='rgba(255,255,255,.25)';x.beginPath();x.arc(22,22,13,0,6.29);x.fill();return c};"
        rtxScript = rtxScript $ "window.gcAverageColor=function(canvas){var w=canvas.width,h=canvas.height;var x=canvas.getContext('2d');var d;try{d=x.getImageData(0,0,w,h).data}catch(e){return null}var r=0,g=0,b=0,n=0;for(var i=0;i<d.length;i+=4){var a=d[i+3]/255;r+=d[i]*a;g+=d[i+1]*a;b+=d[i+2]*a;n+=a}if(n<1)return null;return [Math.round(r/n),Math.round(g/n),Math.round(b/n)]};"
        // Charge une pochette dans le lecteur (el = .lw-eitem) : dessine l'image sur
        // la vignette (canvas) ET pose bg-color = couleur moyenne -> emission RTX.
        rtxScript = rtxScript $ "window.gcLoadCover=function(el,idx){var art=el.querySelector('.lw-thumb');if(!art)return;var i=((idx||0)%gcCovers.length+gcCovers.length)%gcCovers.length;el.setAttribute('data-cover',i);var cv=gcDrawCover(gcCovers[i]);cv.className='lw-thumb-img';var old=art.querySelector('.lw-thumb-img');if(old)old.remove();art.appendChild(cv);var rgb=gcAverageColor(cv);if(rgb){art.style.backgroundColor='rgb('+rgb[0]+','+rgb[1]+','+rgb[2]+')';if(window.__gcLighting)window.__gcLighting.updateSceneFromDOM()}};"
        // SDF des cinq icones de la toolbar (meme methode EDT que la demo V3).
        rtxScript = rtxScript $ "window.gcEdt1=function(f,n){var d=new Float64Array(n),v=new Int32Array(n),z=new Float64Array(n+1),k=0;v[0]=0;z[0]=-1e20;z[1]=1e20;for(var q=1;q<n;q++){var s=((f[q]+q*q)-(f[v[k]]+v[k]*v[k]))/(2*q-2*v[k]);while(s<=z[k]){k--;s=((f[q]+q*q)-(f[v[k]]+v[k]*v[k]))/(2*q-2*v[k])}k++;v[k]=q;z[k]=s;z[k+1]=1e20}k=0;for(var x=0;x<n;x++){while(z[k+1]<x)k++;var a=x-v[k];d[x]=a*a+f[v[k]]}return d};"
        rtxScript = rtxScript $ "window.gcEdt2=function(bin,w,h){var f=new Float64Array(w*h),col=new Float64Array(h),row=new Float64Array(w);for(var i=0;i<f.length;i++)f[i]=bin[i]?0:1e20;for(var x=0;x<w;x++){for(var y=0;y<h;y++)col[y]=f[y*w+x];var d=gcEdt1(col,h);for(var y2=0;y2<h;y2++)f[y2*w+x]=d[y2]}for(var y3=0;y3<h;y3++){for(var x2=0;x2<w;x2++)row[x2]=f[y3*w+x2];var e=gcEdt1(row,w);for(var x3=0;x3<w;x3++)f[y3*w+x3]=Math.sqrt(e[x3])}return f};"
        rtxScript = rtxScript $ "window.gcIconShape=function(c,n,L,T,W,H){c.beginPath();if(n==='play'){c.moveTo(L+W*.25,T+H*.12);c.lineTo(L+W*.88,T+H*.5);c.lineTo(L+W*.25,T+H*.88);c.closePath()}else if(n==='plus'){c.rect(L+W*.43,T+H*.12,W*.14,H*.76);c.rect(L+W*.12,T+H*.43,W*.76,H*.14)}else if(n==='diamond'){c.moveTo(L+W*.5,T+H*.08);c.lineTo(L+W*.92,T+H*.5);c.lineTo(L+W*.5,T+H*.92);c.lineTo(L+W*.08,T+H*.5);c.closePath()}else if(n==='pause'){c.rect(L+W*.22,T+H*.12,W*.2,H*.76);c.rect(L+W*.58,T+H*.12,W*.2,H*.76)}else{for(var i=0;i<10;i++){var a=-Math.PI/2+i*Math.PI/5,rr=i%2?W*.19:W*.46,x=L+W*.5+Math.cos(a)*rr,y=T+H*.5+Math.sin(a)*rr;if(i)c.lineTo(x,y);else c.moveTo(x,y)}c.closePath()}c.fill()};"
        rtxScript = rtxScript $ "window.gcHex=function(h){var n=parseInt(h.slice(1),16);return[(n>>16&255)/255,(n>>8&255)/255,(n&255)/255]};"
        rtxScript = rtxScript $ "window.gcRefreshToolbarGlyphs=function(){var rt=window.__gcLighting;if(!rt||rt._radiance||!rt.setGlyphs)return;var icons=Array.prototype.slice.call(document.querySelectorAll('#gc_editor .gc-sdf-icon')),base=rt.canvas||document.getElementById('gcRtxCanvas'),w=base&&base.width?base.width:innerWidth,h=base&&base.height?base.height:innerHeight,s=w/innerWidth,c=document.getElementById('gcToolbarSdf');if(!c){c=document.createElement('canvas');c.id='gcToolbarSdf';c.hidden=true;document.body.appendChild(c)}c.width=w;c.height=h;var x=c.getContext('2d',{willReadFrequently:true});x.fillStyle='#000';x.fillRect(0,0,w,h);if(!icons.length){rt.setGlyphs(c,[],60,.08,1.5);return}var idx=document.createElement('canvas');idx.width=w;idx.height=h;var ix=idx.getContext('2d',{willReadFrequently:true});ix.fillStyle='#000';ix.fillRect(0,0,w,h);icons.forEach(function(el,k){var r=el.getBoundingClientRect(),L=r.left*s,T=r.top*s,W=r.width*s,H=r.height*s;x.fillStyle='#fff';gcIconShape(x,el.getAttribute('data-shape'),L,T,W,H);ix.fillStyle='rgb('+((k+1)*32)+',0,0)';gcIconShape(ix,el.getAttribute('data-shape'),L,T,W,H)});var px=x.getImageData(0,0,w,h).data,id=ix.getImageData(0,0,w,h).data,inside=new Uint8Array(w*h),outside=new Uint8Array(w*h),who=new Int8Array(w*h);who.fill(-1);for(var p=0;p<w*h;p++){inside[p]=px[p*4]>128?1:0;outside[p]=inside[p]?0:1;if(inside[p])who[p]=Math.max(0,Math.round(id[p*4]/32)-1)}var dout=gcEdt2(inside,w,h),din=gcEdt2(outside,w,h),im=x.createImageData(w,h);for(var q=0;q<w*h;q++){var sd=inside[q]?-din[q]:dout[q],v=Math.max(0,Math.min(1,sd/120+.5)),o=q*4;im.data[o]=Math.round(v*255);im.data[o+1]=who[q]>=0?who[q]+1:0;im.data[o+3]=255}x.putImageData(im,0,0);rt.setGlyphs(c,icons.map(function(el){return{color:gcHex(el.getAttribute('data-color')),mat:4}}),60,.08,1.5)};"
        // Version generale : icones et texte partagent la meme texture SDF.
        rtxScript = rtxScript $ "window.gcRefreshToolbarGlyphs=function(){var rt=window.__gcLighting;if(!rt||rt._radiance||!rt.setGlyphs)return;var icons=Array.prototype.slice.call(document.querySelectorAll('#gc_editor .gc-sdf-icon')),texts=Array.prototype.slice.call(document.querySelectorAll('#gc_editor .gc-sdf-text')),els=icons.concat(texts),base=rt.canvas||document.getElementById('gcRtxCanvas'),w=base&&base.width?base.width:innerWidth,h=base&&base.height?base.height:innerHeight,s=w/innerWidth,c=document.getElementById('gcToolbarSdf');if(!c){c=document.createElement('canvas');c.id='gcToolbarSdf';c.hidden=true;document.body.appendChild(c)}c.width=w;c.height=h;var x=c.getContext('2d',{willReadFrequently:true}),idx=document.createElement('canvas');idx.width=w;idx.height=h;var ix=idx.getContext('2d',{willReadFrequently:true});x.fillStyle='#000';x.fillRect(0,0,w,h);ix.fillStyle='#000';ix.fillRect(0,0,w,h);if(!els.length){rt.setGlyphs(c,[],60,.08,1.5);return}var draw=function(ctx,el,k,indexed){var r=el.getBoundingClientRect(),L=r.left*s,T=r.top*s,W=r.width*s,H=r.height*s;ctx.fillStyle=indexed?'rgb('+((k+1)*32)+',0,0)':'#fff';if(el.classList.contains('gc-sdf-icon')){gcIconShape(ctx,el.getAttribute('data-shape'),L,T,W,H)}else{var cs=getComputedStyle(el);ctx.font=cs.fontWeight+' '+(parseFloat(cs.fontSize)*s)+'px '+cs.fontFamily;ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(el.getAttribute('data-text')||el.textContent,(L+W*.5),(T+H*.5))}};els.forEach(function(el,k){draw(x,el,k,false);draw(ix,el,k,true)});var px=x.getImageData(0,0,w,h).data,id=ix.getImageData(0,0,w,h).data,inside=new Uint8Array(w*h),outside=new Uint8Array(w*h),who=new Int8Array(w*h);who.fill(-1);for(var p=0;p<w*h;p++){inside[p]=px[p*4]>128?1:0;outside[p]=inside[p]?0:1;if(inside[p])who[p]=Math.max(0,Math.round(id[p*4]/32)-1)}var dout=gcEdt2(inside,w,h),din=gcEdt2(outside,w,h),im=x.createImageData(w,h);for(var q=0;q<w*h;q++){var sd=inside[q]?-din[q]:dout[q],v=Math.max(0,Math.min(1,sd/120+.5)),o=q*4;im.data[o]=Math.round(v*255);im.data[o+1]=who[q]>=0?who[q]+1:0;im.data[o+3]=255}x.putImageData(im,0,0);var mats={diffuse:0,mirror:1,glass:2,glossy:3,emissive:4};rt.setGlyphs(c,els.map(function(el){return{color:gcHex(el.getAttribute('data-color')||'#ffffff'),mat:mats[el.getAttribute('data-rtx-material')]===undefined?4:mats[el.getAttribute('data-rtx-material')]}}),60,.08,1.5)};"
        rtxScript = rtxScript $ "window.gcClipLightingCanvas=function(){var cv=document.getElementById('gcRtxCanvas'),page=document.getElementById('gc_editor_page');if(!cv||!page)return;var r=page.getBoundingClientRect(),t=Math.max(0,r.top),l=Math.max(0,r.left),rr=Math.max(0,innerWidth-r.right),b=Math.max(0,innerHeight-r.bottom);cv.style.clipPath='inset('+t+'px '+rr+'px '+b+'px '+l+'px)'};"
        // Cree le lecteur independamment du moteur. Peut etre rappele sans
        // doublon si le SceneEditor n'etait pas encore pret au premier essai.
        rtxScript = rtxScript $ "window.gcEnsureLightingPlayer=function(){var ed=window.gc_editor;if(!ed||!ed.items||!ed.add)return false;if(!ed.items().length){var pl=ed.add('player','transparent');if(!pl)return false;pl.style.left='200px';pl.style.top='120px';pl.style.width='340px';pl.style.height='auto'}var items=ed.items(),host=null;for(var i=0;i<items.length;i++){if(items[i].querySelector('.gc-player')){host=items[i];break}}if(host){host.classList.add('gc-bare');if(window.gcLoadCover&&!host.getAttribute('data-cover'))gcLoadCover(host)}ed.reindex();return ed.items().length>0};"
        // Fabrique un backend qui expose l'API commune utilisee plus bas. Le
        // wrapper Radiance fournit des no-op pour les reglages propres au path tracer.
        rtxScript = rtxScript $ "window.gcLightingCreate=function(mode){var sel='#gc_editor .lw-rtx',cv=document.getElementById('gcRtxCanvas');if(!cv){cv=document.createElement('canvas');cv.id='gcRtxCanvas';document.body.appendChild(cv)}if(mode==='radiance'){cv.style.display='none';if(!window.GridCraftHtmlEffects||!window.RC)return null;var fx=new GridCraftHtmlEffects({mode:'radiance',targets:[sel,'#gc_editor .gc-sdf-icon'],autoStart:true,overlay:{opacity:.85,blendMode:'multiply',zIndex:60},performance:{maxFPS:60,qualityScale:.6,maxElements:180,observeDom:true},radiance:{srgb:true,maxAlpha:.7}});fx.start();return{_radiance:true,_fx:fx,scene:[],lights:[],frameCount:0,updateSceneFromDOM:function(){fx.refresh()},getObjectProperties:function(el){var n=['diffuse','mirror','glass','glossy','emissive'];return{materialType:Math.max(0,n.indexOf(el.getAttribute('data-rtx-material')||'diffuse'))}},updateObjectProperty:function(){fx.refresh()},setRenderScale:function(){},setBackgroundColor:function(){},setEmissivePower:function(){},setSaturation:function(){},setBloom:function(){},destroy:function(){fx.destroy()}}}cv.style.display=String();var E=mode==='quality'?window.RTX_Quality:window.RTX_Realtime;if(!E)return null;return new E('gcRtxCanvas',{domSelector:sel,renderScale:mode==='quality'?1:.7,maxBounces:4,temporalAlpha:0,denoiseEnabled:true,denoiseStrength:.86,denoiseRadius:1.8,settleProfile:'quality-burst'})};"
        rtxScript = rtxScript $ "window.gcRtxInit=function(){"
        rtxScript = rtxScript $ "  var ed=window.gc_editor;if(!ed)return;if(!gcEnsureLightingPlayer())return;"
        // Le lecteur doit exister meme si une ancienne instance RTX subsiste lors
        // d'un retour dans l'onglet. Son ajout ne depend plus du garde moteur.
        rtxScript = rtxScript $ "  gcEnsureLightingPlayer();"
        rtxScript = rtxScript $ "  if(window.__gcLighting)return;"
        // Realtime V3 = boucle/SVGF/settle stabilises du lecteur de production,
        // plus les corrections volumetriques V3.
        rtxScript = rtxScript $ "  var engineSel=document.getElementById('gcEngineSel'),st=document.getElementById('gcLightingStatus');try{window.__gcLighting=gcLightingCreate(engineSel?engineSel.value:'realtime')}catch(err){window.__gcLighting=null;if(st)st.textContent='erreur: '+err.message;console.error('[Lighting V3]',err)}if(!window.__gcLighting){if(st&&st.textContent.indexOf('erreur:')!==0)st.textContent='moteur indisponible';return}if(st)st.textContent='actif';"
        rtxScript = rtxScript $ "  var page=ed.page;var matSel=document.getElementById('gcMatSel');"
        rtxScript = rtxScript $ "  if(engineSel&&!engineSel.__gcBound){engineSel.__gcBound=1;engineSel.addEventListener('change',function(){if(window.__gcLighting&&window.__gcLighting.destroy)window.__gcLighting.destroy();window.__gcLighting=null;var st=document.getElementById('gcLightingStatus');if(st)st.textContent='demarrage...';gcRtxInit()})}"
        rtxScript = rtxScript $ "  var exampleSel=document.getElementById('gcExampleSel');window.gcSelectExample=function(type){var all=Array.prototype.slice.call(ed.items());for(var i=0;i<all.length;i++)ed.remove(all[i]);var it,rt=window.__gcLighting;if(type==='glass_toolbar'){it=ed.add('glass_toolbar','transparent');if(it){it.classList.add('gc-toolbar-host');it.style.left='55px';it.style.top='150px';it.style.width='790px';it.style.height='178px'}if(rt&&!rt._radiance){rt.setEmissivePower(3);if(rt.setFrontEmission)rt.setFrontEmission(1);rt.setBloom(true,.55,.62);if(rt.setGlossyFresnel)rt.setGlossyFresnel(true,.6)}}else if(type==='text_v3'){it=ed.add('text_v3','transparent');if(it){it.classList.add('gc-text-host');it.style.left='165px';it.style.top='130px';it.style.width='620px';it.style.height='320px'}var lr=ed.add('source_red','transparent');if(lr){lr.classList.add('gc-light-host');lr.style.left='55px';lr.style.top='250px';lr.style.width='76px';lr.style.height='76px'}var lg=ed.add('source_green','transparent');if(lg){lg.classList.add('gc-light-host');lg.style.left='825px';lg.style.top='250px';lg.style.width='76px';lg.style.height='76px'}}else{it=ed.add('player','transparent');if(it){it.classList.add('gc-bare');it.style.left='200px';it.style.top='120px';it.style.width='340px';it.style.height='auto';gcLoadCover(it)}if(window.gcRtxSyncBg)gcRtxSyncBg()}ed.reindex();if(window.gcClipLightingCanvas)gcClipLightingCanvas();if(rt)rt.updateSceneFromDOM();requestAnimationFrame(function(){if(window.gcRefreshToolbarGlyphs)gcRefreshToolbarGlyphs()})};if(exampleSel&&!exampleSel.__gcBound){exampleSel.__gcBound=1;exampleSel.addEventListener('change',function(){gcSelectExample(this.value)})}"
        // Mode demo par defaut : toolbar masquee (voir CSS #gc_editor.gc-demo).
        rtxScript = rtxScript $ "  var edEl=document.getElementById('gc_editor');if(edEl)edEl.classList.add('gc-demo');"
        rtxScript = rtxScript $ "  ed.onScan=function(){if(window.__gcLighting)window.__gcLighting.updateSceneFromDOM();requestAnimationFrame(function(){if(window.gcRefreshToolbarGlyphs)gcRefreshToolbarGlyphs()})};"
        // Les coords RTX sont en viewport. Pendant un scroll imbrique, masquer la
        // surcouche evite tout decalage, puis un seul rescan relance la convergence.
        rtxScript = rtxScript $ "  if(!window.__gcLightingScrollBound){window.__gcLightingScrollBound=1;window.addEventListener('scroll',function(){var rt=window.__gcLighting,cv=document.getElementById('gcRtxCanvas');if(!rt||rt._radiance)return;if(cv)cv.style.visibility='hidden';clearTimeout(window.__gcLightingScrollTimer);window.__gcLightingScrollTimer=setTimeout(function(){if(!window.__gcLighting)return;if(window.gcClipLightingCanvas)gcClipLightingCanvas();window.__gcLighting.updateSceneFromDOM();if(window.gcRefreshToolbarGlyphs)gcRefreshToolbarGlyphs();var c=document.getElementById('gcRtxCanvas');if(c)c.style.visibility='visible'},90)},true);window.addEventListener('resize',function(){if(window.gcClipLightingCanvas)gcClipLightingCanvas()})}"
        rtxScript = rtxScript $ "  if(!window.__gcLightingResizeObserver&&window.ResizeObserver){var observedPage=document.getElementById('gc_editor_page');if(observedPage){window.__gcLightingResizeObserver=new ResizeObserver(function(){clearTimeout(window.__gcLightingResizeTimer);window.__gcLightingResizeTimer=setTimeout(function(){if(window.gcClipLightingCanvas)gcClipLightingCanvas();if(window.__gcLighting){window.__gcLighting.updateSceneFromDOM();if(window.gcRefreshToolbarGlyphs)gcRefreshToolbarGlyphs()}},60)});window.__gcLightingResizeObserver.observe(observedPage)}}"
        rtxScript = rtxScript $ "  ed.onPick=function(el){if(!el||!matSel||!window.__gcLighting)return;var names=['diffuse','mirror','glass','glossy','emissive'];if(el.classList&&el.classList.contains('lw-sdf')){matSel.value=String(Math.max(0,names.indexOf(el.getAttribute('data-rtx-material')||'glass')))}else{var p=window.__gcLighting.getObjectProperties(el);matSel.value=String(p.materialType)}};"
        // Fond du shader = lumiere d'ambiance du path tracer. Par defaut il SUIT
        // le theme (window.__gcAmbient===null). Le slider 'Ambiance' l'override :
        // 0 = boite noire dramatique (emissifs ressortent), 1 = studio blanc doux.
        rtxScript = rtxScript $ "  if(typeof window.__gcAmbient==='undefined')window.__gcAmbient=null;"
        rtxScript = rtxScript $ "  window.gcRtxSyncBg=function(){if(!page||!window.__gcLighting)return;if(window.__gcAmbient!==null){var a=window.__gcAmbient;window.__gcLighting.setBackgroundColor([a,a,a]);return}var c=getComputedStyle(page).backgroundColor;var m=c.match(/(\\d+(?:\\.\\d+)?)/g);if(m&&m.length>=3){window.__gcLighting.setBackgroundColor([m[0]/255,m[1]/255,m[2]/255])}};"
        rtxScript = rtxScript $ "  gcRtxSyncBg();"
        // Materiau du widget selectionne (ed.sel). IMPORTANT : on met a jour
        // l'attribut data-rtx-material (source de verite RELUE par le moteur a
