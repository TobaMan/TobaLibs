        rtxScript = rtxScript $ "  var gcMatNames=['diffuse','mirror','glass','glossy','emissive'];"
        rtxScript = rtxScript $ "  if(matSel)matSel.addEventListener('change',function(e){var sel=ed.sel;if(!sel)return;var m=parseInt(e.target.value,10);if(sel.hasAttribute('data-rtx-material'))sel.setAttribute('data-rtx-material',gcMatNames[m]||'diffuse');var rt=window.__gcLighting;if(!rt)return;if(sel.classList&&sel.classList.contains('lw-sdf')){gcRefreshToolbarGlyphs();return}rt.updateObjectProperty(sel,'materialType',m);if(m===2){rt.updateObjectProperty(sel,'opacity',0.4);rt.updateObjectProperty(sel,'ior',1.5)}else if(m===3){rt.updateObjectProperty(sel,'roughness',0.2);rt.updateObjectProperty(sel,'opacity',1.0)}else{rt.updateObjectProperty(sel,'opacity',1.0)}rt.updateSceneFromDOM()});"
        // Color picker custom -> couleur du widget selectionne.
        rtxScript = rtxScript $ "  window.addEventListener('toba:event',function(e){var d=e.detail||{};if(d.name==='gc_color_change'&&ed.sel){var v=(d.data&&d.data.value)||d.value;if(v){if(ed.sel.classList&&ed.sel.classList.contains('lw-sdf')){ed.sel.setAttribute('data-color',v);ed.sel.style.color=v}else{ed.sel.style.background=v}ed.onScan()}}});"
        // Transparence.
        rtxScript = rtxScript $ "  var trR=document.getElementById('gcTranspRange'),trV=document.getElementById('gcTranspVal');if(trR){trR.addEventListener('input',function(e){var x=parseFloat(e.target.value);if(trV)trV.textContent=x.toFixed(2);if(ed.sel)ed.sel.style.setProperty('--lw-tr',x)})}"
        // Avancer / Reculer / Supprimer -> menu contextuel partage sur chaque widget.
        // Optimisation + sliders effet.
        rtxScript = rtxScript $ "  var optSel=document.getElementById('gcOptimSel');if(optSel){window.__gcLighting.setRenderScale(parseFloat(optSel.value));optSel.addEventListener('change',function(e){if(window.__gcLighting)window.__gcLighting.setRenderScale(parseFloat(e.target.value))})}"
        rtxScript = rtxScript $ "  var blendSel=document.getElementById('gcBlendSel'),canvasOpacity=document.getElementById('gcCanvasOpacity'),canvasOpacityVal=document.getElementById('gcCanvasOpacityVal');if(blendSel){var cv=document.getElementById('gcRtxCanvas');if(cv)cv.style.mixBlendMode=blendSel.value;if(!blendSel.__gcBound){blendSel.__gcBound=1;blendSel.addEventListener('change',function(){var c=document.getElementById('gcRtxCanvas');if(c)c.style.mixBlendMode=this.value})}}if(canvasOpacity){var cv2=document.getElementById('gcRtxCanvas');if(cv2)cv2.style.opacity=canvasOpacity.value;if(!canvasOpacity.__gcBound){canvasOpacity.__gcBound=1;canvasOpacity.addEventListener('input',function(){var c=document.getElementById('gcRtxCanvas');if(c)c.style.opacity=this.value;if(canvasOpacityVal)canvasOpacityVal.textContent=parseFloat(this.value).toFixed(2)})}}"
        rtxScript = rtxScript $ "  function gcBindRange(id,valId,fn,fix){var r=document.getElementById(id),v=document.getElementById(valId);if(!r)return;fn(parseFloat(r.value));r.__gcFn=fn;if(r.__gcBound)return;r.__gcBound=1;r.addEventListener('input',function(e){var x=parseFloat(e.target.value);if(v)v.textContent=x.toFixed(fix);if(r.__gcFn)r.__gcFn(x)})}function gcToggleValue(id){var root=document.getElementById(id),b=root&&root.querySelector('[role=switch]');return b?b.getAttribute('aria-checked')==='true':false}function gcBindCheck(id,fn){var c=document.getElementById(id);if(!c)return;c.__gcFn=fn;fn(gcToggleValue(id))}if(!window.__gcToggleEvents){window.__gcToggleEvents=1;window.addEventListener('toba:event',function(e){var d=e.detail||{},id=d.data&&d.data.id,root=id&&document.getElementById(id);if(root&&root.__gcFn)root.__gcFn(gcToggleValue(id))})}"
        rtxScript = rtxScript $ "  gcBindRange('gcBouncesRange','gcBouncesVal',function(x){var rt=window.__gcLighting;if(rt&&rt.setMaxBounces)rt.setMaxBounces(Math.round(x))},0);"
        rtxScript = rtxScript $ "  gcBindRange('gcTemporalRange','gcTemporalVal',function(x){var rt=window.__gcLighting;if(rt&&rt.setTemporalAlpha)rt.setTemporalAlpha(x)},2);"
        rtxScript = rtxScript $ "  function gcApplyDenoise(){var rt=window.__gcLighting,f=document.getElementById('gcDenoiseForce'),r=document.getElementById('gcDenoiseRadius');if(rt&&rt.setDenoise)rt.setDenoise(gcToggleValue('gcDenoiseOn'),f?parseFloat(f.value):.86,r?parseFloat(r.value):1.8)}gcBindCheck('gcDenoiseOn',gcApplyDenoise);gcBindRange('gcDenoiseForce','gcDenoiseForceVal',function(){gcApplyDenoise()},2);gcBindRange('gcDenoiseRadius','gcDenoiseRadiusVal',function(){gcApplyDenoise()},1);"
        rtxScript = rtxScript $ "  gcBindRange('gcEmisRange','gcEmisVal',function(x){if(window.__gcLighting)window.__gcLighting.setEmissivePower(x)},1);"
        rtxScript = rtxScript $ "  gcBindRange('gcFrontRange','gcFrontVal',function(x){var rt=window.__gcLighting;if(rt&&rt.setFrontEmission)rt.setFrontEmission(x)},1);"
        rtxScript = rtxScript $ "  gcBindRange('gcSatRange','gcSatVal',function(x){if(window.__gcLighting)window.__gcLighting.setSaturation(x)},1);"
        rtxScript = rtxScript $ "  function gcApplyBloom(){var rt=window.__gcLighting,b=document.getElementById('gcBloomRange'),t=document.getElementById('gcBloomThreshold');if(rt&&rt.setBloom){var x=b?parseFloat(b.value):0,th=t?parseFloat(t.value):.62;rt.setBloom(x>0,x,th)}}gcBindRange('gcBloomRange','gcBloomVal',function(){gcApplyBloom()},2);gcBindRange('gcBloomThreshold','gcBloomThresholdVal',function(){gcApplyBloom()},2);"
        rtxScript = rtxScript $ "  function gcApplyAces(){var rt=window.__gcLighting,e=document.getElementById('gcExposureRange');if(rt&&rt.setAces)rt.setAces(gcToggleValue('gcAcesOn'),e?parseFloat(e.value):1.6)}gcBindCheck('gcAcesOn',gcApplyAces);gcBindRange('gcExposureRange','gcExposureVal',function(){gcApplyAces()},1);"
        rtxScript = rtxScript $ "  function gcApplyFresnel(){var rt=window.__gcLighting,f=document.getElementById('gcFresnelRange');if(rt&&rt.setGlossyFresnel)rt.setGlossyFresnel(gcToggleValue('gcFresnelOn'),f?parseFloat(f.value):.6)}gcBindCheck('gcFresnelOn',gcApplyFresnel);gcBindRange('gcFresnelRange','gcFresnelVal',function(){gcApplyFresnel()},2);"
        // Ambiance : le slider override le fond du shader (0..1), le bouton Auto
        // remet le mode 'suit le theme' (window.__gcAmbient=null).
        rtxScript = rtxScript $ "  var ambR=document.getElementById('gcAmbientRange'),ambV=document.getElementById('gcAmbientVal'),ambA=document.getElementById('gcAmbientAuto');"
        rtxScript = rtxScript $ "  if(ambR){ambR.addEventListener('input',function(e){var x=parseFloat(e.target.value);window.__gcAmbient=x;if(ambV)ambV.textContent=x.toFixed(2);gcRtxSyncBg()})}"
        rtxScript = rtxScript $ "  if(ambA){ambA.addEventListener('click',function(){window.__gcAmbient=null;if(ambV)ambV.textContent='auto';gcRtxSyncBg()})}"
        rtxScript = rtxScript $ "  window.gcApplyLightingPreset=function(name){var rt=window.__gcLighting,cv=document.getElementById('gcRtxCanvas'),opt=document.getElementById('gcOptimSel'),blend=document.getElementById('gcBlendSel'),eng=document.getElementById('gcEngineSel'),note=document.getElementById('gcPresetNote');if(name==='demo'){if(opt)opt.value=eng&&eng.value==='quality'?'1.0':'0.55';if(blend)blend.value='normal';if(cv)cv.style.mixBlendMode='normal';window.__gcAmbient=.85;if(ambR)ambR.value='.85';if(ambV)ambV.textContent='0.85';if(note)note.textContent='Valeurs exactes de rtx_glass_toolbar_emissive_icons_v3.html'}else{if(opt)opt.value='0.7';if(blend)blend.value='multiply';if(cv)cv.style.mixBlendMode='multiply';window.__gcAmbient=null;if(ambV)ambV.textContent='auto';if(note)note.textContent='Composition adaptee a l IHM et grille visible'}if(rt&&opt&&rt.setRenderScale)rt.setRenderScale(parseFloat(opt.value));var setv=function(id,v){var e=document.getElementById(id);if(e){e.value=String(v);e.dispatchEvent(new Event('input'))}},sett=function(id,on){var root=document.getElementById(id),b=root&&root.querySelector('[role=switch]'),txt=document.getElementById(id+'_txt');if(b){b.classList.toggle('on',on);b.setAttribute('aria-checked',on?'true':'false');if(txt)txt.textContent=on?'On':'Off';if(root.__gcFn)root.__gcFn(on)}};setv('gcBouncesRange',4);setv('gcTemporalRange',0);setv('gcDenoiseForce',.86);setv('gcDenoiseRadius',1.8);setv('gcEmisRange',3);setv('gcFrontRange',1);setv('gcBloomRange',.55);setv('gcBloomThreshold',.62);setv('gcExposureRange',1.6);setv('gcFresnelRange',.6);sett('gcDenoiseOn',true);sett('gcAcesOn',false);sett('gcFresnelOn',true);gcRtxSyncBg()};var presetSel=document.getElementById('gcPresetSel');if(presetSel&&!presetSel.__gcBound){presetSel.__gcBound=1;presetSel.addEventListener('change',function(){gcApplyLightingPreset(this.value)})}"
        // Scene par defaut = VITRINE : un lecteur musique (glossy, capte la
        // lumiere) + une pochette emissive collee a cote (source de lumiere qui
        // eclaire le lecteur) + un accent. Positions posees a la main.
        rtxScript = rtxScript $ "  function gcPlace(el,x,y,w,h){if(!el)return;el.style.left=x+'px';el.style.top=y+'px';if(w)el.style.width=w+'px';if(h)el.style.height=h+'px'}"
        // Scene par defaut = UN SEUL lecteur, grand, bien visible dans l'editeur.
        // Le conteneur .lw-eitem n'est PAS un objet RTX (le RTX cible .gc-rtx
        // interne) : chaque sous-element du lecteur porte son propre materiau.
        rtxScript = rtxScript $ "  if(!ed.items().length){"
        rtxScript = rtxScript $ "    var pl=ed.add('player','transparent');if(pl){pl.style.left='200px';pl.style.top='120px';pl.style.width='340px';pl.style.height='auto';pl.classList.add('gc-bare');gcLoadCover(pl)}"
        rtxScript = rtxScript $ "    ed.reindex();"
        rtxScript = rtxScript $ "  }"
        rtxScript = rtxScript $ "  if(presetSel&&window.gcApplyLightingPreset)gcApplyLightingPreset(presetSel.value);if(exampleSel&&exampleSel.value==='glass_toolbar'&&!window.__gcLighting._radiance){var rt=window.__gcLighting;rt.setEmissivePower(3);if(rt.setFrontEmission)rt.setFrontEmission(1);rt.setBloom(true,.55,.62);if(rt.setGlossyFresnel)rt.setGlossyFresnel(true,.6)}if(window.gcClipLightingCanvas)gcClipLightingCanvas();window.__gcLighting.updateSceneFromDOM();requestAnimationFrame(function(){if(window.gcRefreshToolbarGlyphs)gcRefreshToolbarGlyphs()});"
        rtxScript = rtxScript $ "};"
        rtxScript = rtxScript $ "window.addEventListener('toba:event',function(e){var d=e.detail||{};if(d.name==='tab_fx_rtx'){if(window.gcStop)gcStop();[40,120,300,650,1100].forEach(function(ms){setTimeout(function(){if(window.__gcLighting)return;if(window.gcEnsureLightingPlayer)gcEnsureLightingPlayer();gcRtxInit();if(window.__gcLighting&&window.gcRtxSyncBg)gcRtxSyncBg()},ms)})}else if(d.name&&d.name.indexOf('theme_')===0){[80,260].forEach(function(ms){setTimeout(function(){if(window.gcRtxSyncBg)gcRtxSyncBg()},ms)})}});"
        // Certaines WebView ne relaient pas l'event du TabView jusqu'ici. Ce
        // watcher observe directement l'etat du panneau et initialise Lighting
        // une seule fois lorsqu'il devient visible.
        rtxScript = rtxScript $ "if(!window.__gcLightingWatcher){window.__gcLightingWatcher=setInterval(function(){var p=document.getElementById('tab_fx_rtx');if(!p||!p.classList.contains('active')||window.__gcLighting)return;if(window.gcEnsureLightingPlayer)gcEnsureLightingPlayer();gcRtxInit()},500)}"
        rtxScript = rtxScript $ "</script>"

        lightingPanel = webui::SidePanel()
        lightingPanel.Setup("gc_lighting_layout", "Configuration Lighting", "right", 390)
        lightingPanel.AddMainHtml("<div class='gallery-stack' style='height:100%;min-height:0'>" $ rtxTab $ rtxCanvas $ editor.html $ "</div>")
        lightingPanel.AddHtml(rtxCfg)
        lightingPanel.Close()
        rtxTab = lightingPanel.html $ rtxScript

        fxTabs = webui::TabView()
        fxTabs.AddHtml("fx_css", "CSS effects", " ", 1, cssTab)
        fxTabs.AddHtml("fx_rtx", "Lighting", "RTX", 0, rtxTab)
        fxTabs.Close()
        effectsPanel.AddHtml(fxTabs.html)
    effectsPanel.Close()
