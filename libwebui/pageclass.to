import : libwebui / desktopui

obj:WebPage() {
    self.title = "Toba WebUI"
    self.body = " "
    self.theme = "shadcn_light"

    func:SetTitle(self, title) {
        self.title = title
        return (self)
    }

    func:SetTheme(self, theme) {
        self.theme = theme
        return (self)
    }

    func:Add(self, html) {
        self.body = self.body $ html
        return (self)
    }

    func:AddWidget(self, widget) {
        self.body = self.body $ widget.prefix $ widget.body $ widget.suffix
        return (self)
    }

    func:Text(self, id, text) {
        self.body = self.body $ "<span id='" $ desktopui::EscapeHtml(id) $ "' class='pc-text'>" $ desktopui::EscapeHtml(text) $ "</span>"
        return (self)
    }

    func:Button(self, id, text, eventName) {
        self.body = self.body $ "<button id='" $ desktopui::EscapeHtml(id) $ "' class='pc-btn' onclick=\"pcEvent('" $ desktopui::EscapeJs(eventName) $ "',this.id)\">" $ desktopui::EscapeHtml(text) $ "</button>"
        return (self)
    }

    func:Badge(self, id, text, variant) {
        self.body = self.body $ "<span id='" $ desktopui::EscapeHtml(id) $ "' class='pc-badge " $ desktopui::EscapeHtml(variant) $ "'>" $ desktopui::EscapeHtml(text) $ "</span>"
        return (self)
    }

    func:BeginStack(self) {
        self.body = self.body $ "<div class='pc-stack'>"
        return (self)
    }

    func:EndStack(self) {
        self.body = self.body $ "</div>"
        return (self)
    }

    func:BeginToolbar(self) {
        self.body = self.body $ "<div class='pc-toolbar'>"
        return (self)
    }

    func:EndToolbar(self) {
        self.body = self.body $ "</div>"
        return (self)
    }

    func:BeginCard(self, id, title) {
        self.body = self.body $ "<section id='" $ desktopui::EscapeHtml(id) $ "' class='pc-card'><div class='pc-card-title'>" $ desktopui::EscapeHtml(title) $ "</div><div class='pc-card-body'>"
        return (self)
    }

    func:EndCard(self) {
        self.body = self.body $ "</div></section>"
        return (self)
    }

    func:BeginTabs(self) {
        self.body = self.body $ "<div class='pc-tabs'>"
        return (self)
    }

    func:Tab(self, id, text, eventName, active) {
        cls = "pc-tab"
        if (active == 1) {
            cls = "pc-tab active"
        }
        self.body = self.body $ "<button id='" $ desktopui::EscapeHtml(id) $ "' class='" $ cls $ "' onclick=\"pcTabEvent(this,'" $ desktopui::EscapeJs(eventName) $ "')\">" $ desktopui::EscapeHtml(text) $ "</button>"
        return (self)
    }

    func:EndTabs(self) {
        self.body = self.body $ "</div>"
        return (self)
    }

    func:BeginTable(self) {
        self.body = self.body $ "<div class='pc-table-wrap'><table class='pc-table'>"
        return (self)
    }

    func:HeaderRow(self, c1, c2, c3, c4) {
        self.body = self.body $ "<tr><th>" $ desktopui::EscapeHtml(c1) $ "</th><th>" $ desktopui::EscapeHtml(c2) $ "</th><th>" $ desktopui::EscapeHtml(c3) $ "</th><th>" $ desktopui::EscapeHtml(c4) $ "</th></tr>"
        return (self)
    }

    func:TableRow(self, c1, c2, c3, actionEvent) {
        self.body = self.body $ "<tr><td>" $ desktopui::EscapeHtml(c1) $ "</td><td>" $ c2 $ "</td><td>" $ desktopui::EscapeHtml(c3) $ "</td><td><button class='pc-btn' onclick=\"pcEvent('" $ desktopui::EscapeJs(actionEvent) $ "','" $ desktopui::EscapeJs(c1) $ "')\">Actions</button></td></tr>"
        return (self)
    }

    func:TableRowBadge(self, c1, badgeText, badgeKind, c3, actionEvent) {
        badge = "<span class='pc-badge " $ desktopui::EscapeHtml(badgeKind) $ "'>" $ desktopui::EscapeHtml(badgeText) $ "</span>"
        self.TableRow(c1, badge, c3, actionEvent)
        return (self)
    }

    func:EndTable(self) {
        self.body = self.body $ "</table></div>"
        return (self)
    }

    func:Styles(self) {
        css = "<style>"
        css = css $ ":root{--bg:#fafafa;--surface:#ffffff;--panel:#ffffff;--line:#e4e4e7;--line2:#d4d4d8;--text:#09090b;--muted:#52525b;--soft:#f4f4f5;--accent:#18181b;--accent-soft:rgba(24,24,27,.10);--ok:#00c781;--radius:8px;--pill:999px;font-family:Inter,Segoe UI,Arial,sans-serif;font-size:12.5px}"
        css = css $ "body[data-theme='shadcn_dark']{--bg:#09090b;--surface:#0f0f12;--panel:#111113;--line:#27272a;--line2:#3f3f46;--text:#fafafa;--muted:#a1a1aa;--soft:#1f1f23;--accent:#38bdf8;--accent-soft:rgba(56,189,248,.12);--ok:#00d084}"
        css = css $ "body{margin:0;background:var(--bg);color:var(--text);font-weight:500}.pc-shell{min-height:100vh;padding:18px;background:radial-gradient(circle at top right,var(--accent-soft),transparent 34%),var(--bg)}.pc-stack{display:flex;flex-direction:column;gap:14px;max-width:1280px}.pc-card{border:1px solid var(--line);border-radius:var(--radius);background:color-mix(in srgb,var(--panel) 96%,var(--surface));overflow:hidden;box-shadow:0 14px 42px rgba(0,0,0,.08)}.pc-card-title{display:flex;align-items:center;justify-content:space-between;min-height:44px;padding:0 16px;border-bottom:1px solid var(--line);font-weight:760}.pc-card-body{padding:14px}.pc-text{display:block;color:var(--muted);line-height:1.5}"
        css = css $ ".pc-toolbar,.pc-tabs{display:inline-flex;align-items:center;gap:0;width:max-content;max-width:100%;border:1px solid var(--line);border-radius:var(--pill);background:color-mix(in srgb,var(--panel) 92%,var(--soft));padding:3px;overflow:hidden}.pc-btn,.pc-tab{height:31px;border:0;background:transparent;color:var(--text);padding:0 13px;font-size:12.5px;font-weight:720;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;line-height:1}.pc-btn:hover,.pc-btn.active,.pc-tab.active{background:var(--accent-soft);color:var(--accent)}.pc-btn:first-child,.pc-tab:first-child{border-top-left-radius:var(--pill);border-bottom-left-radius:var(--pill)}.pc-btn:last-child,.pc-tab:last-child{border-top-right-radius:var(--pill);border-bottom-right-radius:var(--pill)}"
        css = css $ ".pc-badge{display:inline-flex;align-items:center;gap:6px;height:23px;border:1px solid var(--line);border-radius:var(--pill);padding:0 9px;background:var(--surface);font-size:11.5px;font-weight:650}.pc-badge.done:before{content:' ';width:6px;height:6px;border-radius:999px;background:var(--ok);box-shadow:0 0 0 2px color-mix(in srgb,var(--ok) 18%,transparent)}.pc-badge.busy:before{content:' ';width:7px;height:7px;border-radius:999px;border:1px dashed var(--muted)}"
        css = css $ ".pc-table-wrap{overflow:auto;border:1px solid var(--line);border-radius:var(--radius);background:var(--panel)}.pc-table{width:100%;border-collapse:separate;border-spacing:0;min-width:740px}.pc-table th,.pc-table td{height:46px;border-bottom:1px solid var(--line);padding:0 12px;text-align:left;white-space:nowrap}.pc-table th{background:var(--soft);font-weight:760}.pc-table tr:last-child td{border-bottom:0}.pc-table tbody tr:hover td,.pc-table tr:hover td{background:color-mix(in srgb,var(--soft) 50%,transparent)}.pc-table .pc-btn{height:27px}"
        css = css $ ".pc-status{position:fixed;right:14px;bottom:14px;border:1px solid var(--line2);border-radius:var(--pill);background:color-mix(in srgb,var(--panel) 96%,var(--surface));color:var(--muted);padding:8px 12px;font-size:12px;box-shadow:0 18px 60px rgba(0,0,0,.28);z-index:1000}.pc-flash{outline:2px solid var(--accent);outline-offset:2px}"
        css = css $ "</style>"
        return (css)
    }

    func:Script(self) {
        js = "<script>"
        js = js $ "function pcStatus(t){var e=document.getElementById('pc_status');if(e)e.textContent=t}"
        js = js $ "function pcEvent(n,id){pcStatus('event: '+n+' / '+id);var b=document.getElementById(id);if(b){b.classList.add('active');b.classList.add('pc-flash');setTimeout(function(){b.classList.remove('active');b.classList.remove('pc-flash')},260)}return tobaEvent(n,id)}"
        js = js $ "function pcTabEvent(b,n){var p=b.parentNode;if(p){var xs=p.querySelectorAll('.pc-tab');for(var i=0;i<xs.length;i++)xs[i].classList.remove('active')}b.classList.add('active');pcEvent(n,b.id)}"
        js = js $ "</script>"
        return (js)
    }

    func:Render(self) {
        html = "<!doctype html><html><head><meta charset='utf-8'><title>" $ desktopui::EscapeHtml(self.title) $ "</title>" $ self.Styles() $ desktopui::Script() $ self.Script() $ "</head><body data-theme='" $ desktopui::EscapeHtml(self.theme) $ "'><div class='pc-shell'>" $ self.body $ "</div><div id='pc_status' class='pc-status'>ready</div></body></html>"
        return (html)
    }

    func:Show(self) {
        win = desktopui::ShowBrowser(self.Render(), 1)
        desktopui::SetWindow(win, 1100, 720, 100, 70)
        desktopui::Wait()
        return (win)
    }
}

obj:WebToolbar() {
    self.prefix = "<div class='pc-toolbar'>"
    self.body = " "
    self.suffix = "</div>"

    func:Button(self, id, text, eventName) {
        self.body = self.body $ "<button id='" $ desktopui::EscapeHtml(id) $ "' class='pc-btn' onclick=\"pcEvent('" $ desktopui::EscapeJs(eventName) $ "',this.id)\">" $ desktopui::EscapeHtml(text) $ "</button>"
        return (self)
    }

    func:Badge(self, id, text, variant) {
        self.body = self.body $ "<span id='" $ desktopui::EscapeHtml(id) $ "' class='pc-badge " $ desktopui::EscapeHtml(variant) $ "'>" $ desktopui::EscapeHtml(text) $ "</span>"
        return (self)
    }

    func:Render(self) {
        return ("<div class='pc-toolbar'>" $ self.body $ "</div>")
    }
}

obj:WebTabs() {
    self.prefix = "<div class='pc-tabs'>"
    self.body = " "
    self.suffix = "</div>"

    func:Tab(self, id, text, eventName, active) {
        cls = "pc-tab"
        if (active == 1) {
            cls = "pc-tab active"
        }
        self.body = self.body $ "<button id='" $ desktopui::EscapeHtml(id) $ "' class='" $ cls $ "' onclick=\"pcTabEvent(this,'" $ desktopui::EscapeJs(eventName) $ "')\">" $ desktopui::EscapeHtml(text) $ "</button>"
        return (self)
    }

    func:Render(self) {
        return ("<div class='pc-tabs'>" $ self.body $ "</div>")
    }
}

obj:WebCard() {
    self.id = "card"
    self.title = "Card"
    self.prefix = "<section id='card' class='pc-card'><div class='pc-card-title'>Card</div><div class='pc-card-body'>"
    self.body = " "
    self.suffix = "</div></section>"

    func:Setup(self, id, title) {
        self.id = id
        self.title = title
        self.prefix = "<section id='" $ desktopui::EscapeHtml(id) $ "' class='pc-card'><div class='pc-card-title'>" $ desktopui::EscapeHtml(title) $ "</div><div class='pc-card-body'>"
        return (self)
    }

    func:AddWidget(self, widget) {
        self.body = self.body $ widget.prefix $ widget.body $ widget.suffix
        return (self)
    }

    func:Text(self, id, text) {
        self.body = self.body $ "<span id='" $ desktopui::EscapeHtml(id) $ "' class='pc-text'>" $ desktopui::EscapeHtml(text) $ "</span>"
        return (self)
    }

    func:Render(self) {
        html = "<section id='" $ desktopui::EscapeHtml(self.id) $ "' class='pc-card'><div class='pc-card-title'>" $ desktopui::EscapeHtml(self.title) $ "</div><div class='pc-card-body'>" $ self.body $ "</div></section>"
        return (html)
    }
}

obj:WebTable() {
    self.prefix = "<div class='pc-table-wrap'><table class='pc-table'>"
    self.body = " "
    self.suffix = "</table></div>"

    func:HeaderRow(self, c1, c2, c3, c4) {
        self.body = self.body $ "<tr><th>" $ desktopui::EscapeHtml(c1) $ "</th><th>" $ desktopui::EscapeHtml(c2) $ "</th><th>" $ desktopui::EscapeHtml(c3) $ "</th><th>" $ desktopui::EscapeHtml(c4) $ "</th></tr>"
        return (self)
    }

    func:RowBadge(self, c1, badgeText, badgeKind, c3, actionEvent) {
        badge = "<span class='pc-badge " $ desktopui::EscapeHtml(badgeKind) $ "'>" $ desktopui::EscapeHtml(badgeText) $ "</span>"
        bid = "act_" $ desktopui::EscapeHtml(actionEvent)
        self.body = self.body $ "<tr><td><strong>" $ desktopui::EscapeHtml(c1) $ "</strong></td><td>" $ badge $ "</td><td>" $ desktopui::EscapeHtml(c3) $ "</td><td><button id='" $ bid $ "' class='pc-btn' onclick=\"pcEvent('" $ desktopui::EscapeJs(actionEvent) $ "',this.id)\">Actions</button></td></tr>"
        return (self)
    }

    func:Render(self) {
        return ("<div class='pc-table-wrap'><table class='pc-table'>" $ self.body $ "</table></div>")
    }
}
