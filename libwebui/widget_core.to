func: IsDigit(charValue) {
    res = 0
    if (charValue == "0") { res = 1 }
    if (charValue == "1") { res = 1 }
    if (charValue == "2") { res = 1 }
    if (charValue == "3") { res = 1 }
    if (charValue == "4") { res = 1 }
    if (charValue == "5") { res = 1 }
    if (charValue == "6") { res = 1 }
    if (charValue == "7") { res = 1 }
    if (charValue == "8") { res = 1 }
    if (charValue == "9") { res = 1 }
    return (res)
}

func: IsIdent(charValue) {
    res = 0
    if (IsAlpha(charValue) == 1) { res = 1 }
    if (IsDigit(charValue) == 1) { res = 1 }
    return (res)
}

func: IsTobaControl(word) {
    res = 0
    if (word == "if") { res = 1 }
    if (word == "else") { res = 1 }
    if (word == "for") { res = 1 }
    if (word == "foreach") { res = 1 }
    if (word == "loop") { res = 1 }
    if (word == "break") { res = 1 }
    if (word == "continue") { res = 1 }
    if (word == "return") { res = 1 }
    return (res)
}

func: IsTobaDecl(word) {
    res = 0
    if (word == "func") { res = 1 }
    if (word == "obj") { res = 1 }
    if (word == "enum") { res = 1 }
    if (word == "import") { res = 1 }
    return (res)
}

