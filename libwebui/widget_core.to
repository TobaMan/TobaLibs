import : libwebui / desktopui

func: TextOrEmpty(value) {
    res = ""
    if (isstr(value)) {
        res = value
    }
    else {
        if (isnum(value)) {
            res = strnum(value)
        }
    }
    return (res)
}

func: DateDay(value) {
    s = TextOrEmpty(value)
    res = "26"
    if (size(s) >= 10) {
        res = slice(s, 8, 10)
    }
    return (res)
}

func: DateMonth(value) {
    s = TextOrEmpty(value)
    res = "06"
    if (size(s) >= 10) {
        res = slice(s, 5, 7)
    }
    return (res)
}

func: DateYear(value) {
    s = TextOrEmpty(value)
    res = "2026"
    if (size(s) >= 10) {
        res = slice(s, 0, 4)
    }
    return (res)
}

func: DateDisplay(value) {
    res = DateDay(value) $ "/" $ DateMonth(value) $ "/" $ DateYear(value)
    return (res)
}

func: MonthName(mm) {
    res = "Juin"
    if (mm == "01") { res = "Janvier" }
    if (mm == "02") { res = "Fevrier" }
    if (mm == "03") { res = "Mars" }
    if (mm == "04") { res = "Avril" }
    if (mm == "05") { res = "Mai" }
    if (mm == "06") { res = "Juin" }
    if (mm == "07") { res = "Juillet" }
    if (mm == "08") { res = "Aout" }
    if (mm == "09") { res = "Septembre" }
    if (mm == "10") { res = "Octobre" }
    if (mm == "11") { res = "Novembre" }
    if (mm == "12") { res = "Decembre" }
    return (res)
}

func: Pad2(n) {
    res = strnum(n)
    if (n < 10) {
        res = "0" $ res
    }
    return (res)
}

func: PopoverToggleJs() {
    js = "(function(btn){if(!window.__lwPopOutside){window.__lwPopOutside=1;document.addEventListener('pointerdown',function(e){if(e.target.closest&&e.target.closest('.lw-pop-wrap'))return;var all=document.querySelectorAll('.lw-pop-wrap.open');for(var i=0;i<all.length;i++)all[i].classList.remove('open','drop-up','align-right')},true)}var w=btn.closest('.lw-pop-wrap');if(!w)return;var was=w.classList.contains('open');var all=document.querySelectorAll('.lw-pop-wrap.open');for(var i=0;i<all.length;i++){if(all[i]!==w)all[i].classList.remove('open','drop-up','align-right')}if(was){w.classList.remove('open','drop-up','align-right');return}w.classList.add('open');w.classList.remove('drop-up','align-right');var p=w.querySelector('.lw-pop-panel');if(!p)return;var b=btn.getBoundingClientRect();var r=p.getBoundingClientRect();var vw=window.innerWidth||document.documentElement.clientWidth;var vh=window.innerHeight||document.documentElement.clientHeight;var ct=8,cb=vh-8,el=w.parentElement;while(el&&el!==document.body){var cs=getComputedStyle(el);if(/auto|scroll|hidden/.test(cs.overflow+cs.overflowY)){var er=el.getBoundingClientRect();if(er.height>20){ct=Math.max(ct,er.top+8);cb=Math.min(cb,er.bottom-8)}}el=el.parentElement}var below=cb-b.bottom-8;var above=b.top-ct-8;if((below<r.height&&above>below)||w.getAttribute('data-popover')=='up')w.classList.add('drop-up');if(b.left+r.width>vw-8)w.classList.add('align-right')})(this)"
    return (js)
}

func: MonthStepJs(id, delta) {
    eid = desktopui::EscapeJs(id)
    js = "var names=['Janvier','Fevrier','Mars','Avril','Mai','Juin','Juillet','Aout','Septembre','Octobre','Novembre','Decembre'];var w=document.getElementById('" $ eid $ "_wrap');var m=Number(w.getAttribute('data-month')||'1')+" $ strnum(delta) $ ";if(m<1)m=12;if(m>12)m=1;w.setAttribute('data-month',(m<10?'0':String())+m);document.getElementById('" $ eid $ "_month_title').textContent=names[m-1]"
    return (js)
}

func: ColorApplyInlineJs(id, eventName, valueExpr, source) {
    eid = desktopui::EscapeJs(id)
    ev = desktopui::EscapeJs(eventName)
    src = desktopui::EscapeJs(source)
    js = "(function(v){var id='" $ eid $ "';var r=document.getElementById(id+'_wrap');if(!r)return;var p=document.getElementById(id+'_preview');var b=document.getElementById(id+'_big');var d=document.getElementById(id+'_display');var h=document.getElementById(id+'_hex');if(p)p.style.setProperty('--picked',v);if(b)b.style.setProperty('--picked',v);if(d)d.textContent=v;if(h)h.value=v;var xs=r.querySelectorAll('.lw-color-chip');for(var j=0;j<xs.length;j++)xs[j].classList.toggle('current',(xs[j].getAttribute('data-color')||String()).toLowerCase()==String(v).toLowerCase());webuiEvent('" $ ev $ "',{id:id,value:v,source:'" $ src $ "'})})(" $ valueExpr $ ")"
    return (js)
}

func: ColorPlaneJs(id, eventName) {
    eid = desktopui::EscapeJs(id)
    ev = desktopui::EscapeJs(eventName)
    js = "(function(e){var id='" $ eid $ "';var r=document.getElementById(id+'_wrap');if(!r)return;var rect=e.currentTarget.getBoundingClientRect();var clamp=function(v,a,b){return Math.max(a,Math.min(b,v))};var s=clamp((e.clientX-rect.left)/rect.width,0,1);var val=clamp(1-((e.clientY-rect.top)/rect.height),0,1);var hue=Number(r.getAttribute('data-hue')||170);r.setAttribute('data-sat',s);r.setAttribute('data-val',val);var t=r.querySelector('.lw-color-target');if(t){t.style.left=(s*100)+'%';t.style.top=((1-val)*100)+'%'}var hsv=function(h,s,v){var f=function(n){var k=(n+h/60)%6;return v-v*s*Math.max(Math.min(k,4-k,1),0)};var to=function(x){return Math.round(x*255).toString(16).padStart(2,'0')};return '#'+to(f(5))+to(f(3))+to(f(1))};var hex=hsv(hue,s,val);var p=document.getElementById(id+'_preview');var b=document.getElementById(id+'_big');var d=document.getElementById(id+'_display');var h=document.getElementById(id+'_hex');if(p)p.style.setProperty('--picked',hex);if(b)b.style.setProperty('--picked',hex);if(d)d.textContent=hex;if(h)h.value=hex;webuiEvent('" $ ev $ "',{id:id,value:hex,source:'plane'})})(event)"
    return (js)
}

func: ColorHueJs(id, eventName) {
    eid = desktopui::EscapeJs(id)
    ev = desktopui::EscapeJs(eventName)
    js = "(function(e){var id='" $ eid $ "';var r=document.getElementById(id+'_wrap');if(!r)return;var rect=e.currentTarget.getBoundingClientRect();var clamp=function(v,a,b){return Math.max(a,Math.min(b,v))};var hue=Math.round(clamp((e.clientX-rect.left)/rect.width,0,1)*360);r.setAttribute('data-hue',hue);var plane=r.querySelector('.lw-color-plane');if(plane)plane.style.setProperty('--hue',hue);var marker=r.querySelector('.lw-hue-marker');if(marker)marker.style.left=(hue/360*100)+'%';var s=Number(r.getAttribute('data-sat')||.76);var val=Number(r.getAttribute('data-val')||.82);var hsv=function(h,s,v){var f=function(n){var k=(n+h/60)%6;return v-v*s*Math.max(Math.min(k,4-k,1),0)};var to=function(x){return Math.round(x*255).toString(16).padStart(2,'0')};return '#'+to(f(5))+to(f(3))+to(f(1))};var hex=hsv(hue,s,val);var p=document.getElementById(id+'_preview');var b=document.getElementById(id+'_big');var d=document.getElementById(id+'_display');var h=document.getElementById(id+'_hex');if(p)p.style.setProperty('--picked',hex);if(b)b.style.setProperty('--picked',hex);if(d)d.textContent=hex;if(h)h.value=hex;webuiEvent('" $ ev $ "',{id:id,value:hex,source:'hue'})})(event)"
    return (js)
}

func: MediaUrl(value) {
    s = TextOrEmpty(value)
    res = s
    embedded = 0
    b64Path = s $ ".b64"
    if (size(s) > 0) {
        if (fstype(b64Path) == 1) {
            b64 = fsreadf(b64Path)
            if (isstr(b64)) {
                b64 = freplace(b64, "\n", "")
                b64 = freplace(b64, "\r", "")
                res = "data:video/mp4;base64," $ b64
                embedded = 1
            }
        }
    }
    if ((embedded == 0) && (size(s) > 2)) {
        if (slice(s, 1, 2) == ":") {
            res = freplace(s, "\\", "/")
            res = "file:///" $ res
        }
    }
    return (res)
}

func: DisableHtml(html) {
    res = html
    res = freplace(res, "class='lw-x-widget", "class='lw-x-widget lw-disabled")
    res = freplace(res, "class='lw-popup-widget", "class='lw-popup-widget lw-disabled")
    res = freplace(res, "class='ui-card gallery-video-player", "class='ui-card gallery-video-player lw-disabled")
    res = freplace(res, "class='ui-card lw-audio-player", "class='ui-card lw-audio-player lw-disabled")
    res = freplace(res, "class='ui-card lw-image-card", "class='ui-card lw-image-card lw-disabled")
    res = freplace(res, "class='ui-card lw-gallery-card", "class='ui-card lw-gallery-card lw-disabled")
    res = freplace(res, "class='ui-card lw-carousel-card", "class='ui-card lw-carousel-card lw-disabled")
    res = freplace(res, "class='ui-card gallery-chart-card", "class='ui-card gallery-chart-card lw-disabled")
    res = freplace(res, "class='lw-code-widget", "class='lw-code-widget lw-disabled")
    res = freplace(res, "class='lw-monaco-widget", "class='lw-monaco-widget lw-disabled")
    res = freplace(res, "class='lw-rich-widget", "class='lw-rich-widget lw-disabled")
    return (res)
}

func: CodeLangClass(lang) {
    s = TextOrEmpty(lang)
    res = "language-text"
    if (s == "toba") { res = "language-toba" }
    if (s == "js") { res = "language-js" }
    if (s == "javascript") { res = "language-js" }
    if (s == "html") { res = "language-html" }
    if (s == "css") { res = "language-css" }
    if (s == "json") { res = "language-json" }
    if (s == "text") { res = "language-text" }
    return (res)
}

func: CodeHighlightJs() {
    js = "<script data-libwebui-code='1'>"
    js = js $ "window.lwCodeEsc=function(s){return String(s).split('&').join('&amp;').split('<').join('&lt;').split('>').join('&gt;')};"
    js = js $ "window.lwCodePaint=function(code,lang){var s=lwCodeEsc(code);var kw=String();if(lang=='toba'){kw='func|obj|self|return|if|else|loop|for|break|import|main|print|sleep|isstr|isnum|size|strnum|slice'}else if(lang=='js'){kw='function|var|let|const|return|if|else|for|while|class|new|this|window|document'}else if(lang=='css'){kw='display|grid|flex|color|background|border|padding|margin|height|width|position'}else if(lang=='json'){kw='true|false|null'}if(kw.length>0){var re=new RegExp('\\\\b('+kw+')\\\\b','g');s=s.replace(re,'<span class=\"lw-code-kw\">$1</span>')}s=s.replace(/(&quot;[^&]*?&quot;|'[^']*?'|\"[^\"]*?\")/g,'<span class=\"lw-code-str\">$1</span>');s=s.replace(/(\\/\\/[^\\n]*)/g,'<span class=\"lw-code-com\">$1</span>');s=s.replace(/(# [^\\n]*)/g,'<span class=\"lw-code-com\">$1</span>');return s};"
    js = js $ "window.lwCodeInit=function(){var xs=document.querySelectorAll('.lw-code-src');for(var i=0;i<xs.length;i++){var x=xs[i];if(x.getAttribute('data-painted'))continue;var raw=x.textContent||String();var lang=x.getAttribute('data-lang')||'text';x.innerHTML=lwCodePaint(raw,lang);x.setAttribute('data-painted','1')}};if(document.readyState=='loading'){document.addEventListener('DOMContentLoaded',lwCodeInit)}else{setTimeout(lwCodeInit,0)};"
    js = js $ "</script>"
    return (js)
}

func: CodeSpan(cls, text) {
    res = "<span class='" $ cls $ "'>" $ desktopui::EscapeHtml(text) $ "</span>"
    return (res)
}

