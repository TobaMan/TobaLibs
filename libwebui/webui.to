import : libwebui / desktopui
import : libwebui / widgets
import : libwebui / widget_core
import : libwebui / runtime
import : libjson / json

func: __module_ready() {
    return (1)
}

func: EventName(raw) {
    res = json::GetString(raw, "name", "")
    return (res)
}

func: EventData(raw) {
    res = json::GetRaw(raw, "data", "{}")
    return (res)
}

func: EventValue(raw) {
    data = EventData(raw)
    res = json::GetString(data, "value", "")
    return (res)
}

func: EventAction(raw) {
    data = EventData(raw)
    res = json::GetString(data, "action", "")
    if (size(res) == 0) {
        res = EventValue(raw)
    }
    return (res)
}

func: HandleNativeWindowEventHandle(raw, handle) {
    handled = 0
    name = EventName(raw)
    if (name == "native_window_action") {
        action = EventAction(raw)
        if (size(action) > 0) {
            if (handle != 0) {
                desktopui::NativeWindowActionHandle(handle, action)
                handled = 1
            }
        }
    }
    return (handled)
}

func: HandleNativeWindowEvent(raw, title) {
    handled = 0
    name = EventName(raw)
    if (name == "native_window_action") {
        action = EventAction(raw)
        if (size(action) > 0) {
            desktopui::NativeWindowAction(title, action)
            handled = 1
        }
    }
    return (handled)
}

// Backend WebView2 (https://github.com/webview/webview) : ecrit le HTML deja
// genere (avec bridge) dans un fichier et lance webview_host.exe en frameless.
// Remplace l'affichage via webui-2.dll uniquement pour le mode custom chrome.
// runproc est un builtin : aucun import supplementaire (le compilateur Toba
// plante si on ajoute des imports/modules ici).
func: ShowWebViewHost(html, title, width, height, x, y) {
    path = "C:/Toba/modules/libwebui/webview_host_page.html"
    fswritef(path, html)
    cmd = "\"C:/Toba/modules/libwebui/webview_host.exe\""
    cmd = cmd $ " --html=\"" $ path $ "\""
    cmd = cmd $ " --title=\"" $ title $ "\""
    cmd = cmd $ " --width=" $ strnum(width)
    cmd = cmd $ " --height=" $ strnum(height)
    cmd = cmd $ " --x=" $ strnum(x)
    cmd = cmd $ " --y=" $ strnum(y)
    cmd = cmd $ " --frameless=1 --debug=0"
    // RunDetached (DLL toba_window_bridge) lance le host sans pipes stdout/stderr
    // et rend la main tout de suite. runproc bloquerait : il attend le flux de
    // sortie du process GUI persistant -> la boucle BridgePoll ne tournerait pas.
    desktopui::RunDetached(cmd)
    return (1)
}

// Generateur commun d'un slider theme (.gallery-slider-card). L'oninput met a
// jour la valeur affichee EN LIVE (le bug d'origine) puis appelle funcName si
// fourni. unit = suffixe affiche (ex " px", "" ...).
func: SliderHtml(id, label, value, minValue, maxValue, step, funcName, valueId, unit) {
    safeId = desktopui::EscapeHtml(id)
    safeVal = desktopui::EscapeHtml(valueId)
    safeUnit = desktopui::EscapeJs(unit)
    call = ""
    if (size(funcName) > 0) {
        call = desktopui::EscapeHtml(funcName) $ "(this.value);"
    }
    oninput = call $ "var s=document.getElementById('" $ desktopui::EscapeJs(valueId) $ "');if(s)s.textContent=this.value+'" $ safeUnit $ "'"
    res = "<div class='gallery-slider-card'><label for='" $ safeId $ "'>" $ desktopui::EscapeHtml(label) $ "</label>"
    res = res $ "<input id='" $ safeId $ "' type='range' min='" $ strnum(minValue) $ "' max='" $ strnum(maxValue) $ "' step='" $ strnum(step) $ "' value='" $ strnum(value) $ "' oninput=\"" $ oninput $ "\">"
    res = res $ "<span id='" $ safeVal $ "' class='gallery-slider-value'>" $ strnum(value) $ desktopui::EscapeHtml(unit) $ "</span></div>"
    return (res)
}

// Slider compact loge dans un pill (widgets::PillField) : label + range + valeur
// sur une seule ligne. Plusieurs pills s'alignent en flex (rangee compacte).
func: SliderPillHtml(id, label, value, minValue, maxValue, step, funcName, valueId) {
    safeId = desktopui::EscapeHtml(id)
    call = ""
    if (size(funcName) > 0) {
        call = desktopui::EscapeHtml(funcName) $ "(this.value);"
    }
    oninput = call $ "var s=document.getElementById('" $ desktopui::EscapeJs(valueId) $ "');if(s)s.textContent=this.value"
    res = "<div class='lw-pill-field lw-pill-slider'><span class='lw-pill-label'>" $ desktopui::EscapeHtml(label) $ "</span><span class='lw-pill-sep'></span>"
    res = res $ "<input id='" $ safeId $ "' class='lw-pill-range' type='range' min='" $ strnum(minValue) $ "' max='" $ strnum(maxValue) $ "' step='" $ strnum(step) $ "' value='" $ strnum(value) $ "' oninput=\"" $ oninput $ "\">"
    res = res $ "<span id='" $ desktopui::EscapeHtml(valueId) $ "' class='lw-pill-rangeval'>" $ strnum(value) $ "</span></div>"
    return (res)
}

obj:Page() {
    self.title = "Toba WebUI Component Gallery"
    self.footer = "libwebui component gallery"
    self.port = 19165
    self.width = 1240
    self.height = 820
    self.x = 90
    self.y = 60
    self.windowMode = "normal"
    self.customChrome = 1
    self.nativeHandle = 0
    self.layout = widgets::DesktopLayout()
    self.layout.SetTitle(self.title)
    self.layout.SetFooter(self.footer)
    self.layout.AddThemeSelector()
    self.layout.AddActionMenu()

    func:SetTitle(self, title) {
        self.title = title
        self.layout.SetTitle(title)
        return (self)
    }

    func:SetFooter(self, footer) {
        self.footer = footer
        self.layout.SetFooter(footer)
        return (self)
    }

    func:SetPort(self, port) {
        self.port = port
        return (self)
    }

    func:SetWindow(self, width, height, x, y) {
        self.width = width
        self.height = height
        self.x = x
        self.y = y
        self.windowMode = "normal"
        return (self)
    }

    func:SetSize(self, width, height) {
        self.width = width
        self.height = height
        self.windowMode = "normal"
        return (self)
    }

    func:SetPosition(self, x, y) {
        self.x = x
        self.y = y
        return (self)
    }

    func:Normal(self) {
        self.windowMode = "normal"
        return (self)
    }

    func:Maximized(self) {
        self.windowMode = "maximized"
        self.width = 1480
        self.height = 900
        self.x = 20
        self.y = 20
        return (self)
    }

    func:CustomChrome(self) {
        self.customChrome = 1
        return (self)
    }

    func:NativeChrome(self) {
        self.customChrome = 0
        return (self)
    }

    func:NativeHandle(self) {
        return (self.nativeHandle)
    }

    func:AddPanel(self, panel) {
        self.layout.AddHtmlPanel(panel.id, panel.title, panel.value, panel.note, panel.body)
        return (self)
    }

    func:Render(self) {
        modal = "<div id='gallery_modal' class='gallery-modal-backdrop' onclick='if(event.target==this)webuiModal(0)'><div class='gallery-modal'><div class='gallery-modal-head'><div><div class='gallery-modal-title'>Custom popup</div><div class='gallery-modal-sub'>Compatibilite webuiModal(1)</div></div><button type='button' class='gallery-modal-close' onclick='webuiModal(0)'>x</button></div><div class='gallery-modal-body'><div>This modal is rendered by libwebui styles and can contain any Toba-generated widget.</div><div class='lw-actions right'><button type='button' class='ui-btn' onclick=\"webuiEvent('popup_cancel');webuiModal(0)\">Cancel</button><button type='button' class='ui-btn primary' onclick=\"webuiEvent('popup_confirm');webuiModal(0)\"><span data-icon='save'></span>Confirm</button></div></div></div></div>"
        toast = "<div id='gallery_toast_root' class='gallery-toast-root'></div>"
        bodyClass = " "
        titlebar = " "
        if (self.customChrome == 1) {
            bodyClass = " class='lw-native-chrome'"
            titlebar = widgets::WindowTitleBar(self.title, "T")
        }
        html = "<!doctype html><html><head><meta charset='utf-8'><title>" $ desktopui::EscapeHtml(self.title) $ "</title>" $ widgets::Styles() $ runtime::ProStyles() $ runtime::Styles() $ widget_core::RichTextScript(" ") $ "</head><body data-theme='light_modern'" $ bodyClass $ ">" $ titlebar $ self.layout.Render() $ modal $ toast $ runtime::Script() $ "</body></html>"
        html = desktopui::WithBridge(html, self.port)
        return (html)
    }

    func:Show(self) {
        selectedPort = desktopui::BridgeStartReliable(self.port, 40)
        if (selectedPort != 0) {
            self.port = selectedPort
        }
        bridgeInit = selectedPort
        print("bridge init=")
        print(bridgeInit)
        print(" error=")
        print(desktopui::BridgeLastError())
        print("\n")
        html = self.Render()
        fswritef("C:/Toba/modules/libwebui/examples/webui_components_gallery_debug.html", html)
        if (self.customChrome == 1) {
            ShowWebViewHost(html, self.title, self.width, self.height, self.x, self.y)
            win = 0
        }
        else {
            win = desktopui::ShowBrowser(html, 1)
            desktopui::SetWindow(win, self.width, self.height, self.x, self.y)
        }
        return (win)
    }

    func:ShowReliable(self, debugPath) {
        selectedPort = desktopui::BridgeStartReliable(self.port, 40)
        if (selectedPort != 0) {
            self.port = selectedPort
        }
        bridgeInit = selectedPort
        print("bridge init=")
        print(bridgeInit)
        print(" error=")
        print(desktopui::BridgeLastError())
        print("\n")
        html = self.Render()
        if (size(debugPath) > 0) {
            fswritef(debugPath, html)
        }
        if (self.customChrome == 1) {
            ShowWebViewHost(html, self.title, self.width, self.height, self.x, self.y)
            win = 0
        }
        else {
            win = desktopui::ShowBrowser(html, 1)
            desktopui::SetWindow(win, self.width, self.height, self.x, self.y)
        }
        return (win)
    }

    func:Run(self) {
        self.Show()
        print("TOBA WEBUI COMPONENT GALLERY STARTED\n")
        print("This gallery is assembled with Toba widget objects.\n")
        done = 0
        loop {
            if (done == 1) {
                break
            }
            evt = desktopui::BridgePoll(50)
            if (size(evt) > 0) {
                HandleNativeWindowEvent(evt, self.title)
                name = EventName(evt)
                // Fermeture de la fenetre -> on sort et on libere le port bridge,
                // sinon le process Toba reste vivant et bloque le port (Bind failed).
                if (name == "window_closed") {
                    done = 1
                }
                print("component event = ")
                print(evt)
                print("\n")
            }
            sleep(0.05)
        }
        desktopui::BridgeStop()
        print("GALLERY CLOSED, bridge stopped\n")
        return (1)
    }
}

obj:Panel() {
    self.id = "panel"
    self.title = "Panel"
    self.value = "demo"
    self.note = " "
    self.body = "<div class='ui-pro'>"
    self.closed = 0

    func:Setup(self, id, title, value, note) {
        self.id = id
        self.title = title
        self.value = value
        self.note = note
        return (self)
    }

    func:Fill(self) {
        if (self.body == "<div class='ui-pro'>") {
            self.body = "<div class='ui-pro lw-fill-panel'>"
        }
        return (self)
    }

    func:Add(self, widget) {
        self.body = self.body $ widget.html
        return (self)
    }

    func:AddHtml(self, html) {
        self.body = self.body $ html
        return (self)
    }

    func:AddText(self, text) {
        self.body = self.body $ "<div class='gallery-note'>" $ desktopui::EscapeHtml(text) $ "</div>"
        return (self)
    }

    func:Close(self) {
        if (self.closed == 0) {
            self.body = self.body $ "</div>"
            self.closed = 1
        }
        return (self)
    }
}

// Panneau lateral retractable 100% genere par Toba. Le repli utilise un
// checkbox HTML + CSS : aucun JavaScript n'est requis pour la structure UI.
obj:SidePanel() {
    self.id = "side_panel"
    self.title = "Configuration"
    self.side = "right"
    self.width = 360
    self.main_html = " "
    self.body = " "
    self.html = " "

    func:Setup(self, id, title, side, width) {
        self.id = id
        self.title = title
        self.side = side
        self.width = width
        return (self)
    }

    func:AddMainHtml(self, html) {
        self.main_html = self.main_html $ html
        return (self)
    }

    func:AddHtml(self, html) {
        self.body = self.body $ html
        return (self)
    }

    func:Add(self, widget) {
        self.body = self.body $ widget.html
        return (self)
    }

    func:Close(self) {
        eid = desktopui::EscapeHtml(self.id)
        title = desktopui::EscapeHtml(self.title)
        cls = "lw-side-panel lw-side-right"
        if (self.side == "left") {
            cls = "lw-side-panel lw-side-left"
        }
        css = "<style>.lw-side-panel{--lw-side-width:" $ strnum(self.width) $ "px;display:grid;grid-template-columns:minmax(0,1fr) var(--lw-side-width);gap:12px;width:100%;height:clamp(720px,calc(100vh - 185px),980px);min-height:720px;position:relative}.lw-side-panel.lw-side-left{grid-template-columns:var(--lw-side-width) minmax(0,1fr)}.lw-side-toggle{position:absolute;opacity:0;pointer-events:none}.lw-side-main{min-width:0;min-height:0;height:100%;overflow:hidden}.lw-side-drawer{min-width:0;min-height:0;height:100%;border:1px solid var(--border);border-radius:var(--lw-radius);background:var(--bg-card);display:grid;grid-template-rows:auto minmax(0,1fr);overflow:hidden}.lw-side-head{height:42px;display:flex;align-items:center;gap:8px;padding:0 10px;border-bottom:1px solid var(--border);font-weight:800;color:var(--text-1);cursor:pointer}.lw-side-head:before{content:'›';width:22px;height:22px;display:grid;place-items:center;border:1px solid var(--border);border-radius:var(--lw-radius);color:var(--accent)}.lw-side-body{min-height:0;overflow:auto;padding:12px}.lw-side-toggle:checked~.lw-side-main{grid-column:auto}.lw-side-toggle:checked~.lw-side-drawer{width:42px}.lw-side-toggle:checked~.lw-side-drawer .lw-side-title,.lw-side-toggle:checked~.lw-side-drawer .lw-side-body{display:none}.lw-side-toggle:checked~.lw-side-drawer .lw-side-head{padding:0 9px}.lw-side-toggle:checked~.lw-side-drawer .lw-side-head:before{content:'‹'}.lw-side-panel:has(.lw-side-toggle:checked){grid-template-columns:minmax(0,1fr) 42px}.lw-side-panel.lw-side-left:has(.lw-side-toggle:checked){grid-template-columns:42px minmax(0,1fr)}.lw-side-left .lw-side-drawer{grid-column:1;grid-row:1}.lw-side-left .lw-side-main{grid-column:2;grid-row:1}</style>"
        toggle = "<input class='lw-side-toggle' type='checkbox' id='" $ eid $ "_toggle'>"
        center_html = "<div class='lw-side-main'>" $ self.main_html $ "</div>"
        drawer = "<aside class='lw-side-drawer'><label class='lw-side-head' for='" $ eid $ "_toggle'><span class='lw-side-title'>" $ title $ "</span></label><div class='lw-side-body'>" $ self.body $ "</div></aside>"
        self.html = css $ "<div id='" $ eid $ "' class='" $ cls $ "'>" $ toggle $ center_html $ drawer $ "</div>"
        return (self)
    }
}

obj:Stats() {
    self.html = "<div class='ui-grid'>"
    self.closed = 0

    func:Add(self, label, value, note) {
        self.html = self.html $ "<div class='ui-stat'><div class='ui-stat-label'>" $ desktopui::EscapeHtml(label) $ "</div><div class='ui-stat-value'>" $ desktopui::EscapeHtml(value) $ "</div><div class='ui-stat-note'>" $ desktopui::EscapeHtml(note) $ "</div></div>"
        return (self)
    }

    func:Close(self) {
        if (self.closed == 0) {
            self.html = self.html $ "</div>"
            self.closed = 1
        }
        return (self)
    }
}

obj:CardGrid() {
    self.html = "<div class='gallery-grid'>"
    self.closed = 0

    func:AddCard(self, title, sub, text) {
        self.html = self.html $ "<section class='ui-card'><div class='ui-card-head'><div class='ui-card-title'>" $ desktopui::EscapeHtml(title) $ "</div><div class='ui-card-sub'>" $ desktopui::EscapeHtml(sub) $ "</div></div><div class='ui-card-body'><div class='gallery-note'>" $ desktopui::EscapeHtml(text) $ "</div></div></section>"
        return (self)
    }

    // Carte avec un corps HTML additionnel (widgets deja rendus) SOUS le texte.
    // bodyHtml n'est PAS echappe : on y met du HTML de widgets libwebui.
    func:AddCardHtml(self, title, sub, text, bodyHtml) {
        self.html = self.html $ "<section class='ui-card'><div class='ui-card-head'><div class='ui-card-title'>" $ desktopui::EscapeHtml(title) $ "</div><div class='ui-card-sub'>" $ desktopui::EscapeHtml(sub) $ "</div></div><div class='ui-card-body'><div class='gallery-note'>" $ desktopui::EscapeHtml(text) $ "</div>" $ bodyHtml $ "</div></section>"
        return (self)
    }

    // Meme carte mais avec une (ou plusieurs) classe(s) d'effet appliquee(s).
    // ex: cards.AddCardFx("Tilt", "hover", "...", "lwfx-tilt lwfx-spotlight")
    // title n'est pas echappe pour permettre du HTML d'effet (ex: GradientText).
    func:AddCardFx(self, title, sub, text, effect) {
        cls = "ui-card"
        if (size(effect) > 0) {
            cls = cls $ " " $ effect
        }
        self.html = self.html $ "<section class='" $ desktopui::EscapeHtml(cls) $ "'><div class='ui-card-head'><div class='ui-card-title'>" $ title $ "</div><div class='ui-card-sub'>" $ desktopui::EscapeHtml(sub) $ "</div></div><div class='ui-card-body'><div class='gallery-note'>" $ desktopui::EscapeHtml(text) $ "</div></div></section>"
        return (self)
    }

    // Carte NEUTRE (pas d'effet sur la carte elle-meme) contenant 2-3 boutons
    // colores, chacun portant sa propre classe d'effet (ex: materiau RTX). Sert
    // a comparer plusieurs variantes d'effet cote a cote dans une seule carte.
    // buttons = tuple de tuples (label, eventName, effectClass, kind).
    func:AddCardButtons(self, title, sub, text, buttons) {
        btnsHtml = "<div class='lw-cell-actions' style='margin-top:10px'>"
        i = for (0, size(buttons), 1) {
            b = buttons[i]
            cls = "ui-btn " $ desktopui::EscapeHtml(b[3]) $ " " $ desktopui::EscapeHtml(b[2])
            btnsHtml = btnsHtml $ "<button type='button' class='" $ cls $ "' onclick=\"webuiEvent('" $ desktopui::EscapeJs(b[1]) $ "')\">" $ desktopui::EscapeHtml(b[0]) $ "</button>"
        }
        btnsHtml = btnsHtml $ "</div>"
        self.html = self.html $ "<section class='ui-card'><div class='ui-card-head'><div class='ui-card-title'>" $ desktopui::EscapeHtml(title) $ "</div><div class='ui-card-sub'>" $ desktopui::EscapeHtml(sub) $ "</div></div><div class='ui-card-body'><div class='gallery-note'>" $ desktopui::EscapeHtml(text) $ "</div>" $ btnsHtml $ "</div></section>"
        return (self)
    }

    func:Close(self) {
        if (self.closed == 0) {
            self.html = self.html $ "</div>"
            self.closed = 1
        }
        return (self)
    }
}

// Scene d'objets colores : un vrai widget conteneur. Chaque objet (AddObject)
// est une forme coloree pleine, distincte, disposee proche des autres -> concu
// pour visualiser l'eclairage/raytracing (reflets, refraction, emission) entre
// objets. Chaque objet porte un id stable pour piloter son etat/materiau.
obj:Scene() {
    self.html = "<div class='lw-scene'>"
    self.closed = 0

    // color = couleur CSS de l'objet (ex "#ef4444"). shape = "square"|"circle".
    // material = materiau RTX par defaut ("diffuse"|"emissive"|"mirror"|"glass"|
    // "glossy") pose en data-rtx-material -> rendu correct des le demarrage.
    func:AddObject(self, id, title, color, shape, material) {
        cls = "lw-scene-obj"
        if (shape == "circle") {
            cls = "lw-scene-obj lw-scene-circle"
        }
        mat = ""
        if (size(material) > 0) {
            if (material != " ") {
                mat = " data-rtx-material='" $ desktopui::EscapeHtml(material) $ "'"
            }
        }
        self.html = self.html $ "<div class='" $ cls $ "' id='" $ desktopui::EscapeHtml(id) $ "'" $ mat $ " style='background:" $ desktopui::EscapeHtml(color) $ "'><span class='lw-scene-label'>" $ desktopui::EscapeHtml(title) $ "</span></div>"
        return (self)
    }

    func:Close(self) {
        if (self.closed == 0) {
            self.html = self.html $ "</div>"
            self.closed = 1
        }
        return (self)
    }

    // Script de drag LIBRE : chaque objet devient deplacable a la souris dans la
    // scene (position absolue). Apres deplacement, rappelle gcRefresh() pour que
    // l'overlay (radiance/rtx) suive la nouvelle position. A inclure une fois.
    func:Script(self) {
        js = "<script>"
        js = js $ "(function(){if(window.__lwSceneDragReady)return;window.__lwSceneDragReady=1;"
        js = js $ "document.querySelectorAll('.lw-scene').forEach(function(scene){"
        js = js $ "scene.querySelectorAll('.lw-scene-obj').forEach(function(obj){"
        js = js $ "obj.addEventListener('pointerdown',function(e){e.preventDefault();var sr=scene.getBoundingClientRect();var or=obj.getBoundingClientRect();"
        js = js $ "obj.style.position='absolute';obj.style.margin='0';obj.style.left=(or.left-sr.left)+'px';obj.style.top=(or.top-sr.top)+'px';"
        js = js $ "obj.classList.add('lw-dragging');obj.setPointerCapture(e.pointerId);"
        js = js $ "var ox=e.clientX-or.left,oy=e.clientY-or.top;"
        js = js $ "function move(ev){var x=ev.clientX-sr.left-ox,y=ev.clientY-sr.top-oy;x=Math.max(0,Math.min(x,scene.clientWidth-obj.offsetWidth));y=Math.max(0,Math.min(y,scene.clientHeight-obj.offsetHeight));obj.style.left=x+'px';obj.style.top=y+'px';if(window.gcRefresh)gcRefresh()}"
        js = js $ "function up(ev){obj.classList.remove('lw-dragging');obj.releasePointerCapture(e.pointerId);obj.removeEventListener('pointermove',move);obj.removeEventListener('pointerup',up);if(window.gcRefresh)gcRefresh();if(window.webuiEvent)webuiEvent('scene_object_moved',{id:obj.id})}"
        js = js $ "obj.addEventListener('pointermove',move);obj.addEventListener('pointerup',up)})})});"
        js = js $ "})();"
        js = js $ "</script>"
        return (js)
    }
}

// Toolbar VERTICALE generique et INDEPENDANTE (aucun lien avec un effet).
// Colonne de boutons a icone + label. Chaque bouton emet son event au clic et
// porte data-vtb-value (payload optionnel). Reutilisable partout.
//   vt = webui::VToolbar()
//   vt.Setup("mon_id", "Titre")
//   vt.AddButton("b1", "Bouton", "plus", "vtb_click", "button")
//   vt.Close()  -> vt.html
obj:VToolbar() {
    self.id = "vtoolbar"
    self.title = " "
    self.items = " "
    self.closed = 0
    self.html = " "

    func:Setup(self, id, title) {
        self.id = id
        self.title = title
        return (self)
    }

    // label = texte sous l'icone, icon = data-icon libwebui, eventName = event
    // emis au clic, value = payload optionnel (data-vtb-value).
    func:AddButton(self, id, label, icon, eventName, value) {
        val = ""
        if (size(value) > 0) {
            if (value != " ") {
                val = " data-vtb-value='" $ desktopui::EscapeHtml(value) $ "'"
            }
        }
        js = "webuiEvent('" $ desktopui::EscapeJs(eventName) $ "',{id:'" $ desktopui::EscapeJs(id) $ "',value:this.getAttribute('data-vtb-value')||String()})"
        self.items = self.items $ "<button type='button' class='lw-vtb-btn' id='" $ desktopui::EscapeHtml(id) $ "'" $ val $ " onclick=\"" $ js $ "\"><span data-icon='" $ desktopui::EscapeHtml(icon) $ "'></span><span class='lw-vtb-lbl'>" $ desktopui::EscapeHtml(label) $ "</span></button>"
        return (self)
    }

    func:Close(self) {
        head = ""
        if (size(self.title) > 0) {
            if (self.title != " ") {
                head = "<div class='lw-vtb-title'>" $ desktopui::EscapeHtml(self.title) $ "</div>"
            }
        }
        self.html = "<div class='lw-vtb' id='" $ desktopui::EscapeHtml(self.id) $ "'>" $ head $ self.items $ "</div>"
        return (self)
    }
}

// Script partage de l'editeur : definit les helpers globaux JS, INDEPENDANTS.
//   lwMakeDraggable(el, page, grid) : rend un element deplacable (snap grid).
//   lwMakeResizable(el, handle, grid) : redimensionne via une poignee.
// A injecter UNE fois dans la page (SceneEditor le fait).
func: EditorScript() {
    js = "<script>"
    js = js $ "(function(){if(window.__lwEditorReady)return;window.__lwEditorReady=1;"
    // Draggable generique : el se deplace dans page, snap a grid. Ignore les
    // clics sur controles interactifs et la poignee de resize.
    js = js $ "window.lwMakeDraggable=function(el,page,grid){grid=grid||1;el.addEventListener('pointerdown',function(e){if(e.target.closest('button,select,input,a,textarea,.lw-resize,.lw-rtx'))return;e.preventDefault();if(el.__lwOnPick)el.__lwOnPick(el);var r=el.getBoundingClientRect(),pr=page.getBoundingClientRect();var ox=e.clientX-r.left,oy=e.clientY-r.top;el.classList.add('lw-dragging');el.setPointerCapture(e.pointerId);function mv(ev){var x=Math.round((ev.clientX-pr.left-ox)/grid)*grid;var y=Math.round((ev.clientY-pr.top-oy)/grid)*grid;x=Math.max(0,Math.min(x,page.clientWidth-el.offsetWidth));y=Math.max(0,Math.min(y,page.clientHeight-el.offsetHeight));el.style.left=x+'px';el.style.top=y+'px';if(el.__lwOnChange)el.__lwOnChange(el)}function up(){el.classList.remove('lw-dragging');el.releasePointerCapture(e.pointerId);el.removeEventListener('pointermove',mv);el.removeEventListener('pointerup',up);if(el.__lwOnChange)el.__lwOnChange(el)}el.addEventListener('pointermove',mv);el.addEventListener('pointerup',up)})};"
    // Resizable generique : la poignee redimensionne el (snap grid, mini 60x40).
    js = js $ "window.lwMakeResizable=function(el,handle,grid){grid=grid||1;handle.addEventListener('pointerdown',function(e){e.preventDefault();e.stopPropagation();if(el.__lwOnPick)el.__lwOnPick(el);var sx=e.clientX,sy=e.clientY,sw=el.offsetWidth,sh=el.offsetHeight;handle.setPointerCapture(e.pointerId);function mv(ev){var w=Math.max(60,Math.round((sw+ev.clientX-sx)/grid)*grid);var h=Math.max(40,Math.round((sh+ev.clientY-sy)/grid)*grid);el.style.width=w+'px';el.style.height=h+'px';if(el.__lwOnChange)el.__lwOnChange(el)}function up(){handle.releasePointerCapture(e.pointerId);handle.removeEventListener('pointermove',mv);handle.removeEventListener('pointerup',up);if(el.__lwOnChange)el.__lwOnChange(el)}handle.addEventListener('pointermove',mv);handle.addEventListener('pointerup',up)})};"
    js = js $ "})();"
    js = js $ "</script>"
    return (js)
}

// Styles partages editeur (grille magnetique, items, poignee). Injecte une fois.
func: EditorStyles() {
    css = "<style>"
    css = css $ ".lw-editor{position:relative;display:flex;gap:12px;align-items:stretch}"
    css = css $ ".lw-editor-page{position:relative;flex:1;background:var(--bg-surface);background-image:linear-gradient(var(--border) 1px,transparent 1px),linear-gradient(90deg,var(--border) 1px,transparent 1px);background-size:24px 24px;border:1px solid var(--border);border-radius:var(--lw-radius);min-height:560px;overflow:hidden}"
    css = css $ ".lw-eitem{position:absolute;box-sizing:border-box;cursor:grab;user-select:none;touch-action:none;min-width:120px;min-height:70px;width:180px;height:110px;border-radius:var(--lw-radius);background:#3b82f6;box-shadow:0 6px 20px rgba(0,0,0,.18);overflow:hidden}"
    // Seul le CONTENU widget (1er enfant) remplit l'item et prend la transparence.
    // Le menu/bouton-menu/poignee sont exclus (pas etires, pas transparents).
    css = css $ ".lw-eitem>:first-child{display:block;box-sizing:border-box;width:100%;height:100%;margin:0!important;opacity:var(--lw-tr,.75)}"
    css = css $ ".lw-eitem .ui-card,.lw-eitem section{display:flex!important;flex-direction:column;width:100%;height:100%;background:color-mix(in srgb,var(--bg-card) 75%,transparent)!important;border:0!important;border-radius:var(--lw-radius)!important;box-shadow:none!important;overflow:hidden}"
    css = css $ ".lw-eitem .ui-card-body{flex:1}.lw-eitem .ui-btn{width:100%;height:100%;justify-content:center;border-radius:var(--lw-radius)}"
    css = css $ ".lw-eitem.lw-dragging{cursor:grabbing;z-index:5;opacity:.92}.lw-eitem.lw-esel{outline:3px solid var(--accent);outline-offset:3px}"
    // Surbrillance d'un SOUS-COMPOSANT .lw-rtx selectionne (dans un widget compose).
    css = css $ ".lw-rtx.lw-esel{outline:2px solid var(--accent);outline-offset:2px;z-index:7}"
    css = css $ ".lw-resize{position:absolute;right:0;bottom:0;width:20px;height:20px;cursor:nwse-resize;z-index:4}.lw-resize:after{content:' ';position:absolute;right:4px;bottom:4px;width:10px;height:10px;border-right:2px solid rgba(255,255,255,.9);border-bottom:2px solid rgba(255,255,255,.9)}"
    // Bouton menu contextuel (coin haut-droit de l'item) + son dropdown.
    css = css $ ".lw-emenu-btn{position:absolute;top:5px;right:5px;width:24px;height:24px;z-index:6;display:flex;align-items:center;justify-content:center;border:0;border-radius:var(--lw-radius);background:rgba(0,0,0,.28);color:#fff;cursor:pointer;opacity:0;transition:opacity .12s;font-size:16px;line-height:1}.lw-eitem:hover .lw-emenu-btn,.lw-eitem.lw-esel .lw-emenu-btn{opacity:1}.lw-emenu-btn:hover{background:rgba(0,0,0,.45)}"
    // Menu en position:fixed -> echappe a l'overflow:hidden de l'item (sinon
    // clippe). Positionne en JS pres du bouton. Opaque (pas dans le flux .75).
    css = css $ ".lw-emenu{position:fixed;z-index:2000;min-width:160px;display:none;flex-direction:column;padding:4px;border:1px solid var(--border);border-radius:var(--lw-radius);background:var(--bg-card);box-shadow:0 14px 40px rgba(0,0,0,.35)}.lw-emenu.open{display:flex}.lw-emenu button{height:34px;border:0;border-radius:var(--lw-radius);background:transparent;color:var(--text-1);text-align:left;padding:0 12px;font-size:12.5px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:8px}.lw-emenu button:hover{background:var(--bg-hover);color:var(--accent)}.lw-emenu button.lw-emenu-del:hover{color:var(--error)}"
    css = css $ "</style>"
    return (css)
}

// SceneEditor : editeur de scene MAGNETIQUE reutilisable. Grille + toolbar
// verticale (VToolbar) + items draggables/resizables. Les items sont scannables
// par un moteur d'effet externe (RTX/radiance) via la classe .lw-eitem.
//   ed = webui::SceneEditor()
//   ed.Setup("mon_editeur")
//   ed.AddTemplate("card", cardHtml)   // types de widgets insertables
//   ed.AddToolButton("card", "Carte", "copy")
//   ed.Close()  -> ed.html (contient grille + toolbar + script)
obj:SceneEditor() {
    self.id = "scene_editor"
    self.templates = " "
    self.vtb = VToolbar()
    self.html = " "
    self.closed = 0

    func:Setup(self, id) {
        self.id = id
        self.vtb.Setup(id $ "_tb", "Widgets")
        return (self)
    }

    // Declare un type de widget insertable : type = cle, html = template.
    func:AddTemplate(self, type, html) {
        self.templates = self.templates $ "<template id='" $ desktopui::EscapeHtml(self.id) $ "_tpl_" $ desktopui::EscapeHtml(type) $ "'>" $ html $ "</template>"
        return (self)
    }

    // Ajoute un bouton dans la toolbar qui insere le widget de ce type.
    func:AddToolButton(self, type, label, icon) {
        self.vtb.AddButton(self.id $ "_add_" $ type, label, icon, self.id $ "_add", type)
        return (self)
    }

    func:Close(self) {
        self.vtb.Close()
        eid = desktopui::EscapeHtml(self.id)
        ejs = desktopui::EscapeJs(self.id)
        // Grille + toolbar. Les templates caches. Script d'init specifique.
        page = "<div class='lw-editor-page' id='" $ eid $ "_page'></div>"
        tpls = "<div style='display:none'>" $ self.templates $ "</div>"
        // UN SEUL menu contextuel partage (pas un par item). Avec icones.
        menu = "<div class='lw-emenu' id='" $ eid $ "_menu'>"
        menu = menu $ "<button type='button' data-act='front'><span data-icon='maximize'></span>Avancer</button>"
        menu = menu $ "<button type='button' data-act='back'><span data-icon='copy'></span>Reculer</button>"
        menu = menu $ "<button type='button' class='lw-emenu-del' data-act='del'><span data-icon='trash'></span>Supprimer</button>"
        menu = menu $ "</div>"
        wrap = "<div class='lw-editor' id='" $ eid $ "'>" $ page $ self.vtb.html $ menu $ "</div>"
        // Script d'init : ecoute l'event <id>_add pour inserer un widget, gere
        // selection + expose l'API window.<id> (pick, add, page) pour l'effet.
        s = "<script>"
        s = s $ "(function(){var ED='" $ ejs $ "';function init(){var page=document.getElementById(ED+'_page');if(!page||page.__lwReady)return;page.__lwReady=1;"
        s = s $ "var api=window[ED]={page:page,sel:null,onScan:null,items:function(){return page.querySelectorAll('.lw-eitem')}};"
        s = s $ "var pal=['#ef4444','#3b82f6','#22c55e','#f59e0b','#a855f7','#14b8a6','#ec4899'];var N=0;"
        s = s $ "api.pick=function(el){if(api.sel)api.sel.classList.remove('lw-esel');api.sel=el;if(el)el.classList.add('lw-esel');if(api.onPick)api.onPick(el)};"
        s = s $ "api.add=function(type,color){var tpl=document.getElementById(ED+'_tpl_'+type);if(!tpl)return null;var it=document.createElement('div');it.className='lw-eitem';it.appendChild(tpl.content.cloneNode(true));var hd=document.createElement('div');hd.className='lw-resize';it.appendChild(hd);"
        // Bouton menu contextuel -> ouvre le menu PARTAGE (un seul dans le DOM).
        s = s $ "var mb=document.createElement('button');mb.type='button';mb.className='lw-emenu-btn';mb.innerHTML='&#8942;';it.appendChild(mb);"
        s = s $ "mb.addEventListener('pointerdown',function(e){e.stopPropagation()});mb.addEventListener('click',function(e){e.stopPropagation();api.pick(it);api.openMenu(it,mb)});"
        // Clic sur un SOUS-COMPOSANT .lw-rtx interne -> le selectionne (pour regler
        // ses caracteristiques). Sinon selectionne l'item (conteneur). Le drag
        // reste sur l'item (lwMakeDraggable pose __lwOnPick sur pointerdown).
        s = s $ "it.addEventListener('click',function(e){var sub=e.target.closest('.lw-rtx,.lw-sdf');if(sub&&it.contains(sub)){e.stopPropagation();api.pick(sub)}else{api.pick(it)}});"
        s = s $ "var n=N++;it.style.background=color||pal[n%pal.length];it.style.left=(40+((n%4)*30))+'px';it.style.top=(40+((n%4)*30))+'px';it.__lwOnPick=api.pick;it.__lwOnChange=function(){if(api.onScan)api.onScan()};page.appendChild(it);if(window.galleryRenderIcons)galleryRenderIcons(it);window.lwMakeDraggable(it,page,24);window.lwMakeResizable(it,hd,24);api.pick(it);if(api.onScan)api.onScan();return it};"
        s = s $ "api.reindex=function(){var it=api.items();for(var i=0;i<it.length;i++)it[i].style.zIndex=String(2+i);if(api.onScan)api.onScan()};"
        // Actions sur un item (utilisees par le menu contextuel + l'exterieur).
        s = s $ "api.remove=function(el){el=el||api.sel;if(!el)return;if(api.sel===el)api.sel=null;el.remove();if(api.onScan)api.onScan()};"
        s = s $ "api.toFront=function(el){el=el||api.sel;if(el){page.appendChild(el);api.reindex()}};"
        s = s $ "api.toBack=function(el){el=el||api.sel;if(el&&page.firstElementChild!==el){page.insertBefore(el,page.firstElementChild);api.reindex()}};"
        // Menu contextuel PARTAGE : un seul, positionne, memorise l'item cible.
        s = s $ "var menu=document.getElementById(ED+'_menu');api.menuTarget=null;if(menu&&window.galleryRenderIcons)galleryRenderIcons(menu);"
        s = s $ "api.openMenu=function(it,btn){api.menuTarget=it;var r=btn.getBoundingClientRect();menu.style.top=(r.bottom+4)+'px';menu.style.left=Math.min(r.right-160,window.innerWidth-170)+'px';menu.classList.add('open')};"
        s = s $ "if(menu){menu.addEventListener('pointerdown',function(e){e.stopPropagation()});menu.addEventListener('click',function(e){var a=e.target.closest('[data-act]');if(!a)return;e.stopPropagation();menu.classList.remove('open');var t=api.menuTarget;a=a.getAttribute('data-act');if(a==='front')api.toFront(t);else if(a==='back')api.toBack(t);else if(a==='del')api.remove(t)});}"
        s = s $ "document.addEventListener('click',function(ev){if(menu&&!ev.target.closest('.lw-emenu,.lw-emenu-btn'))menu.classList.remove('open')});"
        s = s $ "window.addEventListener('toba:event',function(e){var d=e.detail||{};if(d.name===ED+'_add'){var t=(d.data&&d.data.value)||String();if(t)api.add(t)}});"
        s = s $ "}"
        s = s $ "if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',init)}else{init()}window.addEventListener('toba:event',function(e){var d=e.detail||{};if(d.name&&d.name.indexOf('show_')===0){setTimeout(init,100)}});"
        s = s $ "})();"
        s = s $ "</script>"
        self.html = EditorStyles() $ EditorScript() $ tpls $ wrap $ s
        return (self)
    }
}

obj:Toolbar() {
    self.html = "<div class='ui-toolbar'>"
    self.closed = 0

    func:Right(self) {
        if (self.html == "<div class='ui-toolbar'>") {
            self.html = "<div class='ui-toolbar right'>"
        }
        return (self)
    }

    func:Button(self, id, text, icon, eventName, kind) {
        cls = "ui-btn " $ desktopui::EscapeHtml(kind)
        self.html = self.html $ "<button id='" $ desktopui::EscapeHtml(id) $ "' type='button' class='" $ cls $ "' onclick=\"webuiEvent('" $ desktopui::EscapeJs(eventName) $ "',{id:this.id,label:'" $ desktopui::EscapeJs(text) $ "'})\"><span data-icon='" $ desktopui::EscapeHtml(icon) $ "'></span>" $ desktopui::EscapeHtml(text) $ "</button>"
        return (self)
    }

    func:IconButton(self, id, icon, eventName) {
        self.html = self.html $ "<button id='" $ desktopui::EscapeHtml(id) $ "' type='button' class='ui-btn ui-icon-btn ghost' onclick=\"webuiEvent('" $ desktopui::EscapeJs(eventName) $ "',{id:this.id,icon:'" $ desktopui::EscapeJs(icon) $ "'})\"><span data-icon='" $ desktopui::EscapeHtml(icon) $ "'></span></button>"
        return (self)
    }

    func:Separator(self) {
        self.html = self.html $ "<span class='ui-sep'></span>"
        return (self)
    }

    func:Close(self) {
        if (self.closed == 0) {
            self.html = self.html $ "</div>"
            self.closed = 1
        }
        return (self)
    }
}

obj:Dropdown() {
    self.html = " "
    self.items = " "
    self.id = "dropdown"
    self.label = "Options"

    func:Setup(self, id, label) {
        self.id = id
        self.label = label
        return (self)
    }

    func:Option(self, text, eventName, active) {
        cls = "ui-option"
        if (active == 1) {
            cls = "ui-option active"
        }
        self.items = self.items $ "<button type='button' class='" $ cls $ "' onclick=\"webuiEvent('" $ desktopui::EscapeJs(eventName) $ "',{id:'" $ desktopui::EscapeJs(self.id) $ "',value:'" $ desktopui::EscapeJs(text) $ "',label:'" $ desktopui::EscapeJs(text) $ "'})\">" $ desktopui::EscapeHtml(text) $ "</button>"
        return (self)
    }

    func:Close(self) {
        self.html = "<div id='" $ desktopui::EscapeHtml(self.id) $ "' class='tm-dropdown ui-dropdown webui-dropdown'><button type='button' class='ui-btn' onclick='tmDrop(this)'>" $ desktopui::EscapeHtml(self.label) $ "</button><div class='ui-dropdown-menu tm-drop-menu'>" $ self.items $ "</div></div>"
        return (self)
    }
}

obj:Fields() {
    self.html = "<div class='gallery-stack'>"
    self.closed = 0

    func:PillInput(self, id, label, value, eventName) {
        js = "webuiEvent('" $ desktopui::EscapeJs(eventName) $ "',{id:this.id,value:this.value})"
        self.html = self.html $ widgets::PillInput(id, label, value, js)
        return (self)
    }

    func:PillSelect(self, id, label, options, eventName) {
        opts = " "
        i = for (0, size(options), 1) {
            opt = desktopui::EscapeHtml(options[i])
            opts = opts $ "<option value='" $ opt $ "'>" $ opt $ "</option>"
        }
        js = "webuiEvent('" $ desktopui::EscapeJs(eventName) $ "',{id:this.id,value:this.value})"
        self.html = self.html $ widgets::PillSelect(id, label, opts, js)
        return (self)
    }

    func:FilePicker(self, id, label, value, accept, eventName) {
        self.html = self.html $ widgets::FilePicker(id, label, value, accept, eventName)
        return (self)
    }

    func:Slider(self, id, label, value, minValue, maxValue, funcName, valueId) {
        self.html = self.html $ SliderHtml(id, label, value, minValue, maxValue, 1, funcName, valueId, " px")
        return (self)
    }

    // Slider generique : step + unite reglables. funcName peut etre "" (alors
    // seul l'affichage de la valeur est mis a jour, pas d'appel JS).
    func:SliderUnit(self, id, label, value, minValue, maxValue, step, funcName, valueId, unit) {
        self.html = self.html $ SliderHtml(id, label, value, minValue, maxValue, step, funcName, valueId, unit)
        return (self)
    }

    // Slider COMPACT en pill (label + range + valeur inline). S'aligne en flex
    // (mets plusieurs SliderPill dans un .gallery-row pour une barre compacte).
    func:SliderPill(self, id, label, value, minValue, maxValue, step, funcName, valueId) {
        self.html = self.html $ SliderPillHtml(id, label, value, minValue, maxValue, step, funcName, valueId)
        return (self)
    }

    func:EventLog(self) {
        self.html = self.html $ "<div id='gallery_event_log' class='gallery-code gallery-event-log'>No event yet.</div>"
        return (self)
    }

    func:Close(self) {
        if (self.closed == 0) {
            self.html = self.html $ "</div>"
            self.closed = 1
        }
        return (self)
    }
}

obj:Tabs() {
    self.html = "<div class='gallery-tabs'>"
    self.closed = 0

    func:Tab(self, id, text, count, active) {
        cls = "gallery-tab"
        if (active == 1) {
            cls = "gallery-tab active"
        }
        badge = " "
        if (size(count) > 0) {
            if (count != " ") {
                badge = "<span class='gallery-count'>" $ desktopui::EscapeHtml(count) $ "</span>"
            }
        }
        self.html = self.html $ "<button type='button' class='" $ cls $ "' data-table-tab='" $ desktopui::EscapeHtml(id) $ "' onclick=\"webuiEvent('table_tab_" $ desktopui::EscapeJs(id) $ "')\"><span>" $ desktopui::EscapeHtml(text) $ "</span>" $ badge $ "</button>"
        return (self)
    }

    func:TabCount(self, id, text, count, active) {
        cls = "gallery-tab"
        if (active == 1) {
            cls = "gallery-tab active"
        }
        badge = " "
        if (size(count) > 0) {
            badge = "<span class='gallery-count'>" $ desktopui::EscapeHtml(count) $ "</span>"
        }
        self.html = self.html $ "<button type='button' class='" $ cls $ "' data-table-tab='" $ desktopui::EscapeHtml(id) $ "' onclick=\"webuiEvent('table_tab_" $ desktopui::EscapeJs(id) $ "')\"><span>" $ desktopui::EscapeHtml(text) $ "</span>" $ badge $ "</button>"
        return (self)
    }

    func:Close(self) {
        if (self.closed == 0) {
            self.html = self.html $ "</div>"
            self.closed = 1
        }
        return (self)
    }
}

obj:TabView() {
    self.tabs = "<div class='gallery-tabs'>"
    self.panels = " "
    self.html = " "
    self.closed = 0

    func:Add(self, id, text, count, active, widget) {
        cls = "gallery-tab"
        panelCls = "gallery-tab-panel"
        if (active == 1) {
            cls = "gallery-tab active"
            panelCls = "gallery-tab-panel active"
        }
        badge = " "
        if (size(count) > 0) {
            if (count != " ") {
                badge = "<span class='gallery-count'>" $ desktopui::EscapeHtml(count) $ "</span>"
            }
        }
        self.tabs = self.tabs $ "<button type='button' class='" $ cls $ "' data-tab='" $ desktopui::EscapeHtml(id) $ "' onclick=\"galleryTab('" $ desktopui::EscapeJs(id) $ "',this)\"><span>" $ desktopui::EscapeHtml(text) $ "</span>" $ badge $ "</button>"
        self.panels = self.panels $ "<div id='tab_" $ desktopui::EscapeHtml(id) $ "' class='" $ panelCls $ "'>" $ widget.html $ "</div>"
        return (self)
    }

    func:AddHtml(self, id, text, count, active, html) {
        cls = "gallery-tab"
        panelCls = "gallery-tab-panel"
        if (active == 1) {
            cls = "gallery-tab active"
            panelCls = "gallery-tab-panel active"
        }
        badge = " "
        if (size(count) > 0) {
            if (count != " ") {
                badge = "<span class='gallery-count'>" $ desktopui::EscapeHtml(count) $ "</span>"
            }
        }
        self.tabs = self.tabs $ "<button type='button' class='" $ cls $ "' data-tab='" $ desktopui::EscapeHtml(id) $ "' onclick=\"galleryTab('" $ desktopui::EscapeJs(id) $ "',this)\"><span>" $ desktopui::EscapeHtml(text) $ "</span>" $ badge $ "</button>"
        self.panels = self.panels $ "<div id='tab_" $ desktopui::EscapeHtml(id) $ "' class='" $ panelCls $ "'>" $ html $ "</div>"
        return (self)
    }

    func:Close(self) {
        if (self.closed == 0) {
            self.html = "<div class='gallery-tabview ui-pro'>" $ self.tabs $ "</div><div class='gallery-tab-panels gallery-stack'>" $ self.panels $ "</div></div>"
            self.closed = 1
        }
        return (self)
    }
}

obj:Table() {
    self.html = " "
    self.rows = " "

    func:AddSection(self, header, sectionType, status, statusKind, target, limit, reviewer, eventName) {
        review = desktopui::EscapeHtml(reviewer)
        if (reviewer == "Assign reviewer") {
            review = "<div class='tm-dropdown gallery-reviewer'><button type='button' class='ui-btn' onclick='tmDrop(this)'>Assign reviewer</button><div class='ui-dropdown-menu tm-drop-menu'><button type='button' class='ui-option' onclick=\"webuiEvent('assign_eddie')\">Eddie Lake</button><button type='button' class='ui-option' onclick=\"webuiEvent('assign_jamik')\">Jamik Tashpulatov</button><button type='button' class='ui-option' onclick=\"webuiEvent('assign_marie')\">Marie Curie</button></div></div>"
        }
        actions = "<div class='tm-dropdown gallery-row-menu'><button type='button' class='ui-btn ui-icon-btn' onclick='tmDrop(this)' title='Row actions'><span data-icon='settings'></span></button><div class='ui-dropdown-menu tm-drop-menu'><button type='button' class='ui-option' onclick=\"webuiEvent('" $ desktopui::EscapeJs(eventName) $ "_open')\">Open</button><button type='button' class='ui-option' onclick=\"webuiEvent('" $ desktopui::EscapeJs(eventName) $ "_duplicate')\">Duplicate</button><button type='button' class='ui-option' onclick=\"webuiToast('Table','Row action sent to Toba')\">Notify</button></div></div>"
        self.rows = self.rows $ "<tr><td><span class='gallery-grip'>::</span></td><td><input class='gallery-check gallery-row-check' type='checkbox' onchange=\"webuiEvent('table_select')\"></td><td><span class='gallery-table-title'>" $ desktopui::EscapeHtml(header) $ "</span></td><td><span class='gallery-badge'>" $ desktopui::EscapeHtml(sectionType) $ "</span></td><td><span class='gallery-badge " $ desktopui::EscapeHtml(statusKind) $ "'>" $ desktopui::EscapeHtml(status) $ "</span></td><td><strong>" $ desktopui::EscapeHtml(target) $ "</strong></td><td><strong>" $ desktopui::EscapeHtml(limit) $ "</strong></td><td>" $ review $ "</td><td><div class='lw-cell-actions'>" $ actions $ "</div></td></tr>"
        return (self)
    }

    func:Close(self) {
        self.html = "<div class='gallery-table-card'><div class='gallery-table-scroll'><table class='gallery-table'><thead><tr><th></th><th><input class='gallery-check' type='checkbox' onchange=\"webuiEvent('table_select_all')\"></th><th>Header</th><th>Section Type</th><th>Status</th><th>Target</th><th>Limit</th><th>Reviewer</th><th></th></tr></thead><tbody>" $ self.rows $ "</tbody></table></div></div>"
        return (self)
    }
}

// Tableau GENERIQUE : colonnes libres, cellules = widgets deja rendus (badges,
// boutons, avatars...). Reutilise la classe .gallery-table -> style au theme +
// drag des lignes (galleryTableDragInit) gratuits. Les cellules ne sont PAS
// re-echappees : on y met du HTML de widgets construits via les helpers ci-dessous.
obj:GridTable() {
    self.html = " "
    self.rows = " "
    self.head = " "

    // cols = tuple d'intitules de colonnes (texte simple, echappe).
    func:SetColumns(self, cols) {
        th = "<th class='gallery-grip-head'></th>"
        i = for (0, size(cols), 1) {
            th = th $ "<th>" $ desktopui::EscapeHtml(cols[i]) $ "</th>"
        }
        self.head = th
        return (self)
    }

    // cells = tuple de cellules DEJA rendues (HTML de widgets, non re-echappe).
    // La premiere colonne recoit la poignee de drag ::.
    func:AddRow(self, cells) {
        tds = "<td><span class='gallery-grip'>::</span></td>"
        i = for (0, size(cells), 1) {
            tds = tds $ "<td>" $ cells[i] $ "</td>"
        }
        self.rows = self.rows $ "<tr>" $ tds $ "</tr>"
        return (self)
    }

    func:Close(self) {
        self.html = "<div class='gallery-table-card'><div class='gallery-table-scroll'><table class='gallery-table'><thead><tr>" $ self.head $ "</tr></thead><tbody>" $ self.rows $ "</tbody></table></div></div>"
        return (self)
    }
}

// --- Helpers de cellule (widgets imbriquables dans GridTable) ---------------

// Badge de statut plein, au theme. kind = "" | "done" | "busy" | "danger".
func:Badge(text, kind) {
    cls = "gallery-badge"
    if (size(kind) > 1) {
        cls = "gallery-badge " $ desktopui::EscapeHtml(kind)
    }
    return ("<span class='" $ cls $ "'>" $ desktopui::EscapeHtml(text) $ "</span>")
}

// Bouton d'action qui emet un event bridge. kind = "" | "primary" | "danger".
func:ActionBtn(text, kind, eventName) {
    cls = "ui-btn"
    if (size(kind) > 1) {
        cls = "ui-btn " $ desktopui::EscapeHtml(kind)
    }
    return ("<button type='button' class='" $ cls $ "' onclick=\"webuiEvent('" $ desktopui::EscapeJs(eventName) $ "')\">" $ desktopui::EscapeHtml(text) $ "</button>")
}

// Avatar (initiale) + nom, en ligne. initial = 1-2 caracteres (ex "EL").
func:Avatar(initial, name) {
    return ("<span class='gallery-avatar-cell'><span class='gallery-avatar'>" $ desktopui::EscapeHtml(initial) $ "</span><span class='gallery-avatar-name'>" $ desktopui::EscapeHtml(name) $ "</span></span>")
}

// Vignette minimale : image carree arrondie nue (pas de titre/caption). source =
// URL/data-uri ou " " (fond uni). size = cote en px. rtxMat = materiau RTX
// optionnel (" " = aucun) -> ajoute .lw-rtx + data-rtx-material pour le raytracer.
func:Thumbnail(id, source, sz, rtxMat) {
    px = strnum(sz)
    rtx = ""
    if (size(rtxMat) > 1) {
        rtx = " lw-rtx' data-rtx-material='" $ desktopui::EscapeHtml(rtxMat)
    }
    style = "width:" $ px $ "px;height:" $ px $ "px"
    inner = ""
    if (size(source) > 1) {
        inner = "<img class='lw-thumb-img' src='" $ desktopui::EscapeHtml(source) $ "' alt=''>"
    }
    return ("<div class='lw-thumb" $ rtx $ "' id='" $ desktopui::EscapeHtml(id) $ "' style='" $ style $ "'>" $ inner $ "</div>")
}

// Bouton ROND a icone. icon = data-icon libwebui (play, chevronLeft...). kind =
// "primary"/" " (accent ou neutre). size = diametre px. rtxMat = materiau RTX
// optionnel. eventName = event emis au clic (" " = aucun).
func:IconButton(id, icon, kind, sz, eventName, rtxMat) {
    px = strnum(sz)
    cls = "lw-iconbtn"
    if (kind == "primary") {
        cls = "lw-iconbtn primary"
    }
    rtx = ""
    if (size(rtxMat) > 1) {
        cls = cls $ " lw-rtx"
        rtx = " data-rtx-material='" $ desktopui::EscapeHtml(rtxMat) $ "'"
    }
    onclick = ""
    if (size(eventName) > 1) {
        onclick = " onclick=\"webuiEvent('" $ desktopui::EscapeJs(eventName) $ "',{id:'" $ desktopui::EscapeJs(id) $ "'})\""
    }
    style = "width:" $ px $ "px;height:" $ px $ "px"
    return ("<button type='button' class='" $ cls $ "' id='" $ desktopui::EscapeHtml(id) $ "' style='" $ style $ "'" $ rtx $ onclick $ "><span data-icon='" $ desktopui::EscapeHtml(icon) $ "'></span></button>")
}

// Barre de progression (piste + remplissage). value/maxValue -> % rempli.
// rtxMat optionnel sur la piste.
func:ProgressBar(id, value, maxValue, rtxMat) {
    pct = 0
    if (maxValue > 0) {
        pct = (value * 100) / maxValue
    }
    cls = "lw-progress"
    rtx = ""
    if (size(rtxMat) > 1) {
        cls = cls $ " lw-rtx"
        rtx = " data-rtx-material='" $ desktopui::EscapeHtml(rtxMat) $ "'"
    }
    return ("<div class='" $ cls $ "' id='" $ desktopui::EscapeHtml(id) $ "'" $ rtx $ "><span class='lw-progress-fill' style='width:" $ strnum(pct) $ "%'></span></div>")
}

obj:VideoTable() {
    self.html = " "
    self.rows = " "

    func:AddVideo(self, title, source, kind, status, eventName) {
        actions = "<div class='lw-cell-actions'><button type='button' class='ui-btn primary' onclick=\"webuiEvent('" $ desktopui::EscapeJs(eventName) $ "_select',{id:'" $ desktopui::EscapeJs(eventName) $ "',value:'" $ desktopui::EscapeJs(title) $ "'})\"><span data-icon='play'></span>Select</button><button type='button' class='ui-btn' onclick=\"webuiEvent('" $ desktopui::EscapeJs(eventName) $ "_inspect',{id:'" $ desktopui::EscapeJs(eventName) $ "',value:'" $ desktopui::EscapeJs(source) $ "'})\">Inspect</button></div>"
        self.rows = self.rows $ "<tr><td><span class='gallery-table-title'>" $ desktopui::EscapeHtml(title) $ "</span></td><td><span class='gallery-badge'>" $ desktopui::EscapeHtml(kind) $ "</span></td><td>" $ desktopui::EscapeHtml(source) $ "</td><td><span class='gallery-badge done'>" $ desktopui::EscapeHtml(status) $ "</span></td><td>" $ actions $ "</td></tr>"
        return (self)
    }

    func:Close(self) {
        self.html = "<section class='ui-card'><div class='ui-card-head'><div class='ui-card-title'>Video player table</div><div class='ui-card-sub'>Placeholder for the future local video component</div></div><div class='ui-card-body'><div class='gallery-table-card'><div class='gallery-table-scroll'><table class='gallery-table'><thead><tr><th>Media</th><th>Type</th><th>Source</th><th>Status</th><th></th></tr></thead><tbody>" $ self.rows $ "</tbody></table></div></div><div class='gallery-note'>This table is ready for the upcoming video player widget. Row actions already send events to Toba.</div></div></section>"
        return (self)
    }
}

