    }
}

obj:Markdown() {
    self.html = " "

    func:Text(self, text) {
        self.html = "<div class='ui-markdown' data-md='1'><textarea style='display:none'>" $ desktopui::EscapeHtml(text) $ "</textarea><div class='ui-md-view'></div></div>"
        return (self)
    }

    func:LoadFile(self, path) {
        txt = fsreadf(path)
        if (!isstr(txt)) {
            txt = "# Documentation missing\n\nFile not found: " $ path
        }
        self.Text(txt)
        return (self)
    }
}

obj:CompactPage() {
    self.title = "Toba WebUI"
    self.footer = "libwebui"
    self.port = 19190
    self.width = 720
    self.height = 520
    self.x = 160
    self.y = 100
    self.windowMode = "normal"
    self.customChrome = 1
    self.nativeHandle = 0
    self.body = "<div class='ui-pro gallery-stack'>"
    self.closed = 0

    func:SetTitle(self, title) {
        self.title = title
        return (self)
    }

    func:SetFooter(self, footer) {
        self.footer = footer
        return (self)
    }

    func:SetPort(self, port) {
        self.port = port
        return (self)
    }

    func:SetWindow(self, width, height, x, y) {
        self.width = width
        self.height = height
        self.x = x
        self.y = y
        self.windowMode = "normal"
        return (self)
    }

    func:SetSize(self, width, height) {
        self.width = width
        self.height = height
        self.windowMode = "normal"
        return (self)
    }

    func:SetPosition(self, x, y) {
        self.x = x
        self.y = y
        return (self)
    }

    func:Normal(self) {
        self.windowMode = "normal"
        return (self)
    }

    func:Maximized(self) {
        self.windowMode = "maximized"
        self.width = 1480
        self.height = 900
        self.x = 20
        self.y = 20
        return (self)
    }

    func:CustomChrome(self) {
        self.customChrome = 1
        return (self)
    }

    func:NativeChrome(self) {
        self.customChrome = 0
        return (self)
    }

    func:NativeHandle(self) {
        return (self.nativeHandle)
    }

    func:Add(self, widget) {
        self.body = self.body $ widget.html
        return (self)
    }

    func:AddHtml(self, html) {
        self.body = self.body $ html
        return (self)
    }

    func:Close(self) {
        if (self.closed == 0) {
            self.body = self.body $ "</div>"
            self.closed = 1
        }
        return (self)
    }

    func:Render(self) {
        self.Close()
        toast = "<div id='gallery_toast_root' class='gallery-toast-root'></div>"
        compact = "<style>.lw-compact-page{min-height:100vh;display:grid;grid-template-rows:44px 1fr 28px;background:var(--bg-deep);color:var(--text-1)}.lw-compact-head{display:flex;align-items:center;justify-content:space-between;padding:0 14px;border-bottom:1px solid var(--border);background:var(--bg-surface);font-weight:800}.lw-compact-actions{display:flex;align-items:center;gap:8px}.lw-compact-main{padding:14px;overflow:auto}.lw-compact-foot{display:flex;align-items:center;padding:0 14px;border-top:1px solid var(--border);background:var(--bg-surface);color:var(--text-2);font-size:12px}.lw-compact-page .ui-pro{max-width:980px;margin:0 auto}.lw-compact-page .gallery-code{min-height:34px}</style>"
        bodyClass = " "
        titlebar = " "
        if (self.customChrome == 1) {
            bodyClass = " class='lw-native-chrome'"
            titlebar = widgets::WindowTitleBar(self.title, "T")
        }
        html = "<!doctype html><html><head><meta charset='utf-8'><title>" $ desktopui::EscapeHtml(self.title) $ "</title>" $ widgets::Styles() $ runtime::ProStyles() $ runtime::Styles() $ compact $ "</head><body data-theme='light_modern'" $ bodyClass $ ">" $ titlebar $ "<div class='lw-compact-page'><header class='lw-compact-head'><span>" $ desktopui::EscapeHtml(self.title) $ "</span><div class='lw-compact-actions'>" $ widgets::ThemeDropdown() $ "<span id='bridge_status' class='tm-value'>Bridge: starting</span></div></header><main class='lw-compact-main'>" $ self.body $ "</main><footer class='lw-compact-foot'>" $ desktopui::EscapeHtml(self.footer) $ "</footer></div>" $ toast $ runtime::Script() $ "</body></html>"
        html = desktopui::WithBridge(html, self.port)
        return (html)
    }

    func:ShowReliable(self, debugPath) {
        selectedPort = desktopui::BridgeStartReliable(self.port, 40)
        if (selectedPort != 0) {
            self.port = selectedPort
        }
        bridgeInit = selectedPort
        print("bridge init=")
        print(bridgeInit)
        print(" error=")
        print(desktopui::BridgeLastError())
        print("\n")
        html = self.Render()
        if (size(debugPath) > 0) {
            fswritef(debugPath, html)
        }
        if (self.customChrome == 1) {
            ShowWebViewHost(html, self.title, self.width, self.height, self.x, self.y)
            win = 0
        }
        else {
            win = desktopui::ShowBrowser(html, 1)
            desktopui::SetWindow(win, self.width, self.height, self.x, self.y)
        }
        return (win)
    }
}

func: PollRaw(timeoutMs) {
    res = desktopui::BridgePoll(timeoutMs)
    return (res)
}
