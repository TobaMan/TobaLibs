import : libwebui / desktopui
import : libwebui / widgets

func: GalleryStyles() {
    res = "<style>"
    res = res $ ".gallery-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px;align-content:start}.gallery-stack{display:flex;flex-direction:column;gap:12px;align-content:start}.gallery-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.gallery-card{border:1px solid var(--border);border-radius:8px;background:color-mix(in srgb,var(--bg-surface) 74%,var(--bg-card));padding:14px;min-height:86px}.gallery-title{font-size:13px;font-weight:650;margin-bottom:5px}.gallery-note{color:var(--text-2);font-size:12px;line-height:1.4}.gallery-code{font-family:var(--mono);font-size:11px;line-height:1.55;white-space:pre-wrap;overflow:auto;border:1px solid var(--border);border-radius:8px;background:var(--bg-surface);padding:12px;color:var(--text-2)}.gallery-event-log{min-height:58px}.gallery-layout-demo{display:grid;grid-template-columns:1fr 1fr;gap:10px}.gallery-layout-demo div{border:1px dashed var(--border);border-radius:8px;padding:16px;text-align:center;color:var(--text-2);background:var(--bg-surface)}.gallery-masonry{columns:3 180px;column-gap:10px}.gallery-masonry .ui-card{break-inside:avoid;margin-bottom:10px}.gallery-basic{border:1px solid var(--border);border-radius:8px;padding:14px;background:var(--bg-card);color:var(--text-1);display:flex;flex-direction:column;gap:10px}.gallery-basic .tb-row{margin:0;display:flex;align-items:center;gap:8px}.gallery-basic .tb-toolbar{display:flex;gap:0;width:max-content;border:1px solid var(--border);border-radius:999px;overflow:hidden;padding:3px;background:var(--bg-surface)}.gallery-basic .tb-button{border:0;border-radius:0;background:transparent;color:var(--text-1)}.gallery-basic .tb-button:first-child{border-top-left-radius:999px;border-bottom-left-radius:999px}.gallery-basic .tb-button:last-child{border-top-right-radius:999px;border-bottom-right-radius:999px}.gallery-basic .tb-button:hover{background:var(--accent-glow);color:var(--accent)}.gallery-basic .tb-input,.gallery-basic .tb-area{border:1px solid var(--border);border-radius:7px;background:var(--bg-surface);color:var(--text-1);padding:7px 9px}.gallery-chat-mini{height:420px}.gallery-chat-mini .lw-chat-messages{padding:18px}.gallery-chat-mini .lw-chat-msg{max-width:86%}.gallery-chart-wrap{height:280px;min-height:280px;border:1px solid var(--border);border-radius:8px;background:var(--bg-surface);padding:12px}.gallery-chart-wrap canvas{width:100%!important;height:100%!important}.gallery-tabs{display:flex;gap:0;width:max-content;border:1px solid var(--border);border-radius:999px;padding:3px;background:var(--bg-card);overflow:hidden}.gallery-tab{height:30px;border:0;border-radius:0;background:transparent;color:var(--text-2);padding:0 13px;font-weight:650;cursor:pointer}.gallery-tab:first-child{border-top-left-radius:999px;border-bottom-left-radius:999px}.gallery-tab:last-child{border-top-right-radius:999px;border-bottom-right-radius:999px}.gallery-tab.active{background:var(--accent-glow);color:var(--accent)}.gallery-tab-panel{display:none;border:1px solid var(--border);border-radius:8px;padding:14px;background:var(--bg-card)}.gallery-tab-panel.active{display:block}.gallery-modal-backdrop{display:none;position:fixed;inset:0;z-index:120;background:rgba(0,0,0,.42);align-items:center;justify-content:center;padding:24px}.gallery-modal-backdrop.open{display:flex}.gallery-modal{width:min(520px,100%);border:1px solid var(--border-glow);border-radius:10px;background:var(--bg-card);box-shadow:0 28px 90px rgba(0,0,0,.45);overflow:hidden}.gallery-modal-head{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-bottom:1px solid var(--border)}.gallery-modal-body{padding:16px;color:var(--text-2)}.tm-page{font-size:12px}.tm-menu-title{font-size:12px}.tm-menu-note{font-size:11.5px}.tm-panel{padding:14px}.tm-kpi-value{font-size:22px}.lw-pill-button{font-weight:600;font-size:12px}.tb-button{height:32px;padding:0 11px;font-size:12px;border-radius:7px}@media(max-width:900px){.gallery-layout-demo{grid-template-columns:1fr}.gallery-chat-mini{height:520px}}"
    res = res $ ".gallery-profile-wrap{position:relative;width:240px}.gallery-profile-trigger{width:100%;height:58px;border:1px solid var(--border);border-radius:var(--lw-radius);background:color-mix(in srgb,var(--bg-card) 92%,var(--bg-surface));color:var(--text-1);display:flex;align-items:center;gap:10px;padding:8px;cursor:pointer;text-align:left}.gallery-avatar{width:36px;height:36px;border-radius:var(--lw-pill-radius);background:linear-gradient(135deg,var(--accent),var(--user));display:flex;align-items:center;justify-content:center;color:var(--bg-deep);font-weight:800;flex:0 0 auto}.gallery-profile-name{font-weight:750;line-height:1.15}.gallery-profile-mail{font-size:11.5px;color:var(--text-2);line-height:1.15}.gallery-chev{margin-left:auto}.gallery-chev,.gallery-disclosure{width:12px;height:12px;position:relative;flex:0 0 12px}.gallery-disclosure{margin-left:0}.gallery-chev:before,.gallery-disclosure:before{content:' ';position:absolute;left:2px;top:2px;width:6px;height:6px;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:rotate(45deg);color:var(--text-2)}.gallery-profile-menu{display:none;position:absolute;left:0;top:calc(100% + 8px);width:240px;border:1px solid var(--border);border-radius:var(--lw-radius);background:color-mix(in srgb,var(--bg-card) 98%,var(--bg-surface));box-shadow:0 22px 70px rgba(0,0,0,.34);overflow:hidden;z-index:900}.gallery-profile-wrap.open .gallery-profile-menu{display:block}.gallery-profile-head{display:flex;align-items:center;gap:10px;padding:11px}.gallery-menu-section{border-top:1px solid var(--border);padding:5px}.gallery-menu-item{height:34px;width:100%;border:0;border-radius:var(--lw-radius);background:transparent;color:var(--text-1);display:flex;align-items:center;gap:10px;padding:0 9px;text-align:left;font-weight:650;cursor:pointer}.gallery-menu-item:hover{background:var(--bg-hover)}.gallery-menu-ico{width:18px;color:var(--text-2);font-family:var(--mono);text-align:center}.gallery-tree,.gallery-accordion{border:1px solid var(--border);border-radius:var(--lw-radius);background:var(--bg-card);padding:8px}.gallery-tree-item{min-height:30px}.gallery-tree-row{height:30px;border:0;border-radius:var(--lw-radius);background:transparent;color:var(--text-1);display:flex;align-items:center;gap:8px;width:100%;padding:0 8px;text-align:left;cursor:pointer}.gallery-tree-row:hover{background:var(--bg-hover)}.gallery-tree-kids{display:none;margin-left:18px;border-left:1px solid var(--border);padding-left:8px}.gallery-tree-item.open>.gallery-tree-kids{display:block}.gallery-collapse{border:1px solid var(--border);border-radius:var(--lw-radius);background:var(--bg-card);overflow:hidden}.gallery-collapse-head,.gallery-acc-head{height:38px;width:100%;border:0;background:transparent;color:var(--text-1);display:flex;align-items:center;justify-content:space-between;padding:0 12px;font-weight:700;cursor:pointer}.gallery-collapse-head:hover,.gallery-acc-head:hover{background:var(--bg-hover)}.gallery-collapse-body{display:none;border-top:1px solid var(--border);padding:12px;color:var(--text-2)}.gallery-collapse.open .gallery-collapse-body{display:block}.gallery-acc-item{border-bottom:1px solid var(--border)}.gallery-acc-item:last-child{border-bottom:0}.gallery-acc-body{display:none;padding:0 12px 12px;color:var(--text-2)}.gallery-acc-item.open .gallery-acc-body{display:block}.gallery-nav-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:var(--lw-gap);align-items:start}.gallery-nav-grid .ui-card,.gallery-nav-grid .ui-card-body{overflow:visible!important}.tm-panel.table,.tm-html{overflow:visible!important}.lw-icon{width:15px;height:15px;display:inline-flex;align-items:center;justify-content:center;color:currentColor;flex:0 0 15px}.lw-icon svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.gallery-slider-card{display:grid;grid-template-columns:110px minmax(160px,1fr) 48px;align-items:center;gap:10px;border:1px solid var(--border);border-radius:var(--lw-radius);background:var(--bg-card);padding:10px}.gallery-slider-card input{width:100%;accent-color:var(--accent)}.gallery-slider-value{font-family:var(--mono);color:var(--accent);text-align:right}.gallery-toast-root{position:fixed;right:18px;bottom:18px;z-index:1000;display:flex;flex-direction:column;gap:10px;pointer-events:none}.gallery-toast{min-width:260px;max-width:360px;border:1px solid var(--border-glow);border-radius:var(--lw-radius);background:color-mix(in srgb,var(--bg-card) 96%,var(--bg-surface));box-shadow:0 18px 60px rgba(0,0,0,.32);padding:12px 14px;color:var(--text-1);pointer-events:auto;display:grid;grid-template-columns:auto 1fr;gap:9px;animation:toastIn .16s ease-out}.gallery-toast-title{font-weight:750}.gallery-toast-text{color:var(--text-2);font-size:12px;margin-top:2px}@keyframes toastIn{from{transform:translateY(8px);opacity:0}to{transform:translateY(0);opacity:1}}"
    res = res $ ".gallery-slider-card input[type='range']{-webkit-appearance:none;appearance:none;height:24px;background:transparent;cursor:pointer}.gallery-slider-card input[type='range']::-webkit-slider-runnable-track{height:6px;border-radius:999px;background:linear-gradient(90deg,var(--accent),color-mix(in srgb,var(--accent) 35%,var(--bg-hover)));border:1px solid var(--border)}.gallery-slider-card input[type='range']::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;width:18px;height:18px;margin-top:-7px;border-radius:999px;border:2px solid var(--bg-card);background:var(--accent);box-shadow:0 4px 16px var(--accent-glow);cursor:pointer}.gallery-slider-card input[type='range']:focus{outline:none}.gallery-slider-card input[type='range']:focus::-webkit-slider-thumb{box-shadow:0 0 0 4px var(--accent-glow)}.gallery-slider-card input[type='range']::-moz-range-track{height:6px;border-radius:999px;background:var(--accent);border:1px solid var(--border)}.gallery-slider-card input[type='range']::-moz-range-thumb{width:18px;height:18px;border-radius:999px;border:2px solid var(--bg-card);background:var(--accent);box-shadow:0 4px 16px var(--accent-glow);cursor:pointer}"
    res = res $ ".gallery-table-demo{display:flex;flex-direction:column;gap:var(--lw-gap);font-size:12px}.gallery-table-top{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.gallery-table-card{border:1px solid var(--border);border-radius:var(--lw-radius);background:color-mix(in srgb,var(--bg-card) 96%,var(--bg-surface));overflow:visible}.gallery-table-scroll{overflow:auto}.gallery-table{width:100%;border-collapse:separate;border-spacing:0;min-width:940px}.gallery-table thead th{height:42px;background:var(--bg-hover);color:var(--text-1);font-weight:750;text-align:left;border-bottom:1px solid var(--border);padding:0 12px;white-space:nowrap}.gallery-table tbody td{height:52px;border-bottom:1px solid var(--border);padding:0 12px;vertical-align:middle;white-space:nowrap}.gallery-table tbody tr:last-child td{border-bottom:0}.gallery-table tbody tr:hover td{background:color-mix(in srgb,var(--bg-hover) 50%,transparent)}.gallery-table-title{font-weight:750;color:var(--text-1)}.gallery-check{width:16px;height:16px;border:1px solid var(--border-glow);border-radius:4px;background:var(--bg-card);accent-color:var(--accent)}.gallery-grip{width:14px;color:var(--text-3);font-family:var(--mono);letter-spacing:-2px;cursor:grab}.gallery-badge{display:inline-flex;align-items:center;gap:6px;height:24px;border:1px solid var(--border);border-radius:var(--lw-pill-radius);padding:0 9px;background:var(--bg-surface);color:var(--text-1);font-size:11.5px}.gallery-badge.done:before{content:' ';width:6px;height:6px;border-radius:999px;background:#00d084;box-shadow:0 0 0 2px rgba(0,208,132,.16)}.gallery-badge.busy:before{content:' ';width:7px;height:7px;border-radius:999px;border:1px dashed var(--text-2)}.gallery-reviewer{min-width:150px}.gallery-row-menu{position:relative;display:inline-flex}.gallery-row-menu .ui-dropdown-menu{right:0;top:calc(100% + 6px)}.gallery-pagination{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;color:var(--text-2)}.gallery-pager{display:flex;align-items:center;gap:8px}.gallery-table .ui-btn{border-radius:var(--lw-pill-radius)}.gallery-tabs .gallery-count{margin-left:4px;min-width:18px;height:18px;border-radius:999px;background:var(--bg-hover);color:var(--text-1);display:inline-flex;align-items:center;justify-content:center;font-size:11px;padding:0 5px}.gallery-code.compact{max-height:96px}"
    res = res $ "</style>"
    return (res)
}

func: ProStyles() {
    html = "<style>"
    html = html $ ".ui-pro{--ui-h:32px;--ui-radius:7px;--ui-pad-x:11px;font-size:12px;line-height:1.35;color:var(--text-1);display:flex;flex-direction:column;gap:12px}.ui-pro *{box-sizing:border-box}.ui-card{border:1px solid var(--border);border-radius:8px;background:color-mix(in srgb,var(--bg-card) 96%,var(--bg-surface));box-shadow:0 1px 2px rgba(0,0,0,.08);overflow:hidden}.ui-card-head{padding:12px 14px;border-bottom:1px solid var(--border)}.ui-card-title{font-size:13px;font-weight:650}.ui-card-sub{font-size:11.5px;color:var(--text-2);margin-top:2px}.ui-card-body{padding:14px;display:flex;flex-direction:column;gap:12px}.ui-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}.ui-toolbar{height:40px;display:flex;align-items:center;gap:0;padding:4px;border:1px solid var(--border);border-radius:999px;background:color-mix(in srgb,var(--bg-card) 88%,transparent);width:max-content;max-width:100%;overflow:hidden}.ui-sep{width:1px;height:18px;background:var(--border);margin:0 3px}.ui-btn{height:var(--ui-h);display:inline-flex;align-items:center;justify-content:center;gap:7px;border:0;border-radius:0;background:transparent;color:var(--text-1);padding:0 var(--ui-pad-x);font-size:12px;font-weight:600;line-height:1;cursor:pointer;white-space:nowrap}.ui-btn:first-child{border-top-left-radius:999px;border-bottom-left-radius:999px}.ui-btn:last-child{border-top-right-radius:999px;border-bottom-right-radius:999px}.ui-btn:hover{background:var(--bg-hover);color:var(--accent)}.ui-btn.primary{background:var(--accent);color:var(--bg-deep)}.ui-btn.ghost{background:transparent;color:var(--text-2)}.ui-btn.ghost:hover{background:var(--bg-hover);color:var(--text-1)}.ui-btn.danger{color:var(--error);background:transparent}.ui-icon-btn{width:32px;padding:0}.ui-input{height:34px;border:1px solid var(--border);border-radius:7px;background:var(--bg-card);color:var(--text-1);padding:0 10px;font-size:12px;outline:none}.ui-label{font-size:11px;font-weight:600;color:var(--text-2);margin-bottom:6px}.ui-field{display:flex;flex-direction:column}.ui-dropdown{position:relative;min-width:176px}.ui-dropdown>.ui-btn{width:100%;justify-content:space-between;border:1px solid var(--border);border-radius:999px;background:var(--bg-card)}.ui-dropdown-menu{position:absolute;z-index:80;right:0;top:calc(100% + 6px);display:none;min-width:210px;padding:4px;border:1px solid var(--border);border-radius:8px;background:var(--bg-card);box-shadow:0 18px 50px rgba(0,0,0,.28)}.ui-dropdown.open .ui-dropdown-menu{display:block}.ui-option{width:100%;height:30px;border:0;border-radius:6px;background:transparent;color:var(--text-1);display:flex;align-items:center;gap:8px;padding:0 8px;font-size:12px;text-align:left;cursor:pointer}.ui-option:hover,.ui-option.active{background:var(--bg-hover)}.ui-stat{display:flex;flex-direction:column;gap:6px;padding:14px;border:1px solid var(--border);border-radius:8px;background:var(--bg-card)}.ui-stat-label{font-size:11px;color:var(--text-2);font-weight:600}.ui-stat-value{font-size:22px;font-weight:700;letter-spacing:-.02em;color:var(--text-1)}.ui-stat-note{font-size:11.5px;color:var(--text-2)}.ui-list{border:1px solid var(--border);border-radius:8px;overflow:hidden}.ui-list-row{height:38px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 12px;border-bottom:1px solid var(--border);font-size:12px}.ui-list-row:last-child{border-bottom:0}.ui-muted{color:var(--text-2)}.ui-markdown{border:1px solid var(--border);border-radius:var(--lw-radius);background:var(--bg-card);padding:16px;max-height:620px;overflow:auto}.ui-markdown h1{font-size:22px;margin:0 0 14px}.ui-markdown h2{font-size:16px;margin:18px 0 8px}.ui-markdown h3{font-size:13px;margin:14px 0 6px}.ui-markdown p,.ui-markdown li{color:var(--text-2);font-size:12.5px;line-height:1.55}.ui-markdown ul{padding-left:18px}.ui-markdown code{font-family:var(--mono);font-size:11.5px;color:var(--accent);background:var(--bg-hover);border:1px solid var(--border);border-radius:5px;padding:1px 5px}.ui-markdown pre{background:var(--bg-surface);border:1px solid var(--border);border-radius:var(--lw-radius);padding:12px;overflow:auto}.ui-markdown pre code{background:transparent;border:0;padding:0;color:var(--text-1)}"
    html = html $ "</style>"
    return (html)
}

func: ProChartDemo() {
    html = "<div class='gallery-chart-wrap'><canvas id='gallery_chart'></canvas></div>"
    return (html)
}

func: GalleryScript() {
    res = "<script>"
    res = res $ "window.webuiEvent=function(name){var args=Array.prototype.slice.call(arguments,1);if(args.length==0)args=[name];var e=document.getElementById('gallery_event_log');if(e){e.textContent='Event: '+name+' '+args.join(' ')+' at '+new Date().toLocaleTimeString();}try{window.dispatchEvent(new CustomEvent('toba:event',{detail:{name:name,args:args}}));}catch(x){}};"
    res = res $ "window.galleryLog=window.webuiEvent;"
    res = res $ "window.tmShow=function(id){var ps=document.querySelectorAll('.tm-panel');var ms=document.querySelectorAll('.tm-menu-item');for(var i=0;i<ps.length;i++){ps[i].classList.remove('active')}for(var j=0;j<ms.length;j++){ms[j].classList.remove('active')}var p=document.getElementById('panel_'+id);var m=document.getElementById('menu_'+id);if(p){p.classList.add('active')}if(m){m.classList.add('active')}if(id=='chart'){setTimeout(galleryInitCharts,40)}webuiEvent('show_'+id);};"
    res = res $ "window.tmSetTheme=function(v){var val=v||'light_modern';document.body.setAttribute('data-theme',val);var opts=document.querySelectorAll('.tm-drop-option[data-theme]');for(var i=0;i<opts.length;i++){var on=opts[i].getAttribute('data-theme')==val;opts[i].classList.toggle('active',on);if(on){var d=opts[i].closest('.tm-dropdown');if(d){var b=d.querySelector('.tm-drop-btn');if(b)b.textContent=opts[i].textContent}}}webuiEvent('theme_'+val);};"
    res = res $ "window.tmDrop=function(btn){var d=btn.closest('.tm-dropdown');if(!d)return;var id=d.id||btn.textContent.trim()||'dropdown';var was=d.classList.contains('open');var all=document.querySelectorAll('.tm-dropdown.open');for(var i=0;i<all.length;i++){if(all[i]!==d){all[i].classList.remove('open');webuiEvent('dropdown_close',all[i].id||'dropdown','closed')}}if(was){d.classList.remove('open');webuiEvent('dropdown_close',id,'closed')}else{d.classList.add('open');webuiEvent('dropdown_open',id,'open')}};"
    res = res $ "window.tmPickTheme=function(btn,v){tmSetTheme(v);var d=btn.closest('.tm-dropdown');if(d)d.classList.remove('open');};"
    res = res $ "window.tmPickAction=function(btn,v){webuiEvent('action_'+v);var d=btn.closest('.tm-dropdown');if(d)d.classList.remove('open');};"
    res = res $ "window.webuiChatSend=function(){var m=document.getElementById('gallery_chat_messages');if(!m)return;var d=document.createElement('div');d.className='lw-chat-msg user';var p=document.getElementById('gallery_prompt');var msg=(p&&p.value?p.value:'Message from webui');d.textContent=msg;m.appendChild(d);var a=document.createElement('div');a.className='lw-chat-msg assistant';a.textContent='Component event received.';m.appendChild(a);m.scrollTop=m.scrollHeight;if(p)p.value=String();webuiEvent('chat_send','gallery_prompt',msg);};window.galleryAddChat=window.webuiChatSend;"
    res = res $ "window.galleryTab=function(id){var bs=document.querySelectorAll('.gallery-tab');var ps=document.querySelectorAll('.gallery-tab-panel');for(var i=0;i<bs.length;i++){bs[i].classList.toggle('active',bs[i].getAttribute('data-tab')==id)}for(var j=0;j<ps.length;j++){ps[j].classList.toggle('active',ps[j].id=='tab_'+id)}webuiEvent('tab_'+id);};"
    res = res $ "window.webuiModal=function(open){var e=document.getElementById('gallery_modal');if(e){e.classList.toggle('open',open==1)}webuiEvent(open==1?'modal_open':'modal_close','gallery_modal',open==1?'open':'closed');};window.galleryModal=window.webuiModal;"
    res = res $ "window.webuiProfile=function(btn){var d=btn.closest('.gallery-profile-wrap');if(!d)return;var was=d.classList.contains('open');var all=document.querySelectorAll('.gallery-profile-wrap.open');for(var i=0;i<all.length;i++){if(all[i]!==d){all[i].classList.remove('open')}}if(was){d.classList.remove('open');webuiEvent('profile_close','profile','closed')}else{d.classList.add('open');webuiEvent('profile_open','profile','open')}};window.galleryProfile=window.webuiProfile;"
    res = res $ "window.webuiTree=function(btn){var it=btn.closest('.gallery-tree-item');if(it){it.classList.toggle('open');var open=it.classList.contains('open');var label=btn.textContent.trim()||'tree';webuiEvent(open?'tree_open':'tree_close',label,open?'open':'closed')}};window.galleryTree=window.webuiTree;"
    res = res $ "window.webuiCollapse=function(id){var e=document.getElementById(id);if(e){e.classList.toggle('open');var open=e.classList.contains('open');webuiEvent(open?'collapse_open':'collapse_close',id,open?'open':'closed')}};window.galleryCollapse=window.webuiCollapse;"
    res = res $ "window.webuiAccordion=function(btn){var root=btn.closest('.gallery-accordion');var item=btn.closest('.gallery-acc-item');if(!root||!item)return;var items=root.querySelectorAll('.gallery-acc-item');for(var i=0;i<items.length;i++){if(items[i]!==item&&items[i].classList.contains('open')){items[i].classList.remove('open');var oldHead=items[i].querySelector('.gallery-acc-head');webuiEvent('accordion_close',(oldHead?oldHead.textContent.trim():'accordion'),'closed')}}var was=item.classList.contains('open');item.classList.toggle('open');var label=btn.textContent.trim()||'accordion';webuiEvent(was?'accordion_close':'accordion_open',label,was?'closed':'open')};window.galleryAccordion=window.webuiAccordion;"
