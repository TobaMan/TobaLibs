    res = res $ "window.mdRender=function(src){var out=[],raw=String(src||String()).split(String.fromCharCode(13)).join(String()),lines=raw.split(String.fromCharCode(10));var list=0,code=0,buf=[];function closeList(){if(list){out.push('</ul>');list=0}}function closeCode(){if(code){out.push('<pre><code>'+mdEsc(buf.join(String.fromCharCode(10)))+'</code></pre>');buf=[];code=0}}for(var i=0;i<lines.length;i++){var l=lines[i];if(l.indexOf('```')===0){if(code){closeCode()}else{closeList();code=1;buf=[]}continue}if(code){buf.push(l);continue}if(l.indexOf('### ')==0){closeList();out.push('<h3>'+mdInline(l.slice(4))+'</h3>');continue}if(l.indexOf('## ')==0){closeList();out.push('<h2>'+mdInline(l.slice(3))+'</h2>');continue}if(l.indexOf('# ')==0){closeList();out.push('<h1>'+mdInline(l.slice(2))+'</h1>');continue}if(l.indexOf('- ')==0){if(!list){out.push('<ul>');list=1}out.push('<li>'+mdInline(l.slice(2))+'</li>');continue}if(l.trim().length==0){closeList();continue}closeList();out.push('<p>'+mdInline(l)+'</p>')}closeList();closeCode();return out.join(String())};"
