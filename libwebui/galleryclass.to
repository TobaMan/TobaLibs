    res = res $ "window.webuiChartAddPoint=function(params){params=params||{};galleryInitCharts();var c=window.galleryChartObj;if(!c)return;var label=String(params.label||new Date().toLocaleTimeString());var v=Number(params.value||0);var v2=Number(params.secondary||Math.max(0,v-8));c.data.labels.push(label);c.data.datasets[0].data.push(v);c.data.datasets[1].data.push(v2);while(c.data.labels.length>40){c.data.labels.shift();c.data.datasets[0].data.shift();c.data.datasets[1].data.shift()}c.update('none');var e=document.getElementById('gallery_chart_status');if(e)e.textContent='Toba point '+label+' = '+v;};window.galleryChartAddPoint=window.webuiChartAddPoint;"
