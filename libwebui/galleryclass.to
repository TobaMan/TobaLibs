func: OverviewPanel() {
    stats = "<div class='ui-stat'><div class='ui-stat-label'>Window</div><div class='ui-stat-value'>Desktop</div><div class='ui-stat-note'>ShowBrowser + DockPage</div></div>"
    stats = stats $ "<div class='ui-stat'><div class='ui-stat-label'>Widgets</div><div class='ui-stat-value'>Pro</div><div class='ui-stat-note'>shadcn-like layer</div></div>"
    stats = stats $ "<div class='ui-stat'><div class='ui-stat-label'>Events</div><div class='ui-stat-value'>Bridge</div><div class='ui-stat-note'>WebSocket to Toba</div></div>"
    stats = stats $ "<div class='ui-stat'><div class='ui-stat-label'>Layout</div><div class='ui-stat-value'>Dock</div><div class='ui-stat-note'>Sidebar + stage</div></div>"
    res = "<div class='ui-pro'><div class='ui-grid'>" $ stats $ "</div>"
    res = res $ "<div class='gallery-grid'>"
    res = res $ "<section class='ui-card'><div class='ui-card-head'><div class='ui-card-title'>Design tokens</div><div class='ui-card-sub'>Small type, stable heights, radius 7/8</div></div><div class='ui-card-body'><div class='gallery-note'>The Pro layer uses the current libwebui theme variables, so every skin keeps working.</div></div></section>"
    res = res $ "<section class='ui-card'><div class='ui-card-head'><div class='ui-card-title'>Pill rows preserved</div><div class='ui-card-sub'>Existing pill controls remain untouched</div></div><div class='ui-card-body'><div class='gallery-note'>New shadcn-like widgets live beside the older pill row components.</div></div></section>"
    res = res $ "<section class='ui-card'><div class='ui-card-head'><div class='ui-card-title'>Local icons</div><div class='ui-card-sub'>Lucide-style inline SVG</div></div><div class='ui-card-body'><div class='gallery-note'>No network dependency. Toolbar buttons stay compact and aligned.</div></div></section>"
    res = res $ "<section class='ui-card'><div class='ui-card-head'><div class='ui-card-title'>Custom dropdowns</div><div class='ui-card-sub'>Not native select menus</div></div><div class='ui-card-body'><div class='gallery-note'>Dropdown menus are rendered by libwebui and inherit themes.</div></div></section>"
    res = res $ "</div></div>"
    return (res)
}

func: InputsPanel() {
    menu = "<button type='button' class='ui-option active' onclick=\"webuiEvent('dropdown_compact')\">Compact</button>"
    menu = menu $ "<button type='button' class='ui-option' onclick=\"webuiEvent('dropdown_comfortable')\">Comfortable</button>"
    menu = menu $ "<button type='button' class='ui-option' onclick=\"webuiEvent('dropdown_dense')\">Dense</button>"
    toolbar = "<button id='gal_new' type='button' class='ui-btn ui-icon-btn ghost' title='New' onclick=\"webuiEvent('new_clicked')\"><span data-icon='plus'></span></button>"
    toolbar = toolbar $ "<button id='gal_search' type='button' class='ui-btn ui-icon-btn ghost' title='Search' onclick=\"webuiEvent('search_clicked')\"><span data-icon='search'></span></button>"
    toolbar = toolbar $ "<span class='ui-sep'></span>"
    toolbar = toolbar $ "<button id='gal_save' type='button' class='ui-btn primary' onclick=\"webuiEvent('save_clicked')\"><span data-icon='save'></span>Save</button>"
    toolbar = toolbar $ "<button id='gal_copy' type='button' class='ui-btn' onclick=\"webuiEvent('copy_clicked')\"><span data-icon='copy'></span>Copy</button>"
    toolbar = toolbar $ "<button id='gal_delete' type='button' class='ui-btn ui-icon-btn danger' title='Delete' onclick=\"webuiEvent('delete_clicked')\"><span data-icon='trash'></span></button>"
    res = "<div class='ui-pro gallery-stack'>"
    res = res $ "<div class='ui-toolbar'>" $ toolbar $ "</div>"
    res = res $ "<div class='gallery-row'><div id='gal_custom_dropdown' class='ui-dropdown'><button type='button' class='ui-btn' onclick='tmDrop(this)'>Density</button><div class='ui-dropdown-menu'>" $ menu $ "</div></div><div id='gal_actions_dropdown' class='ui-dropdown'><button type='button' class='ui-btn' onclick='tmDrop(this)'>Actions</button><div class='ui-dropdown-menu'><button type='button' class='ui-option' onclick=\"webuiEvent('action_refresh')\">Refresh</button><button type='button' class='ui-option' onclick=\"webuiEvent('action_export')\">Export</button><button type='button' class='ui-option' onclick=\"webuiEvent('action_reset')\">Reset</button></div></div></div>"
    res = res $ "<div class='gallery-row'><div class='ui-dropdown'><button type='button' class='ui-btn' onclick='tmDrop(this)'>Radius</button><div class='ui-dropdown-menu'><button type='button' class='ui-option' onclick=\"gallerySetRadius('square')\">Square</button><button type='button' class='ui-option' onclick=\"gallerySetRadius('soft')\">Soft</button><button type='button' class='ui-option active' onclick=\"gallerySetRadius('round')\">Round</button></div></div><div class='ui-dropdown'><button type='button' class='ui-btn' onclick='tmDrop(this)'>Spacing</button><div class='ui-dropdown-menu'><button type='button' class='ui-option' onclick=\"gallerySetSpacing('compact')\">Compact</button><button type='button' class='ui-option active' onclick=\"gallerySetSpacing('normal')\">Normal</button><button type='button' class='ui-option' onclick=\"gallerySetSpacing('wide')\">Wide</button></div></div></div>"
    res = res $ "<div class='gallery-slider-card'><label for='radius_slider'>Radius</label><input id='radius_slider' type='range' min='0' max='32' value='6' oninput='gallerySetRadiusPx(this.value)'><span id='radius_value' class='gallery-slider-value'>6 px</span></div>"
    res = res $ "<div class='gallery-slider-card'><label for='spacing_slider'>Spacing</label><input id='spacing_slider' type='range' min='4' max='32' value='14' oninput='gallerySetSpacingPx(this.value)'><span id='spacing_value' class='gallery-slider-value'>14 px</span></div>"
    res = res $ widgets::PillInput("gal_name", "Name", "Toba WebUI", "webuiEvent('name_changed')")
    res = res $ "<div class='gallery-tabs'><button type='button' class='gallery-tab active' data-tab='one' onclick=\"galleryTab('one')\">Overview</button><button type='button' class='gallery-tab' data-tab='two' onclick=\"galleryTab('two')\">Settings</button><button type='button' class='gallery-tab' data-tab='three' onclick=\"galleryTab('three')\">Events</button></div>"
    res = res $ "<div id='tab_one' class='gallery-tab-panel active'>Tabs are custom widgets, not native browser tabs.</div><div id='tab_two' class='gallery-tab-panel'>Settings panel with stable spacing and theme tokens.</div><div id='tab_three' class='gallery-tab-panel'>Events are still sent through the Toba bridge.</div>"
    res = res $ "<div class='gallery-row'><button type='button' class='ui-btn primary' onclick='webuiModal(1)'>Open popup</button><button type='button' class='ui-btn' onclick=\"webuiToast('Saved','Toast event rendered by the web runtime')\"><span data-icon='bell'></span>Toast demo</button></div>"
    res = res $ "<div class='ui-card'><div class='ui-card-body'><div class='ui-field'><div class='ui-label'>Command</div><input class='ui-input' value='Aligned shadcn-like input'></div></div></div>"
    res = res $ "<div class='gallery-card gallery-event-log' id='gallery_event_log'>Event: waiting...</div>"
    res = res $ "<div class='gallery-code'>widgets::ProToolbar(...)\nwidgets::ProButton(id, text, icon, js, variant)\nwidgets::ProIconButton(id, icon, title, js, variant)\nwidgets::ProDropdown(id, label, icon, options)\nwidgets::ProOption(text, icon, js, active)</div>"
    res = res $ "</div>"
    return (res)
}

func: DataPanel() {
    rows = widgets::GpuMetricRow("NVIDIA RTX 5060", 2200, 8151, 27, 48)
    rows = rows $ widgets::GpuMetricRow("NVIDIA RTX 5070 Ti", 3100, 16303, 19, 43)
    stats = "<div class='ui-stat'><div class='ui-stat-label'>CPU</div><div class='ui-stat-value'>14.2%</div><div class='ui-stat-note'>Sample value</div></div>"
    stats = stats $ "<div class='ui-stat'><div class='ui-stat-label'>RAM</div><div class='ui-stat-value'>47.8%</div><div class='ui-stat-note'>31214 MB / 65292 MB</div></div>"
    stats = stats $ "<div class='ui-stat'><div class='ui-stat-label'>GPU</div><div class='ui-stat-value'>2</div><div class='ui-stat-note'>Detected cards</div></div>"
    res = "<div class='ui-pro gallery-stack'>"
    res = res $ "<div class='ui-grid'>" $ stats $ "</div>"
    res = res $ widgets::GpuTable(rows)
    menu = "<div class='tm-dropdown gallery-row-menu'><button type='button' class='ui-btn ui-icon-btn' onclick='tmDrop(this)' title='Row actions'>...</button><div class='ui-dropdown-menu tm-drop-menu'><button type='button' class='ui-option' onclick=\"webuiEvent('row_open')\">Open</button><button type='button' class='ui-option' onclick=\"webuiEvent('row_duplicate')\">Duplicate</button><button type='button' class='ui-option' onclick=\"webuiEvent('row_delete')\">Delete</button></div></div>"
    reviewer = "<div class='tm-dropdown gallery-reviewer'><button type='button' class='ui-btn' onclick='tmDrop(this)'>Assign reviewer</button><div class='ui-dropdown-menu tm-drop-menu'><button type='button' class='ui-option' onclick=\"webuiEvent('assign_eddie')\">Eddie Lake</button><button type='button' class='ui-option' onclick=\"webuiEvent('assign_jamik')\">Jamik Tashpulatov</button><button type='button' class='ui-option' onclick=\"webuiEvent('assign_marie')\">Marie Curie</button></div></div>"
    tabs = "<div class='gallery-tabs'><button type='button' class='gallery-tab gallery-table-tab active' data-table-tab='outline' onclick=\"webuiEvent('table_tab_outline')\">Outline</button><button type='button' class='gallery-tab gallery-table-tab' data-table-tab='past' onclick=\"webuiEvent('table_tab_past')\">Past Performance <span class='gallery-count'>3</span></button><button type='button' class='gallery-tab gallery-table-tab' data-table-tab='key' onclick=\"webuiEvent('table_tab_key')\">Key Personnel <span class='gallery-count'>2</span></button><button type='button' class='gallery-tab gallery-table-tab' data-table-tab='focus' onclick=\"webuiEvent('table_tab_focus')\">Focus Documents</button></div>"
    columns = "<div class='tm-dropdown'><button type='button' class='ui-btn' onclick='tmDrop(this)'><span data-icon='settings'></span>Customize Columns</button><div class='ui-dropdown-menu tm-drop-menu'><button type='button' class='ui-option' onclick=\"webuiEvent('column_header')\">Header</button><button type='button' class='ui-option active' onclick=\"webuiEvent('column_status')\">Status</button><button type='button' class='ui-option active' onclick=\"webuiEvent('column_reviewer')\">Reviewer</button></div></div>"
    top = "<div class='gallery-table-top'>" $ tabs $ "<div class='gallery-row'>" $ columns $ "<button type='button' class='ui-btn primary' onclick=\"webuiEvent('table_add_section')\"><span data-icon='plus'></span>Add Section</button></div></div>"
    proRows = ""
    proRows = proRows $ "<tr><td><span class='gallery-grip'>::</span></td><td><input class='gallery-check gallery-row-check' type='checkbox' onchange=\"webuiEvent('table_select')\"></td><td><span class='gallery-table-title'>Cover page</span></td><td><span class='gallery-badge'>Cover page</span></td><td><span class='gallery-badge busy'>In Process</span></td><td><strong>18</strong></td><td><strong>5</strong></td><td>Eddie Lake</td><td>" $ menu $ "</td></tr>"
    proRows = proRows $ "<tr><td><span class='gallery-grip'>::</span></td><td><input class='gallery-check gallery-row-check' type='checkbox' onchange=\"webuiEvent('table_select')\"></td><td><span class='gallery-table-title'>Table of contents</span></td><td><span class='gallery-badge'>Table of contents</span></td><td><span class='gallery-badge done'>Done</span></td><td><strong>29</strong></td><td><strong>24</strong></td><td>Eddie Lake</td><td>" $ menu $ "</td></tr>"
    proRows = proRows $ "<tr><td><span class='gallery-grip'>::</span></td><td><input class='gallery-check gallery-row-check' type='checkbox' onchange=\"webuiEvent('table_select')\"></td><td><span class='gallery-table-title'>Executive summary</span></td><td><span class='gallery-badge'>Narrative</span></td><td><span class='gallery-badge done'>Done</span></td><td><strong>10</strong></td><td><strong>13</strong></td><td>Eddie Lake</td><td>" $ menu $ "</td></tr>"
    proRows = proRows $ "<tr><td><span class='gallery-grip'>::</span></td><td><input class='gallery-check gallery-row-check' type='checkbox' onchange=\"webuiEvent('table_select')\"></td><td><span class='gallery-table-title'>Technical approach</span></td><td><span class='gallery-badge'>Narrative</span></td><td><span class='gallery-badge done'>Done</span></td><td><strong>27</strong></td><td><strong>23</strong></td><td>Jamik Tashpulatov</td><td>" $ menu $ "</td></tr>"
    proRows = proRows $ "<tr><td><span class='gallery-grip'>::</span></td><td><input class='gallery-check gallery-row-check' type='checkbox' onchange=\"webuiEvent('table_select')\"></td><td><span class='gallery-table-title'>Design</span></td><td><span class='gallery-badge'>Narrative</span></td><td><span class='gallery-badge busy'>In Process</span></td><td><strong>2</strong></td><td><strong>16</strong></td><td>Jamik Tashpulatov</td><td>" $ menu $ "</td></tr>"
    proRows = proRows $ "<tr><td><span class='gallery-grip'>::</span></td><td><input class='gallery-check gallery-row-check' type='checkbox' onchange=\"webuiEvent('table_select')\"></td><td><span class='gallery-table-title'>Capabilities</span></td><td><span class='gallery-badge'>Narrative</span></td><td><span class='gallery-badge busy'>In Process</span></td><td><strong>20</strong></td><td><strong>8</strong></td><td>Jamik Tashpulatov</td><td>" $ menu $ "</td></tr>"
    proRows = proRows $ "<tr><td><span class='gallery-grip'>::</span></td><td><input class='gallery-check gallery-row-check' type='checkbox' onchange=\"webuiEvent('table_select')\"></td><td><span class='gallery-table-title'>Innovation and Advantages</span></td><td><span class='gallery-badge'>Narrative</span></td><td><span class='gallery-badge done'>Done</span></td><td><strong>25</strong></td><td><strong>26</strong></td><td>" $ reviewer $ "</td><td>" $ menu $ "</td></tr>"
    proTable = "<div class='gallery-table-demo'>" $ top $ "<div class='gallery-table-card'><div class='gallery-table-scroll'><table class='gallery-table'><thead><tr><th></th><th><input class='gallery-check' type='checkbox' onchange=\"webuiEvent('table_select_all')\"></th><th>Header</th><th>Section Type</th><th>Status</th><th>Target</th><th>Limit</th><th>Reviewer</th><th></th></tr></thead><tbody>" $ proRows $ "</tbody></table></div></div><div class='gallery-pagination'><span id='gallery_table_selected'>0 of 68 row(s) selected.</span><div class='gallery-pager'><span>Rows per page</span><div class='tm-dropdown'><button type='button' class='ui-btn' onclick='tmDrop(this)'>10</button><div class='ui-dropdown-menu tm-drop-menu'><button type='button' class='ui-option active' onclick=\"webuiEvent('page_10')\">10</button><button type='button' class='ui-option' onclick=\"webuiEvent('page_25')\">25</button><button type='button' class='ui-option' onclick=\"webuiEvent('page_50')\">50</button></div></div><strong>Page 1 of 7</strong><button type='button' class='ui-btn ui-icon-btn' onclick=\"webuiEvent('page_first')\">&lt;&lt;</button><button type='button' class='ui-btn ui-icon-btn' onclick=\"webuiEvent('page_prev')\">&lt;</button><button type='button' class='ui-btn ui-icon-btn' onclick=\"webuiEvent('page_next')\">&gt;</button><button type='button' class='ui-btn ui-icon-btn' onclick=\"webuiEvent('page_last')\">&gt;&gt;</button></div></div><div class='gallery-code compact'>Toba contract: Toolbar + Tabs + Table + RowActionDropdown + Pagination. Every click calls galleryLog and dispatches a Toba bridge event.</div></div>"
    res = res $ proTable
    res = res $ "<div class='tm-table-wrap'><table class='tm-table'><thead><tr><th>Item</th><th>Status</th><th>Action</th></tr></thead><tbody><tr><td>Popup row action</td><td>ready</td><td><div class='lw-cell-actions'><button type='button' class='ui-btn primary' onclick=\"webuiEvent('table_button_right')\"><span data-icon='save'></span>Apply</button></div></td></tr><tr><td>Any widget slot</td><td>custom</td><td><div class='lw-cell-actions'><button type='button' class='ui-btn' onclick=\"webuiToast('Table','Right aligned table action')\"><span data-icon='bell'></span>Notify</button></div></td></tr></tbody></table></div>"
    res = res $ "<div class='gallery-code'>widgets::Kpi(id, label, value, note)\nwidgets::KpiGrid(items)\nwidgets::GpuMetricRow(name, usedMb, totalMb, percent, tempC)\nwidgets::GpuTable(rows)</div>"
    res = res $ "</div>"
    return (res)
}

func: ChartPanel() {
    body = ProChartDemo()
    body = body $ "<div class='ui-list'><div class='ui-list-row'><span>Revenue</span><span class='ui-muted'>+12.4%</span></div><div class='ui-list-row'><span>Latency</span><span class='ui-muted'>84 ms</span></div><div class='ui-list-row'><span>Errors</span><span class='ui-muted'>0.02%</span></div></div>"
    res = "<div class='ui-pro'><section class='ui-card'><div class='ui-card-head'><div class='ui-card-title'>Chart.js professional chart</div><div class='ui-card-sub'>Local library, responsive canvas, theme colors</div></div><div class='ui-card-body'>" $ body $ "<div class='gallery-note'>This uses the local Chart.js bundle from libwebui/vendor/chart.umd.min.js.</div></div></section></div>"
    return (res)
}

func: LayoutPanel() {
    res = "<div class='ui-pro gallery-stack'>"
    res = res $ "<div class='gallery-layout-demo'><div>Sidebar</div><div>Main stage</div><div>Resizable panel</div><div>Responsive panel</div></div>"
    res = res $ "<div class='gallery-masonry'>"
    res = res $ "<section class='ui-card'><div class='ui-card-head'><div class='ui-card-title'>DockPage</div><div class='ui-card-sub'>Application shell</div></div><div class='ui-card-body'><div class='gallery-note'>Header, sidebar, stage and footer.</div></div></section>"
    res = res $ "<section class='ui-card'><div class='ui-card-head'><div class='ui-card-title'>Dashboard</div><div class='ui-card-sub'>Overview + metric panels</div></div><div class='ui-card-body'><div class='gallery-note'>Responsive and data oriented.</div></div></section>"
    res = res $ "<section class='ui-card'><div class='ui-card-head'><div class='ui-card-title'>DesktopLayout</div><div class='ui-card-sub'>Manual panels</div></div><div class='ui-card-body'><div class='gallery-note'>Composable with Pro widgets.</div></div></section>"
    res = res $ "<section class='ui-card'><div class='ui-card-head'><div class='ui-card-title'>Model JSON</div><div class='ui-card-sub'>Classic tree API and JSON UI path</div></div><div class='ui-card-body'><div class='gallery-note'>Useful for LLM generated interfaces.</div></div></section>"
    res = res $ "</div>"
    res = res $ "<div class='gallery-code'>widgets::DockPage(title, sidebarHtml, mainHtml, footer, actionsHtml)\nwidgets::Dashboard()\nwidgets::DesktopLayout()\nlibwebui/model.to: App, Stack, Grid, Masonry, Card, Text, Button, Input, TextArea</div>"
    res = res $ "</div>"
    return (res)
}

func: NavigationPanel() {
    profile = "<div class='gallery-profile-wrap'><button type='button' class='gallery-profile-trigger' onclick='webuiProfile(this)'><span class='gallery-avatar'>S</span><span><div class='gallery-profile-name'>shadcn</div><div class='gallery-profile-mail'>m@example.com</div></span><span class='gallery-chev'></span></button><div class='gallery-profile-menu'><div class='gallery-profile-head'><span class='gallery-avatar'>S</span><span><div class='gallery-profile-name'>shadcn</div><div class='gallery-profile-mail'>m@example.com</div></span></div><div class='gallery-menu-section'><button type='button' class='gallery-menu-item' onclick=\"webuiEvent('upgrade')\"><span data-icon='sparkles'></span>Upgrade to Pro</button></div><div class='gallery-menu-section'><button type='button' class='gallery-menu-item' onclick=\"webuiEvent('account')\"><span data-icon='user'></span>Account</button><button type='button' class='gallery-menu-item' onclick=\"webuiEvent('billing')\"><span data-icon='credit'></span>Billing</button><button type='button' class='gallery-menu-item' onclick=\"webuiEvent('notifications')\"><span data-icon='bell'></span>Notifications</button></div><div class='gallery-menu-section'><button type='button' class='gallery-menu-item' onclick=\"webuiEvent('logout')\"><span data-icon='logOut'></span>Log out</button></div></div></div>"
    tree = "<div class='gallery-tree'><div class='gallery-tree-item open'><button type='button' class='gallery-tree-row' onclick='webuiTree(this)'><span class='gallery-disclosure'></span><span>app</span></button><div class='gallery-tree-kids'><div class='gallery-tree-item open'><button type='button' class='gallery-tree-row' onclick='webuiTree(this)'><span class='gallery-disclosure'></span><span>components</span></button><div class='gallery-tree-kids'><button type='button' class='gallery-tree-row' onclick=\"webuiEvent('tree_button')\">button.to</button><button type='button' class='gallery-tree-row' onclick=\"webuiEvent('tree_dropdown')\">dropdown.to</button><button type='button' class='gallery-tree-row' onclick=\"webuiEvent('tree_chart')\">chart.to</button></div></div><div class='gallery-tree-item'><button type='button' class='gallery-tree-row' onclick='webuiTree(this)'><span class='gallery-disclosure'></span><span>examples</span></button><div class='gallery-tree-kids'><button type='button' class='gallery-tree-row' onclick=\"webuiEvent('tree_gallery')\">gallery.to</button></div></div></div></div></div>"
    collapse = "<div id='gallery_collapse_one' class='gallery-collapse'><button type='button' class='gallery-collapse-head' onclick=\"webuiCollapse('gallery_collapse_one')\"><span>Collapse panel</span><span class='gallery-chev'></span></button><div class='gallery-collapse-body'>Hidden content can contain forms, tables, charts or generated JSON UI fragments.</div></div>"
    accordion = "<div class='gallery-accordion'><div class='gallery-acc-item open'><button type='button' class='gallery-acc-head' onclick='webuiAccordion(this)'><span>Is it accessible?</span><span class='gallery-chev'></span></button><div class='gallery-acc-body'>Keyboard/focus rules can be added in the shared widget layer after the visual API is stable.</div></div><div class='gallery-acc-item'><button type='button' class='gallery-acc-head' onclick='webuiAccordion(this)'><span>Can it be themed?</span><span class='gallery-chev'></span></button><div class='gallery-acc-body'>Yes. It only uses libwebui theme variables.</div></div><div class='gallery-acc-item'><button type='button' class='gallery-acc-head' onclick='webuiAccordion(this)'><span>Can it send events?</span><span class='gallery-chev'></span></button><div class='gallery-acc-body'>Every clickable row calls galleryLog, which also dispatches a Toba bridge event.</div></div></div>"
    res = "<div class='ui-pro'><div class='gallery-nav-grid'><section class='ui-card'><div class='ui-card-head'><div class='ui-card-title'>Profile dropdown</div><div class='ui-card-sub'>shadcn-like account menu</div></div><div class='ui-card-body'>" $ profile $ "</div></section><section class='ui-card'><div class='ui-card-head'><div class='ui-card-title'>Treeview</div><div class='ui-card-sub'>Expandable hierarchy</div></div><div class='ui-card-body'>" $ tree $ "</div></section><section class='ui-card'><div class='ui-card-head'><div class='ui-card-title'>Collapse</div><div class='ui-card-sub'>Single expandable panel</div></div><div class='ui-card-body'>" $ collapse $ "</div></section><section class='ui-card'><div class='ui-card-head'><div class='ui-card-title'>Accordion</div><div class='ui-card-sub'>One section open at a time</div></div><div class='ui-card-body'>" $ accordion $ "</div></section></div></div>"
    return (res)
}

func: ChatPanel() {
    res = "<section class='lw-chat gallery-chat-mini'>"
    res = res $ "<div class='lw-chat-head'><strong>Chat widget</strong><span class='tm-value'>demo</span></div>"
    res = res $ "<div id='gallery_chat_messages' class='lw-chat-messages'>"
    res = res $ widgets::ChatMessage("system", "System message")
    res = res $ widgets::ChatMessage("assistant", "Assistant bubble")
    res = res $ widgets::ChatMessage("user", "User bubble")
    res = res $ "</div>"
    res = res $ widgets::ChatComposer("gallery_prompt", "Send", "webuiChatSend()")
    res = res $ "</section>"
    return (res)
}

func: ClassicPanel() {
    res = "<div class='gallery-basic'>"
    res = res $ "<div class='tb-toolbar'><button id='classic_run' class='tb-button' onclick=\"webuiEvent('classic_run')\">Run</button><button id='classic_cancel' class='tb-button secondary' onclick=\"webuiEvent('classic_cancel')\">Cancel</button></div>"
    res = res $ "<div class='tb-row'><label for='classic_name'>Name</label><input id='classic_name' class='tb-input' value='Classic widget' onchange=\"webuiEvent('classic_name_changed')\"></div>"
    res = res $ "<div class='tb-row'><select id='classic_size' class='tb-input' onchange=\"webuiEvent('classic_size_changed')\"><option>Small</option><option>Medium</option><option>Large</option></select></div>"
    res = res $ "<textarea id='classic_notes' class='tb-area' onchange=\"webuiEvent('classic_notes_changed')\">Classic textarea</textarea>"
    res = res $ "<div id='classic_status' class='tb-status'>Classic desktopui visual style, wired to galleryLog for this standalone page.</div>"
    res = res $ "</div>"
    res = res $ "<div class='gallery-code'>desktopui::Button\n desktopui::SecondaryButton\n desktopui::Input\n desktopui::Select\n desktopui::TextArea\n desktopui::Status</div>"
    return (res)
}

func: BuildHtml(port) {
    layout = widgets::DesktopLayout()
    layout.SetTitle("Toba WebUI Component Gallery")
    layout.SetFooter("libwebui component gallery")
    layout.AddThemeSelector()
    layout.AddActionMenu()
    layout.AddKpiPanel("overview", "Overview", "catalog", "All component families", OverviewPanel())
    layout.AddHtmlPanel("inputs", "Inputs and actions", "events", "Pill fields, buttons and event log", InputsPanel())
    layout.AddHtmlPanel("data", "Data display", "tables", "KPI cards and tables", DataPanel())
    layout.AddHtmlPanel("chart", "Chart panel", "sample", "Visible professional chart", ChartPanel())
    layout.AddHtmlPanel("layout", "Layouts", "dock", "Dock, masonry and responsive placement", LayoutPanel())
    layout.AddHtmlPanel("navigation", "Navigation widgets", "tree", "Treeview, collapse, accordion, profile menu", NavigationPanel())
    layout.AddHtmlPanel("chat", "Chat", "composer", "Messages and composer", ChatPanel())
    layout.AddHtmlPanel("classic", "Classic desktopui", "simple", "Low-level widgets", ClassicPanel())
    modal = "<div id='gallery_modal' class='gallery-modal-backdrop' onclick='if(event.target==this)webuiModal(0)'><div class='gallery-modal'><div class='gallery-modal-head'><strong>Custom popup</strong><button type='button' class='ui-btn' onclick='webuiModal(0)'>Close</button></div><div class='gallery-modal-body'><div>This modal is rendered by libwebui styles and can contain any Toba-generated widget.</div><div class='lw-actions right'><button type='button' class='ui-btn' onclick=\"webuiEvent('popup_cancel')\">Cancel</button><button type='button' class='ui-btn primary' onclick=\"webuiEvent('popup_confirm')\"><span data-icon='save'></span>Confirm</button></div></div></div></div>"
    toast = "<div id='gallery_toast_root' class='gallery-toast-root'></div>"
    html = "<!doctype html><html><head><meta charset='utf-8'><title>Toba WebUI Components</title>" $ ProStyles() $ GalleryStyles() $ "</head><body data-theme='light_modern'>" $ layout.Render() $ modal $ toast $ GalleryScript() $ "</body></html>"
    html = desktopui::WithBridge(html, port)
    return (html)
}
