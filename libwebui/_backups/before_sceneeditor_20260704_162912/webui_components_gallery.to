        fxCards.AddCardFx(effects::ScrambleText("fx_scramble", "SCRAMBLE"), "lwfx-scramble", "Reveal type terminal (rejoue au changement d'onglet).", "lwfx-reveal")
        fxCards.AddCardFx("Spotlight", "lwfx-spotlight", "Halo lumineux qui suit la souris. Survole la carte.", "lwfx-spotlight lwfx-reveal")
        fxCards.AddCardFx("Animated border", "lwfx-border", "Bordure degradee en mouvement continu.", "lwfx-border lwfx-reveal")
