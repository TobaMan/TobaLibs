import : libjson / json

func: ChartValue(pointId) {
    v = pointId * 17
    loop {
        if (v <= 60) {
            break
        }
        v = v - 60
    }
    res = 25 + v
    return (res)
}

func: PushChartPoint(pointId) {
    value = ChartValue(pointId)
    secondary = value - 8
    if (secondary < 0) {
        secondary = 0
    }
    eventbus::ChartAddPoint("Toba " $ strnum(pointId), value, secondary)
    return (pointId + 1)
}

func: OnGalleryEvent(evt, chartPoint) {
    handled = 0
    if (evt.Is("callback_notify")) {
        eventbus::Notify("Toba callback", "Toba received " $ evt.Name() $ " from " $ evt.WidgetId())
        handled = 1
    }
    if (evt.Is("chart_add_point")) {
        chartPoint = PushChartPoint(chartPoint)
        handled = 1
    }
    if (evt.Is("chart_add_burst")) {
        i = for (0, 5, 1) {
            chartPoint = PushChartPoint(chartPoint)
        }
        handled = 1
    }
    if (evt.Is("chart_reset")) {
        eventbus::ChartReset()
        chartPoint = 1
        handled = 1
    }
    return (chartPoint)
}

// Controles GridCraft construits avec de VRAIS widgets libwebui : Toolbar
// (boutons -> events gc_*) + Fields.SliderUnit (sliders themes). startEvent =
// 'gc_start_radiance' ou 'gc_start_rtx'. Aucun HTML brut.
func: GcControls(startEvent, suffix) {
    bar = webui::Toolbar()
    bar.Button("gc_start_" $ suffix, "Demarrer", "play", startEvent, "primary")
    bar.Button("gc_stop_" $ suffix, "Arreter", "square", "gc_stop", " ")
    bar.Button("gc_refresh_" $ suffix, "Rafraichir", "refresh", "gc_refresh", " ")
    bar.Close()

    // SliderPillHtml directement (pas via Fields qui empile) -> rangee flex.
    sliders = webui::SliderPillHtml("gc_q_" $ suffix, "Qualite", 0.6, 0.25, 1, 0.05, "gcSetScale", "gc_qv_" $ suffix)
    sliders = sliders $ webui::SliderPillHtml("gc_o_" $ suffix, "Opacite", 0.75, 0.1, 1, 0.05, "gcSetOpacity", "gc_ov_" $ suffix)
    sliders = sliders $ webui::SliderPillHtml("gc_i_" $ suffix, "Intensite", 0.6, 0.1, 1, 0.05, "gcSetMaxAlpha", "gc_iv_" $ suffix)
    sliders = sliders $ webui::SliderPillHtml("gc_f_" $ suffix, "Finesse", 2, 1, 4, 1, "gcSetLineStep", "gc_fv_" $ suffix)

    // Rangee compacte de pills (flex, retour a la ligne si besoin).
    return (bar.html $ "<div class='gallery-row' style='flex-wrap:wrap;gap:8px;margin-top:10px'>" $ sliders $ "</div>")
}

