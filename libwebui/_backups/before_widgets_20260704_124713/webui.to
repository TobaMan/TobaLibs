obj:TableDemo() {
    self.html = "<div class='gallery-table-demo'>"
    self.closed = 0

    func:AddTop(self, tabs, dropdown) {
        self.html = self.html $ "<div class='gallery-table-top'>" $ tabs.html $ "<div class='gallery-row'>" $ dropdown.html $ "<button type='button' class='ui-btn primary' onclick=\"webuiToast('Table','Add Section event sent to Toba')\"><span data-icon='plus'></span>Add Section</button></div></div>"
        return (self)
    }

    func:AddTable(self, table) {
        self.html = self.html $ table.html
        return (self)
    }

    func:AddPagination(self) {
        rows = "<div class='tm-dropdown'><button type='button' class='ui-btn' onclick='tmDrop(this)'>10</button><div class='ui-dropdown-menu tm-drop-menu'><button type='button' class='ui-option active' onclick=\"webuiEvent('page_10')\">10</button><button type='button' class='ui-option' onclick=\"webuiEvent('page_25')\">25</button><button type='button' class='ui-option' onclick=\"webuiEvent('page_50')\">50</button></div></div>"
        first = "<button type='button' class='ui-btn ui-icon-btn' title='First page' onclick=\"webuiEvent('page_first')\"><span data-icon='chevronsLeft'></span></button>"
        prev = "<button type='button' class='ui-btn ui-icon-btn' title='Previous page' onclick=\"webuiEvent('page_prev')\"><span data-icon='chevronLeft'></span></button>"
        next = "<button type='button' class='ui-btn ui-icon-btn' title='Next page' onclick=\"webuiEvent('page_next')\"><span data-icon='chevronRight'></span></button>"
        last = "<button type='button' class='ui-btn ui-icon-btn' title='Last page' onclick=\"webuiEvent('page_last')\"><span data-icon='chevronsRight'></span></button>"
        self.html = self.html $ "<div class='gallery-pagination'><span id='gallery_table_selected'>0 of 68 row(s) selected.</span><div class='gallery-pager'><span>Rows per page</span>" $ rows $ "<strong>Page 1 of 7</strong>" $ first $ prev $ next $ last $ "</div></div>"
        return (self)
    }

    func:Close(self) {
        if (self.closed == 0) {
            self.html = self.html $ "</div>"
            self.closed = 1
        }
        return (self)
    }
}

