obj:Navigation() {
    self.html = " "

    func:Build(self) {
        profile = "<div class='gallery-profile-wrap'><button type='button' class='gallery-profile-trigger' onclick='webuiProfile(this)'><span class='gallery-avatar'>S</span><span><div class='gallery-profile-name'>shadcn</div><div class='gallery-profile-mail'>m@example.com</div></span><span class='gallery-chev'></span></button><div class='gallery-profile-menu'><div class='gallery-profile-head'><span class='gallery-avatar'>S</span><span><div class='gallery-profile-name'>shadcn</div><div class='gallery-profile-mail'>m@example.com</div></span></div><div class='gallery-menu-section'><button type='button' class='gallery-menu-item' onclick=\"webuiEvent('upgrade')\"><span data-icon='sparkles'></span>Upgrade to Pro</button></div><div class='gallery-menu-section'><button type='button' class='gallery-menu-item' onclick=\"webuiEvent('account')\"><span data-icon='user'></span>Account</button><button type='button' class='gallery-menu-item' onclick=\"webuiEvent('billing')\"><span data-icon='credit'></span>Billing</button><button type='button' class='gallery-menu-item' onclick=\"webuiEvent('notifications')\"><span data-icon='bell'></span>Notifications</button></div><div class='gallery-menu-section'><button type='button' class='gallery-menu-item' onclick=\"webuiEvent('logout')\"><span data-icon='logOut'></span>Log out</button></div></div></div>"
        tree = "<div class='gallery-tree'><div class='gallery-tree-item open'><button type='button' class='gallery-tree-row' onclick='webuiTree(this)'><span class='gallery-disclosure'></span><span>app</span></button><div class='gallery-tree-kids'><div class='gallery-tree-item open'><button type='button' class='gallery-tree-row' onclick='webuiTree(this)'><span class='gallery-disclosure'></span><span>components</span></button><div class='gallery-tree-kids'><button type='button' class='gallery-tree-row' onclick=\"webuiEvent('tree_button')\">button.to</button><button type='button' class='gallery-tree-row' onclick=\"webuiEvent('tree_dropdown')\">dropdown.to</button><button type='button' class='gallery-tree-row' onclick=\"webuiEvent('tree_table')\">table.to</button><button type='button' class='gallery-tree-row' onclick=\"webuiEvent('tree_chart')\">chart.to</button></div></div><div class='gallery-tree-item open'><button type='button' class='gallery-tree-row' onclick='webuiTree(this)'><span class='gallery-disclosure'></span><span>layouts</span></button><div class='gallery-tree-kids'><button type='button' class='gallery-tree-row' onclick=\"webuiEvent('tree_dock')\">dock.to</button><button type='button' class='gallery-tree-row' onclick=\"webuiEvent('tree_grid')\">grid.to</button></div></div><div class='gallery-tree-item'><button type='button' class='gallery-tree-row' onclick='webuiTree(this)'><span class='gallery-disclosure'></span><span>examples</span></button><div class='gallery-tree-kids'><button type='button' class='gallery-tree-row' onclick=\"webuiEvent('tree_gallery')\">webui_components_gallery.to</button></div></div></div></div></div>"
        collapse = "<div id='gallery_collapse_one' class='gallery-collapse'><button type='button' class='gallery-collapse-head' onclick=\"webuiCollapse('gallery_collapse_one')\"><span>Can I nest widgets?</span><span class='gallery-chev'></span></button><div class='gallery-collapse-body'>Yes: any widget exposing html can be added into a Panel or another container with Add(widget).</div></div><div id='gallery_collapse_two' class='gallery-collapse'><button type='button' class='gallery-collapse-head' onclick=\"webuiCollapse('gallery_collapse_two')\"><span>Are events sent to Toba?</span><span class='gallery-chev'></span></button><div class='gallery-collapse-body'>Yes: webuiEvent dispatches toba:event, then WithBridge sends JSON events to Toba BridgePoll.</div></div>"
        accordion = "<div class='gallery-accordion'><div class='gallery-acc-item open'><button type='button' class='gallery-acc-head' onclick='webuiAccordion(this)'><span>Is it accessible?</span><span class='gallery-chev'></span></button><div class='gallery-acc-body'>Keyboard and focus rules can be added in the shared widget layer.</div></div><div class='gallery-acc-item'><button type='button' class='gallery-acc-head' onclick='webuiAccordion(this)'><span>Can it be themed?</span><span class='gallery-chev'></span></button><div class='gallery-acc-body'>Yes. It uses libwebui theme variables.</div></div><div class='gallery-acc-item'><button type='button' class='gallery-acc-head' onclick='webuiAccordion(this)'><span>Can it send events?</span><span class='gallery-chev'></span></button><div class='gallery-acc-body'>Every clickable row calls webuiEvent and dispatches a Toba bridge event.</div></div><div class='gallery-acc-item'><button type='button' class='gallery-acc-head' onclick='webuiAccordion(this)'><span>Can panels contain tables?</span><span class='gallery-chev'></span></button><div class='gallery-acc-body'>Yes. Containers add child widgets through Add(widget); special table cells will get slot APIs next.</div></div></div>"
        self.html = "<div class='gallery-nav-grid'><section class='ui-card'><div class='ui-card-head'><div class='ui-card-title'>Profile dropdown</div><div class='ui-card-sub'>shadcn-like account menu</div></div><div class='ui-card-body'>" $ profile $ "</div></section><section class='ui-card'><div class='ui-card-head'><div class='ui-card-title'>Treeview</div><div class='ui-card-sub'>Expandable hierarchy</div></div><div class='ui-card-body'>" $ tree $ "</div></section><section class='ui-card'><div class='ui-card-head'><div class='ui-card-title'>Collapse</div><div class='ui-card-sub'>Single expandable panel</div></div><div class='ui-card-body'>" $ collapse $ "</div></section><section class='ui-card'><div class='ui-card-head'><div class='ui-card-title'>Accordion</div><div class='ui-card-sub'>One section open at a time</div></div><div class='ui-card-body'>" $ accordion $ "</div></section></div>"
        return (self)
    }
}

obj:Chat() {
    self.html = " "
    self.id = "chat"
    self.title = "Chat"
    self.status = "Ready"
    self.sendEvent = "send_message"

    func:Build(self) {
        self.html = "<section class='lw-chat gallery-chat-mini'><div class='lw-chat-head'><strong>Chat widget</strong><span class='tm-value'>demo</span></div><div id='gallery_chat_messages' class='lw-chat-messages'>" $ widgets::ChatMessage("system", "System message") $ widgets::ChatMessage("assistant", "Assistant bubble") $ widgets::ChatMessage("user", "User bubble") $ "</div>" $ widgets::ChatComposer("gallery_prompt", "Send", "webuiChatSend()") $ "</section>"
        return (self)
    }

    // Chat reel pilote par le bridge. id = prefixe des elements.
    // sendEvent = nom d'event Toba emis a l'envoi (le prompt est pousse en args).
    // Le backend repond via BridgeExecute("uiAssistant"/"uiSystem"/...).
    func:Setup(self, id, title, sendEvent) {
        self.id = id
        self.title = title
        self.sendEvent = sendEvent
        msgId = id $ "_messages"
        inputId = id $ "_input"
        statusId = id $ "_status"

        head = "<div class='lw-chat-head'><strong>" $ desktopui::EscapeHtml(title) $ "</strong><span id='" $ statusId $ "' class='llm-badge'>" $ desktopui::EscapeHtml(self.status) $ "</span></div>"
        msgs = "<div id='" $ msgId $ "' class='lw-chat-messages'></div>"
        composer = widgets::ChatComposer(inputId, "Send", "webuiChatSend('" $ id $ "','" $ sendEvent $ "')")

        script = "<script>"
        script = script $ "window.webuiChatAppend=window.webuiChatAppend||function(boxId,role,text){var b=document.getElementById(boxId);if(!b)return;var d=document.createElement('div');d.className='lw-chat-msg '+role;d.textContent=text;b.appendChild(d);b.scrollTop=b.scrollHeight};"
        script = script $ "window.webuiChatSend=window.webuiChatSend||function(id,ev){var t=document.getElementById(id+'_input');if(!t)return;var v=(t.value||String()).trim();if(!v)return;webuiChatAppend(id+'_messages','user',v);t.value=String();if(window.webuiEvent)webuiEvent(ev,{id:id,value:v})};"
        script = script $ "window.webuiChatStatus=window.webuiChatStatus||function(id,text){var s=document.getElementById(id+'_status');if(s)s.textContent=text};"
        // hooks appeles par le backend via BridgeExecute (params = objet JSON)
        script = script $ "window.uiAssistant=window.uiAssistant||function(p){p=p||{};webuiChatAppend('" $ id $ "_messages','assistant',p.text||String())};"
        script = script $ "window.uiSystem=window.uiSystem||function(p){p=p||{};webuiChatAppend('" $ id $ "_messages','system',p.text||String())};"
        script = script $ "window.uiStatus=window.uiStatus||function(p){p=p||{};webuiChatStatus('" $ id $ "',p.text||String())};"
        script = script $ "window.uiReady=window.uiReady||function(p){p=p||{};webuiChatStatus('" $ id $ "',p.text||'Ready')};"
        script = script $ "window.uiLoading=window.uiLoading||function(p){p=p||{};webuiChatStatus('" $ id $ "',p.text||'Loading...')};"
        script = script $ "window.uiStopped=window.uiStopped||function(p){p=p||{};webuiChatStatus('" $ id $ "',p.text||'Stopped')};"
        script = script $ "</script>"

        self.html = "<section class='lw-chat lw-dock-panel' id='" $ id $ "_panel'>" $ head $ msgs $ composer $ "</section>" $ script
        return (self)
    }

    func:SetStatus(self, status) {
        self.status = status
        return (self)
    }
}

