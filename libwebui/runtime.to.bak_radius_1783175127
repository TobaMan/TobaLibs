text-1);padding:0 10px;font-size:12px;outline:none}.ui-label{font-size:11px;font-weight:600;color:var(--text-2);margin-bottom:6px}.ui-field{display:flex;flex-direction:column}.ui-dropdown{position:relative;min-width:176px;width:100%;max-width:100%}.webui-dropdown{width:100%;flex:1 1 220px}.gallery-row>.ui-dropdown,.gallery-table-top .ui-dropdown{width:auto}.gallery-row>.webui-dropdown{width:100%;flex:1 1 220px}.gallery-table-top .webui-dropdown,.gallery-pager .webui-dropdown{width:auto;flex:0 0 auto}.ui-dropdown>.ui-btn{width:100%;justify-content:space-between;border:1px solid var(--border);border-radius:999px;background:var(--bg-card)}.ui-dropdown-menu{position:absolute;z-index:80;right:0;top:calc(100% + 6px);display:none;min-width:100%;width:max-content;padding:4px;border:1px solid var(--border);border-radius:var(--lw-radius);background:var(--bg-card);box-shadow:0 18px 50px rgba(0,0,0,.28)}.ui-dropdown.open .ui-dropdown-menu{display:block}.ui-option{width:100%;height:30px;border:0;border-radius:var(--lw-radius);background:transparent;color:var(--text-1);display:flex;align-items:center;gap:8px;padding:0 8px;font-size:12px;text-align:left;cursor:pointer}.ui-option:hover,.ui-option.active{background:var(--bg-hover)}.ui-stat{display:flex;flex-direction:column;gap:6px;padding:14px;border:1px solid var(--border);border-radius:var(--lw-radius);background:var(--bg-card)}.ui-stat-label{font-size:11px;color:var(--text-2);font-weight:600}.ui-stat-value{font-size:22px;font-weight:700;letter-spacing:-.02em;color:var(--text-1)}.ui-stat-note{font-size:11.5px;color:var(--text-2)}.ui-list{border:1px solid var(--border);border-radius:var(--lw-radius);overflow:hidden}.ui-list-row{height:38px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 12px;border-bottom:1px solid var(--border);font-size:12px}.ui-list-row:last-child{border-bottom:0}.ui-muted{color:var(--text-2)}.ui-markdown{border:1px solid var(--border);border-radius:var(--lw-radius);background:v