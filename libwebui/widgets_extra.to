obj:ImageGallery() {
    self.html = " "
    self.id = "image_gallery"
    self.title = "Image gallery"
    self.note = "Selection de vignettes"
    self.eventName = "image_gallery_select"
    self.images = " "
    self.firstSrc = " "
    self.firstAlt = "Image"
    self.firstCaption = " "
    self.count = 0
    self.columns = 2
    self.disabled = 0

    func:Setup(self, id, title, note, eventName) {
        self.id = id
        self.title = title
        self.note = note
        self.eventName = eventName
        return (self)
    }

    func:SetColumns(self, columns) {
        self.columns = columns
        return (self)
    }

    func:AddImage(self, source, caption, alt) {
        srcRaw = image_view::ImageSourceUrl(source)
        src = desktopui::EscapeHtml(srcRaw)
        cap = desktopui::EscapeHtml(caption)
        safeAlt = desktopui::EscapeHtml(alt)
        cls = "lw-gallery-thumb"
        if (self.count == 0) {
            cls = "lw-gallery-thumb active"
            self.firstSrc = srcRaw
            self.firstAlt = alt
            self.firstCaption = caption
        }
        self.images = self.images $ "<button type='button' class='" $ cls $ "' data-src='" $ src $ "' data-caption='" $ cap $ "' data-alt='" $ safeAlt $ "' onclick=\"lwGalleryPick('" $ desktopui::EscapeJs(self.id) $ "',this)\"><img src='" $ src $ "' alt='" $ safeAlt $ "' loading='lazy'><span>" $ cap $ "</span></button>"
        self.count = self.count + 1
        return (self)
    }

    func:SetDisabled(self, disabled) {
        self.disabled = disabled
        return (self)
    }

    func:Close(self) {
        hero = "<div class='lw-image-empty'>Ajoute des images avec AddImage(...).</div>"
        if (self.count > 0) {
            hero = "<img src='" $ desktopui::EscapeHtml(self.firstSrc) $ "' alt='" $ desktopui::EscapeHtml(self.firstAlt) $ "' loading='lazy' onclick=\"webuiEvent('image_gallery_open',{id:'" $ desktopui::EscapeJs(self.id) $ "',value:this.src})\">"
        }
        self.html = widget_core::Styles() $ image_view::ImageStyles() $ image_gallery::ImageGalleryScript()
        self.html = self.html $ "<section id='" $ desktopui::EscapeHtml(self.id) $ "' class='ui-card lw-gallery-card' data-event='" $ desktopui::EscapeHtml(self.eventName) $ "'><div class='ui-card-head'><div class='ui-card-title'>" $ desktopui::EscapeHtml(self.title) $ "</div><div class='ui-card-sub'>" $ desktopui::EscapeHtml(self.note) $ "</div></div><div class='ui-card-body'><div class='lw-gallery-layout'><div><div class='lw-image-frame lw-gallery-main'>" $ hero $ "</div><div class='lw-image-caption'><span class='lw-gallery-current'>" $ desktopui::EscapeHtml(self.firstCaption) $ "</span><span class='lw-image-source'>" $ strnum(self.count) $ " images</span></div></div><div class='lw-gallery-thumbs' style='--lw-cols:" $ strnum(self.columns) $ "'>" $ self.images $ "</div></div></div></section>"
        if (self.disabled == 1) {
            self.html = widget_core::DisableHtml(self.html)
        }
        return (self)
    }
}

obj:Carousel() {
    self.html = " "
    self.id = "carousel"
    self.title = "Carousel"
    self.note = "Slides image"
    self.eventName = "carousel_change"
    self.slides = " "
    self.dots = " "
    self.count = 0
    self.autoplayMs = 0
    self.disabled = 0

    func:Setup(self, id, title, note, eventName) {
        self.id = id
        self.title = title
        self.note = note
        self.eventName = eventName
        return (self)
    }

    func:SetAutoPlay(self, ms) {
        self.autoplayMs = ms
        return (self)
    }

    func:AddSlide(self, source, title, note) {
        src = desktopui::EscapeHtml(image_view::ImageSourceUrl(source))
        idx = self.count
        self.slides = self.slides $ "<div class='lw-carousel-slide'><img src='" $ src $ "' alt='" $ desktopui::EscapeHtml(title) $ "' loading='lazy'><div class='lw-carousel-caption'><span>" $ desktopui::EscapeHtml(title) $ "<small>" $ desktopui::EscapeHtml(note) $ "</small></span></div></div>"
        cls = "lw-carousel-dot"
        if (idx == 0) {
            cls = "lw-carousel-dot active"
        }
        self.dots = self.dots $ "<button type='button' class='" $ cls $ "' onclick=\"lwCarouselSet('" $ desktopui::EscapeJs(self.id) $ "'," $ strnum(idx) $ ")\"></button>"
        self.count = self.count + 1
        return (self)
    }

    func:SetDisabled(self, disabled) {
        self.disabled = disabled
        return (self)
    }

    func:Close(self) {
        content = self.slides
        if (self.count == 0) {
            content = "<div class='lw-carousel-slide'><div class='lw-image-empty'>Ajoute des slides avec AddSlide(...).</div></div>"
            self.count = 1
        }
        self.html = widget_core::Styles() $ image_view::ImageStyles() $ carousel::CarouselScript()
        self.html = self.html $ "<section class='ui-card lw-carousel-card'><div class='ui-card-head'><div class='ui-card-title'>" $ desktopui::EscapeHtml(self.title) $ "</div><div class='ui-card-sub'>" $ desktopui::EscapeHtml(self.note) $ "</div></div><div class='ui-card-body'><div id='" $ desktopui::EscapeHtml(self.id) $ "' class='lw-carousel' data-index='0' data-count='" $ strnum(self.count) $ "' data-event='" $ desktopui::EscapeHtml(self.eventName) $ "' data-autoplay='" $ strnum(self.autoplayMs) $ "'><div class='lw-carousel-track'>" $ content $ "</div><button type='button' class='lw-carousel-btn lw-carousel-prev' onclick=\"lwCarouselGo('" $ desktopui::EscapeJs(self.id) $ "',-1)\">&#8249;</button><button type='button' class='lw-carousel-btn lw-carousel-next' onclick=\"lwCarouselGo('" $ desktopui::EscapeJs(self.id) $ "',1)\">&#8250;</button><div class='lw-carousel-dots'>" $ self.dots $ "</div></div></div></section>"
        if (self.disabled == 1) {
            self.html = widget_core::DisableHtml(self.html)
        }
        return (self)
    }
}

