obj:RichTextEditor() {
    self.html = " "
    self.id = "rich_text_editor"
    self.title = "Rich Text Editor"
    self.value = "<p>Hello <strong>Toba</strong></p>"
    self.eventName = "rich_text_change"
    self.loaderUrl = " "
    self.readOnly = 0
    self.disabled = 0

    func:Setup(self, id, title, value, eventName) {
        self.id = id
        self.title = title
        self.value = value
        self.eventName = eventName
        return (self)
    }

    func:SetLoaderUrl(self, loaderUrl) {
        self.loaderUrl = loaderUrl
        return (self)
    }

    func:SetReadOnly(self, readOnly) {
        self.readOnly = readOnly
        return (self)
    }

    func:SetDisabled(self, disabled) {
        self.disabled = disabled
        return (self)
    }

    func:Close(self) {
        w = rich_text_editor::RichTextEditor()
        w.Setup(self.id, self.title, self.value, self.eventName)
        w.SetLoaderUrl(self.loaderUrl)
        w.SetReadOnly(self.readOnly)
        w.SetDisabled(self.disabled)
        w.Close()
        self.html = w.html
        return (self)
    }
}

obj:PopupWindow() {
    self.html = " "
    self.id = "popup_window"
    self.title = "Popup Window"
    self.subtitle = "Fenetre modale themable."
    self.body = "<p>Contenu libre genere par Toba.</p>"
    self.primaryText = "Valider"
    self.primaryEvent = "popup_confirm"
    self.secondaryText = "Annuler"
    self.secondaryEvent = "popup_cancel"
    self.disabled = 0

    func:Setup(self, id, title, subtitle, bodyHtml) {
        self.id = id
        self.title = title
        self.subtitle = subtitle
        self.body = bodyHtml
        return (self)
    }

    func:SetPrimary(self, text, eventName) {
        self.primaryText = text
        self.primaryEvent = eventName
        return (self)
    }

    func:SetSecondary(self, text, eventName) {
        self.secondaryText = text
        self.secondaryEvent = eventName
        return (self)
    }

    func:SetDisabled(self, disabled) {
        self.disabled = disabled
        return (self)
    }

    func:Close(self) {
        w = popup_window::PopupWindow()
        w.Setup(self.id, self.title, self.subtitle, self.body)
        w.SetPrimary(self.primaryText, self.primaryEvent)
        w.SetSecondary(self.secondaryText, self.secondaryEvent)
        w.SetDisabled(self.disabled)
        w.Close()
        self.html = w.html
        return (self)
    }
}
