// Toggle NU (sans carte) : le switch + texte On/Off inline. Meme evenement que
// Switch mais reutilisable dans une cellule, une barre d'outils, etc.
obj:Toggle() {
    self.html = " "
    self.id = "toggle"
    self.label = " "
    self.checked = 0
    self.eventName = "toggle_change"

    func:Setup(self, id, label, checked, eventName) {
        self.id = id
        self.label = label
        self.checked = checked
        self.eventName = eventName
        return (self)
    }

    func:Close(self) {
        self.html = widget_core::Styles() $ widget_core::Toggle(self.id, self.label, self.checked, self.eventName)
        return (self)
    }
}

