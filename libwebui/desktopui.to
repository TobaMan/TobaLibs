    res = res $ "window.addEventListener('beforeunload',function(ev){var b=window.tobaBridge;if(!b.closeGuard||b.closeApproved){b.closing=true;tobaBridgeSend({type:'event',name:'window_closing',widgetId:'window',args:['window','closing'],data:{id:'window',state:'closing',source:'native_close'},timestamp:Date.now()});return;}tobaBridgeSend({type:'event',name:'window_close_request',widgetId:'window',args:['window','request'],data:{id:'window',state:'request',source:'native_close'},timestamp:Date.now()});ev.preventDefault();ev.returnValue=b.closePrompt;return b.closePrompt;});"
    res = res $ "window.addEventListener('pagehide',function(){window.tobaBridge.closing=true;try{tobaBridgeSend({type:'event',name:'window_closed',widgetId:'window',args:['window','closed'],data:{id:'window',state:'closed'},timestamp:Date.now()})}catch(ex){}});"
    // Bordures de resize (WebView2 recouvre les bords -> le WM_NCHITTEST natif
    // ne se declenche pas). 8 zones invisibles au mousedown -> resize natif.
    res = res $ "window.webuiInitResizeBorders=function(){if(document.getElementById('lw_rz_wrap'))return;if(!window.nativeWindowAction)return;var css=document.createElement('style');css.textContent='.lw-rz{position:fixed;z-index:2147483000;background:transparent}.lw-rz-t{top:0;left:8px;right:8px;height:6px;cursor:ns-resize}.lw-rz-b{bottom:0;left:8px;right:8px;height:6px;cursor:ns-resize}.lw-rz-l{left:0;top:8px;bottom:8px;width:6px;cursor:ew-resize}.lw-rz-r{right:0;top:8px;bottom:8px;width:6px;cursor:ew-resize}.lw-rz-tl{top:0;left:0;width:10px;height:10px;cursor:nwse-resize}.lw-rz-tr{top:0;right:0;width:10px;height:10px;cursor:nesw-resize}.lw-rz-bl{bottom:0;left:0;width:10px;height:10px;cursor:nesw-resize}.lw-rz-br{bottom:0;right:0;width:10px;height:10px;cursor:nwse-resize}';document.head.appendChild(css);var wrap=document.createElement('div');wrap.id='lw_rz_wrap';var dirs=['t','b','l','r','tl','tr','bl','br'];dirs.forEach(function(d){var z=document.createElement('div');z.className='lw-rz lw-rz-'+d;z.addEventListener('mousedown',function(e){if(e.button!==0)return;e.preventDefault();nativeWindowAction('resize-'+d)});wrap.appendChild(z)});document.body.appendChild(wrap)};"
    res = res $ "if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',webuiInitResizeBorders)}else{webuiInitResizeBorders()}"
