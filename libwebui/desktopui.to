func: WindowBridgePath() {
    return ("C:/Toba/modules/libwebui/toba_window_bridge.dll")
}

func: WindowBridgeLib() {
    if (!isnum(WindowBridgeLibHandle)) {
        WindowBridgeLibHandle = dlopen(WindowBridgePath(), dlcdecl())
    }
    return (WindowBridgeLibHandle)
}

func: NativeWindowPlatform() {
    args = (cint(), (cvoid(), 0))
    res = dlcall(WindowBridgeLib(), "toba_window_platform", args)
    return (res)
}

func: NativeWindowFind(title) {
    ptr = ctoptr(cstring(), title)
    args = (culong(), (cpointer(), ptr))
    res = dlcall(WindowBridgeLib(), "toba_window_find", args)
    cfreeptr(ptr)
    return (res)
}

// Lance une commande totalement detachee (CreateProcess DETACHED_PROCESS, sans
// pipes stdout/stderr) et rend la main immediatement. A utiliser pour les
// process GUI persistants (webview_host) que runproc bloquerait.
func: RunDetached(cmd) {
    ptr = ctoptr(cstring(), cmd)
    args = (cint(), (cpointer(), ptr))
    res = dlcall(WindowBridgeLib(), "toba_run_detached", args)
    cfreeptr(ptr)
    return (res)
}

func: NativeWindowFrameless(title, enabled) {
    ptr = ctoptr(cstring(), title)
    args = (cint(), (cpointer(), ptr), (cint(), enabled))
    res = dlcall(WindowBridgeLib(), "toba_window_set_frameless", args)
    cfreeptr(ptr)
    return (res)
}

func: NativeWindowFramelessHandle(title, enabled) {
    ptr = ctoptr(cstring(), title)
    args = (culong(), (cpointer(), ptr), (cint(), enabled))
    res = dlcall(WindowBridgeLib(), "toba_window_apply_frameless", args)
    cfreeptr(ptr)
    return (res)
}

func: NativeWindowFramelessRetry(title, enabled, attempts, delayMs) {
    res = 0
    maxTry = attempts
    if (maxTry < 1) {
        maxTry = 1
    }
    delay = delayMs
    if (delay < 1) {
        delay = 100
    }
    i = for (0, maxTry, 1) {
        res = NativeWindowFrameless(title, enabled)
        if (res == 1) {
            break
        }
        sleep(delay * 0.001)
    }
    return (res)
}

func: NativeWindowFramelessHandleRetry(title, enabled, attempts, delayMs) {
    res = 0
    maxTry = attempts
    if (maxTry < 1) {
        maxTry = 1
    }
    delay = delayMs
    if (delay < 1) {
        delay = 100
    }
    i = for (0, maxTry, 1) {
        res = NativeWindowFramelessHandle(title, enabled)
        if (res != 0) {
            break
        }
        sleep(delay * 0.001)
    }
    return (res)
}

func: NativeWindowAction(title, action) {
    ptitle = ctoptr(cstring(), title)
    paction = ctoptr(cstring(), action)
    args = (cint(), (cpointer(), ptitle), (cpointer(), paction))
    res = dlcall(WindowBridgeLib(), "toba_window_action", args)
    cfreeptr(ptitle)
    cfreeptr(paction)
    return (res)
}

func: NativeWindowActionHandle(handle, action) {
    paction = ctoptr(cstring(), action)
    args = (cint(), (culong(), handle), (cpointer(), paction))
    res = dlcall(WindowBridgeLib(), "toba_window_action_handle", args)
    cfreeptr(paction)
    return (res)
}

func: NativeWindowLastHandle() {
    args = (culong(), (cvoid(), 0))
    res = dlcall(WindowBridgeLib(), "toba_window_last_handle", args)
    return (res)
}

func: NativeWindowLastActionResult() {
    args = (cint(), (cvoid(), 0))
    res = dlcall(WindowBridgeLib(), "toba_window_last_action_result", args)
    return (res)
}

func: NativeWindowActionCount() {
    args = (cint(), (cvoid(), 0))
    res = dlcall(WindowBridgeLib(), "toba_window_action_count", args)
    return (res)
}

func: RunJs(window, code) {
    res = NativeRun(window, code)
    return (res)
}

func: Wait() {
    NativeWait()
    return (1)
}

func: CloseAll() {
    NativeExit()
    return (1)
}

func: ArgText(evtObj, idx) {
    res = NativeGetStringAt(evtObj, idx)
    return (res)
}

func: ArgNumber(evtObj, idx) {
    res = NativeGetIntAt(evtObj, idx)
    return (res)
}

func: ReturnText(evtObj, text) {
    NativeReturnString(evtObj, text)
    return (1)
}

func: ReturnNumber(evtObj, value) {
    NativeReturnInt(evtObj, value)
    return (1)
}

func: JsSetText(id, text) {
    res = "tobaText('" $ EscapeJs(id) $ "','" $ EscapeJs(text) $ "');"
    return (res)
}

func: JsSetHtml(id, html) {
    res = "tobaHtml('" $ EscapeJs(id) $ "','" $ EscapeJs(html) $ "');"
    return (res)
}

func: JsSetValue(id, value) {
    res = "tobaValue('" $ EscapeJs(id) $ "','" $ EscapeJs(value) $ "');"
    return (res)
}

// ===================================================================
// WEBSOCKET EVENT BRIDGE
// ===================================================================

func: BridgeDllPath() {
    return ("C:/Toba/modules/libwebui/webui_bridge_shim_v2.dll")
}

func: BridgeLib() {
    if (!isnum(BridgeLibHandle)) {
        BridgeLibHandle = dlopen(BridgeDllPath(), dlcdecl())
    }
    return (BridgeLibHandle)
}

func: BridgeBuffer(sizeBytes) {
    res = ""
    if (sizeBytes > 0) {
        i = for (0, sizeBytes, 1) {
            res = res $ " "
        }
    }
    return (res)
}

func: BridgeStart(port) {
    args = (cint(), (cint(), port))
    res = dlcall(BridgeLib(), "webui_bridge_init", args)
    return (res)
}

func: BridgeStop() {
    args = (cvoid(), (cvoid(), 0))
    dlcall(BridgeLib(), "webui_bridge_shutdown", args)
    return (1)
}

func: BridgeIsConnected() {
    args = (cint(), (cvoid(), 0))
    res = dlcall(BridgeLib(), "webui_bridge_is_connected", args)
    return (res)
}

func: BridgeEventCount() {
    args = (cint(), (cvoid(), 0))
    res = dlcall(BridgeLib(), "webui_bridge_event_count", args)
    return (res)
}

func: BridgeClear() {
    args = (cvoid(), (cvoid(), 0))
    dlcall(BridgeLib(), "webui_bridge_clear", args)
    return (1)
}

func: BridgePoll(timeoutMs) {
    res = ""
    args = (cpointer(), (cint(), timeoutMs))
    ptr = dlcall(BridgeLib(), "webui_bridge_poll", args)
    if (ptr != 0) {
        res = cfromptr(ptr, cstring(), -1)
    }
    if (!isstr(res)) {
        res = ""
    }
    return (res)
}

func: BridgeExecute(action, paramsJson) {
    paction = ctoptr(cstring(), action)
    pparams = ctoptr(cstring(), paramsJson)
    args = (cint(), (cpointer(), paction), (cpointer(), pparams))
    res = dlcall(BridgeLib(), "webui_bridge_execute", args)
    cfreeptr(paction)
    cfreeptr(pparams)
    return (res)
}

func: BridgeLastError() {
    res = ""
    args = (cpointer(), (cvoid(), 0))
    ptr = dlcall(BridgeLib(), "webui_bridge_last_error", args)
    if (ptr != 0) {
        res = cfromptr(ptr, cstring(), -1)
    }
    if (!isstr(res)) {
        res = ""
    }
    return (res)
}

func: BridgeStartReliable(port, attempts) {
    selected = 0
    maxTry = attempts
    if (maxTry < 1) {
        maxTry = 1
    }
    i = for (0, maxTry, 1) {
        tryPort = port + i
        startRes = BridgeStart(tryPort)
        if (startRes == 0) {
            selected = tryPort
            break
        }
        BridgeStop()
        sleep(0.03)
    }
    return (selected)
}

func: BridgeScript(port) {
    p = strnum(port)
    res = "<script>"
    res = res $ "window.tobaBridge={ws:null,queue:[],sent:0,state:'starting',closing:false,closeGuard:true,closeApproved:false,closePrompt:'Quitter cette fenetre ?'};"
    res = res $ "function tobaBridgeStatus(value){window.tobaBridge.state=value;var el=document.getElementById('bridge_status');if(el){el.textContent='Bridge: '+value+' | sent: '+window.tobaBridge.sent;}}"
    res = res $ "function tobaBridgeSend(obj){var msg=JSON.stringify(obj);var b=window.tobaBridge;"
    res = res $ "if(b.ws&&b.ws.readyState===WebSocket.OPEN){b.ws.send(msg);b.sent++;tobaBridgeStatus('sent');}else{b.queue.push(msg);tobaBridgeStatus('queued');}}"
    res = res $ "function tobaBridgeConnect(){var b=window.tobaBridge;tobaBridgeStatus('connecting');try{b.ws=new WebSocket('ws://127.0.0.1:" $ p $ "');}catch(ex){tobaBridgeStatus('websocket exception: '+ex.message);return;}"
    res = res $ "b.ws.onopen=function(){tobaBridgeStatus('open');b.ws.send(JSON.stringify({type:'bridge_open',widgetId:'bridge',timestamp:Date.now()}));b.sent++;while(b.queue.length>0){b.ws.send(b.queue.shift());b.sent++;}tobaBridgeStatus('open');};"
    res = res $ "b.ws.onmessage=function(ev){try{var msg=JSON.parse(ev.data);var de=document.getElementById('tm_debug');if(de){de.textContent='bridge message: '+(msg.action||msg.type);}if(msg.type==='execute'){var fn=window[msg.action];if(typeof fn==='function'){fn(msg.params||{});}else{if(de){de.textContent='missing function: '+msg.action;}}}}catch(ex){var ee=document.getElementById('tm_debug');if(ee){ee.textContent='bridge JS error: '+ex.message;}console.log('Toba bridge message error',ex);}};"
    res = res $ "b.ws.onclose=function(){tobaBridgeStatus('closed');if(!window.tobaBridge.closing){setTimeout(tobaBridgeConnect,500);}};"
    res = res $ "b.ws.onerror=function(){tobaBridgeStatus('error');console.log('Toba bridge socket error');};}"
    res = res $ "window.addEventListener('toba:event',function(e){"
    res = res $ "var d=e.detail||{};var a=d.args||[];var data=d.data||{};var wid=d.widgetId||data.id||data.widgetId||(a.length>0?a[0]:'none');"
    res = res $ "tobaBridgeSend({type:'event',name:d.name,widgetId:wid,args:a,data:data,timestamp:Date.now()});"
    res = res $ "});"
    res = res $ "window.webuiSetCloseGuard=function(params){params=params||{};if(params.enabled!==undefined){window.tobaBridge.closeGuard=!!params.enabled}if(params.prompt!==undefined){window.tobaBridge.closePrompt=String(params.prompt)}};"
    res = res $ "window.webuiEnsureCloseModal=function(){var id='lw_close_confirm';var e=document.getElementById(id);if(e)return e;var css=document.createElement('style');css.setAttribute('data-libwebui-close','1');css.textContent='.lw-close-backdrop{display:none;position:fixed;inset:0;z-index:2000;align-items:center;justify-content:center;padding:24px;background:color-mix(in srgb,#020617 58%,transparent);backdrop-filter:blur(9px)}.lw-close-backdrop.open{display:flex}.lw-close-window{width:min(520px,calc(100vw - 32px));border:1px solid var(--border-glow,#c2d1e6);border-radius:calc(var(--lw-radius,8px) + 6px);background:linear-gradient(180deg,color-mix(in srgb,var(--bg-card,#fff) 98%,var(--bg-surface,#fff)),var(--bg-card,#fff));box-shadow:0 30px 90px rgba(0,0,0,.42);overflow:hidden;color:var(--text-1,#111)}.lw-close-head{padding:15px 16px 13px;border-bottom:1px solid var(--border,#d8e1ef);background:linear-gradient(90deg,var(--accent-glow,rgba(12,156,126,.16)),transparent 70%)}.lw-close-title{font-size:14px;font-weight:900}.lw-close-sub{font-size:12px;font-weight:600;color:var(--text-2,#4d617b);margin-top:4px}.lw-close-body{padding:16px;color:var(--text-2,#4d617b);font-size:12.5px;line-height:1.55}.lw-close-foot{display:flex;justify-content:flex-end;gap:8px;padding:12px 16px;border-top:1px solid var(--border,#d8e1ef);background:color-mix(in srgb,var(--bg-surface,#fff) 70%,var(--bg-card,#fff))}.lw-close-btn{height:32px;border:1px solid var(--border,#d8e1ef);border-radius:var(--lw-pill-radius,999px);background:var(--bg-card,#fff);color:var(--text-2,#4d617b);padding:0 12px;font-family:var(--sans,Segoe UI,Arial);font-size:12.5px;font-weight:850;cursor:pointer}.lw-close-btn:hover{border-color:var(--accent,#0c9c7e);background:var(--accent-glow,rgba(12,156,126,.16));color:var(--accent,#0c9c7e)}.lw-close-btn.primary{background:var(--accent,#0c9c7e);color:var(--bg-deep,#fff);border-color:var(--accent,#0c9c7e)}';document.head.appendChild(css);e=document.createElement('div');e.id=id;e.className='lw-close-backdrop';e.innerHTML='<div class=\"lw-close-window\" role=\"dialog\" aria-modal=\"true\"><div class=\"lw-close-head\"><div class=\"lw-close-title\">Quitter l application ?</div><div class=\"lw-close-sub\">Confirmation WebUI</div></div><div class=\"lw-close-body\">La fermeture est demandee. Tu peux annuler et revenir a l interface, ou confirmer pour fermer la fenetre.</div><div class=\"lw-close-foot\"><button type=\"button\" class=\"lw-close-btn\" onclick=\"webuiDenyClose()\">Annuler</button><button type=\"button\" class=\"lw-close-btn primary\" onclick=\"webuiAllowClose()\">Quitter</button></div></div>';document.body.appendChild(e);return e};"
    res = res $ "window.webuiRequestClose=function(params){params=params||{};var b=window.tobaBridge;if(b.closeGuard){var e=webuiEnsureCloseModal();e.classList.add('open');tobaBridgeSend({type:'event',name:'window_close_request',widgetId:'window',args:['window','request'],data:{id:'window',state:'request',source:params.source||'webui'},timestamp:Date.now()});return;}webuiAllowClose(params)};"
    res = res $ "window.webuiAllowClose=function(params){var e=document.getElementById('lw_close_confirm');if(e)e.classList.remove('open');window.tobaBridge.closeApproved=true;window.tobaBridge.closing=true;tobaBridgeSend({type:'event',name:'window_close_confirm',widgetId:'window',args:['window','confirm'],data:{id:'window',state:'confirm'},timestamp:Date.now()});if(window.nativeWindowAction){try{window.nativeWindowAction('close')}catch(ex){}}else{try{window.close()}catch(ex){}}};"
