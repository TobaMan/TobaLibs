/*
    libwebui - Web desktop UI helpers for Toba
    Usage : import : libwebui / desktopui
            html = desktopui::Page("App", desktopui::Button("run", "Run", "run_clicked"))

    This module builds self-contained WebUI pages and browser-side event widgets.
    Toba cannot expose a real C function pointer to a DLL, so WebUI DLL callbacks
    are not bound directly from this module. Use a native bridge or the older
    LibWeb device/callback runtime when Toba-side event dispatch is required.
*/

enum:global{
    NativeLibHandle
    WindowBridgeLibHandle
    BridgeLibHandle
}

NativeLibHandle = null()
WindowBridgeLibHandle = null()
BridgeLibHandle = null()

// ===================================================================
// TEXT ESCAPING
// ===================================================================

func: TextOrEmpty(value) {
    res = ""
    if (isstr(value)) {
        res = value
    }
    else {
        if (isnum(value)) {
            res = strnum(value)
        }
    }
    return (res)
}

func: EscapeHtml(value) {
    s = TextOrEmpty(value)
    res = ""
    if (size(s) > 0) {
        res = freplace(s, "&", "&amp;")
        res = freplace(res, "<", "&lt;")
        res = freplace(res, ">", "&gt;")
        res = freplace(res, "\"", "&quot;")
        res = freplace(res, "'", "&#39;")
    }
    return (res)
}

func: EscapeJs(value) {
    s = TextOrEmpty(value)
    res = ""
    if (size(s) > 0) {
        res = freplace(s, "\\", "\\\\")
        res = freplace(res, "'", "\\'")
        res = freplace(res, "\n", "\\n")
        res = freplace(res, "\r", "")
    }
    return (res)
}

// ===================================================================
// PAGE ASSETS
// ===================================================================

func: Styles() {
    res = "<style>"
    res = res $ ":root{color-scheme:light;--bg:#f6f7fb;--panel:#ffffff;--line:#d8dee9;--text:#172033;--muted:#667085;--primary:#2563eb;--primaryText:#ffffff;--lw-radius:8px;--lw-pill-radius:999px;--lw-gap:12px;}"
    res = res $ "*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Segoe UI,Arial,sans-serif;font-size:14px;}"
    res = res $ ".tb-app{min-height:100vh;display:grid;grid-template-columns:240px 1fr;grid-template-rows:auto 1fr auto;}"
    res = res $ ".tb-title{grid-column:1/3;padding:12px 18px;background:#111827;color:white;font-weight:650;letter-spacing:.2px;}"
    res = res $ ".tb-sidebar{padding:var(--lw-gap);border-right:1px solid var(--line);background:#eef2f7;}"
    res = res $ ".tb-content{padding:calc(var(--lw-gap) + 4px);overflow:auto;}"
    res = res $ ".tb-footer{grid-column:1/3;padding:8px 18px;border-top:1px solid var(--line);color:var(--muted);background:#fff;}"
    res = res $ ".tb-panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--lw-radius);padding:var(--lw-gap);margin-bottom:var(--lw-gap);}"
    res = res $ ".tb-toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:var(--lw-gap);}"
    res = res $ ".tb-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:8px 0;}"
    res = res $ ".tb-col{display:flex;flex-direction:column;gap:8px;min-width:180px;}"
    res = res $ ".tb-button{border:0;border-radius:var(--lw-pill-radius);background:var(--primary);color:var(--primaryText);padding:8px 12px;cursor:pointer;font-weight:600;}"
    res = res $ ".tb-button.secondary{background:#e5e7eb;color:#111827;}"
    res = res $ ".tb-input,.tb-area{border:1px solid var(--line);border-radius:var(--lw-radius);padding:8px;background:#fff;color:var(--text);}"
    res = res $ ".tb-area{min-height:96px;resize:vertical;width:100%;}"
    res = res $ ".tb-status{min-height:24px;color:var(--muted);padding:6px 0;}"
    res = res $ "@media(max-width:760px){.tb-app{grid-template-columns:1fr}.tb-title,.tb-footer{grid-column:1}.tb-sidebar{border-right:0;border-bottom:1px solid var(--line)}}"
    res = res $ "</style>"
    return (res)
}

func: Script() {
    res = "<script>"
    res = res $ "function tobaEvent(name){var args=Array.prototype.slice.call(arguments,1);"
    res = res $ "var detail={name:name,args:args};window.dispatchEvent(new CustomEvent('toba:event',{detail:detail}));"
    res = res $ "if(window.webui&&webui.call){try{var p=webui.call.apply(webui,[name].concat(args));if(p&&p.catch){p.catch(function(e){console.log('Toba callback unavailable',name,e);});}return p;}catch(e){console.log('Toba callback unavailable',name,e);}}"
    res = res $ "console.log('Toba event',name,args);return Promise.resolve(null);}"
    res = res $ "function tobaText(id,value){var el=document.getElementById(id);if(el){el.textContent=value;}}"
    res = res $ "function tobaHtml(id,value){var el=document.getElementById(id);if(el){el.innerHTML=value;}}"
    res = res $ "function tobaValue(id,value){var el=document.getElementById(id);if(el){el.value=value;}}"
    res = res $ "</script>"
    return (res)
}

// ===================================================================
// WIDGETS
// ===================================================================

func: Div(cls, content) {
    res = "<div class='" $ EscapeHtml(cls) $ "'>" $ content $ "</div>"
    return (res)
}

func: Panel(content) {
    res = Div("tb-panel", content)
    return (res)
}

func: Toolbar(content) {
    res = Div("tb-toolbar", content)
    return (res)
}

func: Row(content) {
    res = Div("tb-row", content)
    return (res)
}

func: Column(content) {
    res = Div("tb-col", content)
    return (res)
}

func: Label(id, text) {
    res = "<label for='" $ EscapeHtml(id) $ "'>" $ EscapeHtml(text) $ "</label>"
    return (res)
}

func: Text(id, text) {
    res = "<span id='" $ EscapeHtml(id) $ "'>" $ EscapeHtml(text) $ "</span>"
    return (res)
}

func: Status(id, text) {
    res = "<div id='" $ EscapeHtml(id) $ "' class='tb-status'>" $ EscapeHtml(text) $ "</div>"
    return (res)
}

func: Button(id, text, evtName) {
    res = "<button id='" $ EscapeHtml(id) $ "' class='tb-button' onclick=\"tobaEvent('" $ EscapeJs(evtName) $ "',this.id)\">" $ EscapeHtml(text) $ "</button>"
    return (res)
}

func: SecondaryButton(id, text, evtName) {
    res = "<button id='" $ EscapeHtml(id) $ "' class='tb-button secondary' onclick=\"tobaEvent('" $ EscapeJs(evtName) $ "',this.id)\">" $ EscapeHtml(text) $ "</button>"
    return (res)
}

func: Input(id, placeholder, value, evtName) {
    res = "<input id='" $ EscapeHtml(id) $ "' class='tb-input' value='" $ EscapeHtml(value) $ "' placeholder='" $ EscapeHtml(placeholder) $ "' onchange=\"tobaEvent('" $ EscapeJs(evtName) $ "',this.id,this.value)\">"
    return (res)
}

func: TextArea(id, placeholder, value, evtName) {
    res = "<textarea id='" $ EscapeHtml(id) $ "' class='tb-area' placeholder='" $ EscapeHtml(placeholder) $ "' onchange=\"tobaEvent('" $ EscapeJs(evtName) $ "',this.id,this.value)\">" $ EscapeHtml(value) $ "</textarea>"
    return (res)
}

func: Select(id, options, evtName) {
    items = ""
    i = for (0, size(options), 1) {
        opt = EscapeHtml(options[i])
        items = items $ "<option value='" $ opt $ "'>" $ opt $ "</option>"
    }
    res = "<select id='" $ EscapeHtml(id) $ "' class='tb-input' onchange=\"tobaEvent('" $ EscapeJs(evtName) $ "',this.id,this.value)\">" $ items $ "</select>"
    return (res)
}

func: Link(id, text, evtName) {
    res = "<a id='" $ EscapeHtml(id) $ "' href='#' onclick=\"tobaEvent('" $ EscapeJs(evtName) $ "',this.id);return false;\">" $ EscapeHtml(text) $ "</a>"
    return (res)
}

// ===================================================================
// PAGE AND DESKTOP SHELL
// ===================================================================

func: AppShell(title, sidebar, content, footer) {
    res = "<div class='tb-app'>"
    res = res $ "<header class='tb-title'>" $ EscapeHtml(title) $ "</header>"
    res = res $ "<aside class='tb-sidebar'>" $ sidebar $ "</aside>"
    res = res $ "<main class='tb-content'>" $ content $ "</main>"
    res = res $ "<footer class='tb-footer'>" $ footer $ "</footer>"
    res = res $ "</div>"
    return (res)
}

func: Page(title, body) {
    res = "<!DOCTYPE html><html><head><meta charset='utf-8'>"
    res = res $ "<meta name='viewport' content='width=device-width,initial-scale=1'>"
    res = res $ "<title>" $ EscapeHtml(title) $ "</title>"
    res = res $ Styles()
    res = res $ Script()
    res = res $ "</head><body>"
    res = res $ body
    res = res $ "</body></html>"
    return (res)
}

func: DesktopPage(title, sidebar, content, footer) {
    res = Page(title, AppShell(title, sidebar, content, footer))
    return (res)
}

// ===================================================================
// WEBUI WINDOW HELPERS
// ===================================================================

func: DllPath() {
    return ("C:/Users/damie/Desktop/Lib_Toba/webui-2.dll")
}

func: NativeLib() {
    if (!isnum(NativeLibHandle)) {
        NativeLibHandle = dlopen(DllPath(), dlcdecl())
    }
    return (NativeLibHandle)
}

func: NativeNewWindow() {
    args = (culong(), (cvoid(), 0))
    res = dlcall(NativeLib(), "webui_new_window", args)
    return (res)
}

func: NativeShow(window, html) {
    ptr = ctoptr(cstring(), html)
    args = (cuchar(), (culong(), window), (cpointer(), ptr))
    res = dlcall(NativeLib(), "webui_show", args)
    cfreeptr(ptr)
    return (res)
}

func: NativeShowBrowser(window, html, browser) {
    ptr = ctoptr(cstring(), html)
    args = (cuchar(), (culong(), window), (cpointer(), ptr), (culong(), browser))
    res = dlcall(NativeLib(), "webui_show_browser", args)
    cfreeptr(ptr)
    return (res)
}

func: NativeShowWebView(window, html) {
    ptr = ctoptr(cstring(), html)
    args = (cuchar(), (culong(), window), (cpointer(), ptr))
    res = dlcall(NativeLib(), "webui_show_wv", args)
    cfreeptr(ptr)
    return (res)
}

func: NativeSetSize(window, width, height) {
    args = (cvoid(), (culong(), window), (culong(), width), (culong(), height))
    dlcall(NativeLib(), "webui_set_size", args)
    return (window)
}

func: NativeSetPosition(window, x, y) {
    args = (cvoid(), (culong(), window), (culong(), x), (culong(), y))
    dlcall(NativeLib(), "webui_set_position", args)
    return (window)
}

func: NativeRun(window, code) {
    ptr = ctoptr(cstring(), code)
    args = (cuchar(), (culong(), window), (cpointer(), ptr))
    res = dlcall(NativeLib(), "webui_run", args)
    cfreeptr(ptr)
    return (res)
}

func: NativeWait() {
    args = (cvoid(), (cvoid(), 0))
    dlcall(NativeLib(), "webui_wait", args)
    return (1)
}

func: NativeExit() {
    args = (cvoid(), (cvoid(), 0))
    dlcall(NativeLib(), "webui_exit", args)
    return (1)
}

func: NativeGetStringAt(evtObj, idx) {
    args = (cpointer(), (cpointer(), evtObj), (culong(), idx))
    ptr = dlcall(NativeLib(), "webui_get_string_at", args)
    res = cfromptr(ptr, cstring(), -1)
    return (res)
}

func: NativeGetIntAt(evtObj, idx) {
    args = (clong(), (cpointer(), evtObj), (culong(), idx))
    res = dlcall(NativeLib(), "webui_get_int_at", args)
    return (res)
}

func: NativeReturnString(evtObj, text) {
    ptr = ctoptr(cstring(), text)
    args = (cvoid(), (cpointer(), evtObj), (cpointer(), ptr))
    dlcall(NativeLib(), "webui_return_string", args)
    cfreeptr(ptr)
    return (1)
}

func: NativeReturnInt(evtObj, value) {
    args = (cvoid(), (cpointer(), evtObj), (clong(), value))
    dlcall(NativeLib(), "webui_return_int", args)
    return (1)
}

func: CanBindCallbacks() {
    // Toba has FUNCTYPE values, but no C ABI function pointer for DLL callbacks.
    return (0)
}

func: Bind(window, evtName, callbackFunc) {
    // Kept as an explicit no-op guard to avoid pretending that ctoptr(...) can
    // create a DLL callback pointer from a Toba func.
    return (0)
}

func: Show(html) {
    window = NativeNewWindow()
    NativeShow(window, html)
    return (window)
}

func: ShowBrowser(html, browser) {
    window = NativeNewWindow()
    NativeShowBrowser(window, html, browser)
    return (window)
}

func: ShowWebView(html) {
    window = NativeNewWindow()
    NativeShowWebView(window, html)
    return (window)
}

func: SetWindow(window, width, height, x, y) {
    NativeSetSize(window, width, height)
    NativeSetPosition(window, x, y)
    return (window)
}

func: SetSizeOnly(window, width, height) {
    NativeSetSize(window, width, height)
    return (window)
}

