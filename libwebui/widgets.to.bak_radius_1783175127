obj:DataPanel() {
    self.id = "datapanel"
    self.tools = " "
    self.tree = " "
    self.columns = " "
    self.rows = " "
    self.search = "Search..."
    self.inTree = 0

    func:Setup(self, id) {
        self.id = id
        return (self)
    }

    func:AddToolButton(self, label, icon, onClickJs) {
        self.tools = self.tools $ "<button type='button' class='ui-btn' onclick=\"" $ onClickJs $ "\"><span data-icon='" $ desktopui::EscapeHtml(icon) $ "'></span>" $ desktopui::EscapeHtml(label) $ "</button>"
        return (self)
    }

    func:SetSearchBox(self, placeholder) {
        self.search = placeholder
        return (self)
    }

    func:TreeNode(self, label, badge, open) {
        cls = "lw-dp-group"
        if (open == 1) {
            cls = "lw-dp-group open"
        }
        self.tree = self.tree $ "<div class='" $ cls $ "'><button type='button' class='lw-dp-node' onclick='this.parentNode.classList.toggle(\"open\");webuiEvent(\"datapanel_tree_toggle\",{id:\"" $ desktopui::EscapeJs(label) $ "\",label:\"" $ desktopui::EscapeJs(label) $ "\"})'><span>" $ desktopui::EscapeHtml(label) $ "</span><span class='lw-dp-badge'>" $ desktopui::EscapeHtml(badge) $ "</span></button><div class='lw-dp-kids'>"
        self.inTree = 1
        return (self)
    }

    func:TreeLeaf(self, label, onClickJs) {
        self.tree = self.tree $ "<button type='button' class='lw-dp-leaf' onclick=\"" $ onClickJs $ ";webuiEvent('datapanel_tree_leaf',{id:'" $ desktopui::EscapeJs(label) $ "',label:'" $ desktopui::EscapeJs(label) $ "'})\">" $ desktopui::EscapeHtml(label) $ "</button>"
        return (self)
    }

    func:TreeEnd(self) {
        if (self.inTree == 1) {
            self.tree = self.tree $ "</div></div>"
            self.inTree = 0
        }
        return (self)
    }

    func:SetColumns(self, cols) {
        self.columns = "<th class='lw-dp-grip-head'></th>"
        i = for (0, size(cols), 1) {
            self.columns = self.columns $ "<th>" $ desktopui::EscapeHtml(cols[i]) $ "</th>"
        }
        self.columns = self.columns $ "<th></th>"
        return (self)
    }

    func:AddRow(self, cells, onClickJs) {
        rowId = desktopui::EscapeJs(cells[0])
        // Ligne draggable pour reordonner par drag'n'drop (poignee ::).
        self.rows = self.rows $ "<tr class='lw-dp-row' draggable='true' data-row-id='" $ desktopui::EscapeHtml(cells[0]) $ "'>"
        self.rows = self.rows $ "<td class='lw-dp-grip' title='Glisser pour reordonner'>::</td>"
        i = for (0, size(cells), 1) {
            self.rows = self.rows $ "<td>" $ desktopui::EscapeHtml(cells[i]) $ "</td>"
        }
        self.rows = self.rows $ "<td><div class='lw-cell-actions'><button type='button' class='ui-btn' onclick=\"" $ onClickJs $ ";webuiEvent('datapanel_row_action',{id:'" $ rowId $ "',value:'" $ rowId $ "'})\">Edit</button></div></td></tr>"
        return (self)
    }

    // Meme chose mais chaque cellule est du HTML de widget (NON echappe) : permet
    // d'imbriquer badges, boutons colores, sliders... dans les cellules. rowKey
    // sert d'identifiant (car cells[0] est du HTML). Pas de colonne d'action.
    func:AddRowHtml(self, rowKey, cells) {
        rid = desktopui::EscapeJs(rowKey)
        self.rows = self.rows $ "<tr class='lw-dp-row' draggable='true' data-row-id='" $ desktopui::EscapeHtml(rowKey) $ "'>"
        self.rows = self.rows $ "<td class='lw-dp-grip' title='Glisser pour reordonner'>::</td>"
        i = for (0, size(cells), 1) {
            self.rows = self.rows $ "<td>" $ cells[i] $ "</td>"
        }
        // cellule de fin (colonne action de SetColumns) pour garder l'alignement.
        self.rows = self.rows $ "<td></td></tr>"
        return (self)
    }

    func:Render(self) {
        if (self.inTree == 1) {
            self.TreeEnd()
        }
        return ("<div id='" $ desktopui::EscapeHtml(self.id) $ "' class='lw-datapanel'><div class='lw-dp-toolbar'><div class='lw-dp-tools'>" $ self.tools $ "</div><input class='lw-dp-search' placeholder='" $ desktopui::EscapeHtml(self.search) $ "' oninput=\"webuiEvent('datapanel_search',{id:'" $ desktopui::EscapeJs(self.id) $ "',value:this.value})\"></div><div class='lw-dp-body'><aside class='lw-dp-tree'>" $ self.tree $ "</aside><main class='lw-dp-table'><table><thead><tr>" $ self.columns $ "</tr></thead><tbody>" $ self.rows $ "</tbody></table></main></div></div>")
    }
}

