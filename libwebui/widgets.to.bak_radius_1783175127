obj:MetricsDashboard() {
    self.menu = " "
    self.panels = " "

    func:AddChart(self, chartId, title, value, detail) {
        cid = desktopui::EscapeHtml(chartId)
        ttl = desktopui::EscapeHtml(title)
        val = desktopui::EscapeHtml(value)
        det = desktopui::EscapeHtml(detail)
        self.menu = self.menu $ "<button id='menu_" $ cid $ "' class='tm-menu-item' onclick=\"tmShow('" $ cid $ "')\"><div class='tm-menu-title'><span>" $ ttl $ "</span><span id='" $ cid $ "_preview' class='tm-value'>" $ val $ "</span></div><div class='tm-menu-note'>" $ det $ "</div></button>"
        self.panels = self.panels $ "<section id='panel_" $ cid $ "' class='tm-panel'><div class='tm-title'><span>" $ ttl $ "</span><span id='" $ cid $ "_value' class='tm-value'>" $ val $ "</span></div><div class='tm-chart-box'><canvas id='" $ cid $ "_chart' class='tm-canvas'></canvas></div><div id='" $ cid $ "_detail' class='tm-note'>" $ det $ "</div></section>"
        return (self)
    }

    func:AddGpuTable(self, rows) {
        self.menu = self.menu $ "<button id='menu_gpu' class='tm-menu-item' onclick=\"tmShow('gpu')\"><div class='tm-menu-title'><span>GPU par carte</span><span id='gpu_preview' class='tm-value'>snapshot</span></div><div class='tm-menu-note'>Toutes les cartes graphiques</div></button>"
        table = "<div class='tm-table-wrap'><table class='tm-table'><thead><tr><th>GPU</th><th>VRAM</th><th>Total</th><th>%</th><th>Temp</th></tr></thead><tbody id='gpu_rows'>" $ rows $ "</tbody></table></div>"
        self.panels = self.panels $ "<section id='panel_gpu' class='tm-panel'><div class='tm-title'><span>GPU par carte</span><span id='gpu_value' class='tm-value'>snapshot</span></div>" $ table $ "<div id='gpu_detail' class='tm-note'>Snapshot loaded, connecting live metrics...</div></section>"
        return (self)
    }

    func:Render(self) {
        topbar = "<div class='tm-topbar'><strong>Dashboard</strong><div class='tm-actions pill-row'>" $ ThemeDropdown() $ "<span class='pill-sep'></span>" $ ActionDropdown() $ "</div></div>"
        html = ChartLibraryScript() $ Styles() $ DockScript() $ ActionScript()
        html = html $ "<div class='tm-shell lw-dock-shell'><aside class='tm-sidebar lw-dock-sidebar'><div class='lw-dock-grip'></div>" $ self.menu $ "<div id='gpu_dynamic_menu'></div></aside><main class='tm-main lw-dock-main'>" $ topbar $ "<div class='tm-stage'>" $ self.panels $ "<div id='gpu_dynamic_panels'></div></div></main></div>"
