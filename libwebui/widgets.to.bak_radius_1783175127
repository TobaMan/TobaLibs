func: GpuTable(rows) {
    html = "<div class='tm-table-wrap'><table class='tm-table'><thead><tr><th>GPU</th><th>VRAM</th><th>Total</th><th>%</th><th>Temp</th></tr></thead><tbody>" $ rows $ "</tbody></table></div>"
    return (html)
}

func: PillField(label, contentHtml) {
    html = "<div class='lw-pill-field'><span class='lw-pill-label'>" $ desktopui::EscapeHtml(label) $ "</span><span class='lw-pill-sep'></span>" $ contentHtml $ "</div>"
    return (html)
}

func: PillInput(inputId, label, value, onInputJs) {
    iid = desktopui::EscapeHtml(inputId)
    val = desktopui::EscapeHtml(value)
    js = desktopui::EscapeHtml(onInputJs)
    html = PillField(label, "<input id='" $ iid $ "' class='lw-pill-input' value='" $ val $ "' oninput='" $ js $ "'>")
    return (html)
}

func: PillSelect(selectId, label, optionsHtml, onChangeJs) {
    sid = desktopui::EscapeHtml(selectId)
    js = desktopui::EscapeHtml(onChangeJs)
    html = PillField(label, "<select id='" $ sid $ "' class='lw-pill-select' onchange='" $ js $ "'>" $ optionsHtml $ "</select>")
    return (html)
}

func: PillButton(buttonId, text, onClickJs, kind) {
    bid = desktopui::EscapeHtml(buttonId)
    txt = desktopui::EscapeHtml(text)
    js = desktopui::EscapeHtml(onClickJs)
    cls = "lw-pill-button " $ desktopui::EscapeHtml(kind)
    html = "<button id='" $ bid $ "' type='button' class='" $ cls $ "' onclick='" $ js $ "'>" $ txt $ "</button>"
    return (html)
}

func: PillButtonRow(contentHtml) {
    html = "<div class='lw-pill-buttons'>" $ contentHtml $ "</div>"
    return (html)
}

func: FilePicker(pickerId, label, value, accept, eventName) {
    pid = desktopui::EscapeHtml(pickerId)
    eid = desktopui::EscapeJs(pickerId)
    ev = desktopui::EscapeJs(eventName)
    val = desktopui::EscapeHtml(value)
    acc = desktopui::EscapeHtml(accept)
    content = "<span id='" $ pid $ "_value' class='lw-pill-input' title='" $ val $ "' data-accept='" $ acc $ "'>" $ val $ "</span>"
    content = content $ "<button id='" $ pid $ "_button' type='button' class='lw-pill-button primary' onclick=\"webuiEvent('" $ ev $ "',{id:'" $ eid $ "',value:document.getElementById('" $ eid $ "_value').textContent,accept:'" $ desktopui::EscapeJs(accept) $ "'})\">Choisir</button>"
    html = PillField(label, content)
    return (html)
}

func: ChatMessage(role, text) {
    html = "<div class='lw-chat-msg " $ desktopui::EscapeHtml(role) $ "'>" $ desktopui::EscapeHtml(text) $ "</div>"
    return (html)
}

func: ChatComposer(textareaId, buttonText, onClickJs) {
    tid = desktopui::EscapeHtml(textareaId)
    txt = desktopui::EscapeHtml(buttonText)
    js = desktopui::EscapeHtml(onClickJs)
    html = "<div class='lw-chat-composer'><div class='lw-chat-input-row'><textarea id='" $ tid $ "' class='lw-chat-input' placeholder='Message...'></textarea><button type='button' class='lw-chat-send' onclick='" $ js $ "'>" $ txt $ "</button></div></div>"
    return (html)
}

func: DockPage(title, sidebarHtml, mainHtml, footer, actionsHtml) {
    html = "<div class='tm-page lw-dock-page'>"
    html = html $ "<header class='tm-header'><div class='tm-brand'>" $ desktopui::EscapeHtml(title) $ "</div><div class='tm-actions pill-row'>" $ actionsHtml $ "</div></header>"
    html = html $ "<main class='tm-page-main'><div class='tm-shell lw-dock-shell'><aside class='tm-sidebar lw-dock-sidebar'><div class='lw-dock-grip' title='Resize / dock panel'></div>" $ sidebarHtml $ "</aside><section class='tm-main lw-dock-main'>" $ mainHtml $ "</section></div></main>"
    html = html $ "<footer class='tm-footer'>" $ desktopui::EscapeHtml(footer) $ "</footer></div>"
    return (html)
}

