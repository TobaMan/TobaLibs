        self.pills = self.pills $ "<button type='button' class='lw-cbpill' data-key='" $ desktopui::EscapeHtml(key) $ "' title='" $ desktopui::EscapeHtml(label) $ "' onclick=\"lwCbToggle('" $ desktopui::EscapeJs(self.id) $ "','" $ desktopui::EscapeJs(key) $ "')\"><span data-icon='" $ desktopui::EscapeHtml(icon) $ "'></span><span>" $ desktopui::EscapeHtml(label) $ "</span></button>"
