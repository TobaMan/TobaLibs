func: __module_ready() {
    return (1)
}

func: GpuMetricRow(gpuName, usedMb, totalMb, percent, tempC) {
    row = "<tr><td>" $ desktopui::EscapeHtml(gpuName) $ "</td>"
    row = row $ "<td>" $ strnum(usedMb) $ " MB</td>"
    row = row $ "<td>" $ strnum(totalMb) $ " MB</td>"
    row = row $ "<td>" $ strnum(percent) $ "%</td>"
    row = row $ "<td>" $ strnum(tempC) $ " C</td></tr>"
    return (row)
}

func: EmptyGpuMetricRow() {
    row = "<tr><td colspan='5'>No GPU data available</td></tr>"
    return (row)
}

func: Kpi(kpiId, label, value, note) {
    kid = desktopui::EscapeHtml(kpiId)
    html = "<div class='tm-kpi'>"
    html = html $ "<div class='tm-kpi-label'>" $ desktopui::EscapeHtml(label) $ "</div>"
    html = html $ "<div id='" $ kid $ "' class='tm-kpi-value'>" $ desktopui::EscapeHtml(value) $ "</div>"
    html = html $ "<div id='" $ kid $ "_note' class='tm-kpi-note'>" $ desktopui::EscapeHtml(note) $ "</div>"
    html = html $ "</div>"
    return (html)
}

func: KpiGrid(items) {
    html = "<div class='tm-kpi-grid'>" $ items $ "</div>"
    return (html)
}

func: ChartLibraryScript() {
    code = fsreadf("C:/Toba/modules/libwebui/vendor/chart.umd.min.js")
    html = " "
    if (isstr(code)) {
        if (size(code) > 1000) {
