func:ChatBarScript() {
    js = "<script>window.lwCbToggle=function(id,key){var root=document.getElementById(id);if(!root)return;var ps=root.querySelectorAll('.lw-cbpanel');var bs=root.querySelectorAll('.lw-cbpill');var opened=false;for(var i=0;i<ps.length;i++){var hit=ps[i].getAttribute('data-key')==key;var next=hit&&!ps[i].classList.contains('active');ps[i].classList.toggle('active',next);if(next)opened=true}for(var j=0;j<bs.length;j++){bs[j].classList.toggle('active',bs[j].getAttribute('data-key')==key&&opened)}root.classList.toggle('panel-open',opened);if(window.webuiEvent)webuiEvent(opened?'chatbar_panel_open':'chatbar_panel_close',{id:id,value:key,state:opened?'open':'closed'})};</script>"
    return (js)
}

